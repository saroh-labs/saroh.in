{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "NODE_ENV",
        "SKIP_ENV_VALIDATION",
        "DATABASE_URL",
        "RLS_ENFORCEMENT",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "API_URL",
        "ADMIN_ALLOWLIST",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "NGROK_URL",
        "REDIRECT_TO_CUSTOM_DOMAIN_IF_EXISTS",
        "NEXT_PUBLIC_ACCOUNTS_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_AUTH_APP_URL",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_APP_DOMAIN",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_VERCEL_URL"
    ],
    "globalPassThroughEnv": [
        "PORT",
        "APP_URL",
        "CORS_ORIGIN",
        "EMAIL_FROM",
        "SENDER_EMAIL_ID",
        "SMTP_HOST",
        "SMTP_HOSTNAME",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "USER_ACCOUNT",
        "USER_PASSWORD",
        "TEST_DATABASE_URL",
        "SPACES_ENDPOINT",
        "SPACES_REGION",
        "SPACES_KEY",
        "SPACES_SECRET",
        "SPACES_NAME",
        "SPACES_FOLDER",
        "SPACES_IMAGES_CDN_BASE_URL",
        "R2_ENDPOINT",
        "R2_BUCKET",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_PUBLIC_BASE_URL",
        "npm_package_version"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "db:migrate:deploy": {},
        "db:push": {},
        "db:seed": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "generate": {
            "dependsOn": ["^generate"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        }
    }
}
