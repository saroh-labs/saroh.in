{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "NODE_ENV",
        "SKIP_ENV_VALIDATION",
        "DATABASE_URL",
        // The database-target guard's escape hatch. Turbo passes NOTHING to a
        // task that is not declared here, so running db:seed through turbo
        // (which is how the seed gets its ^build) silently dropped this and the
        // guard refused the e2e database — correctly, since from its point of
        // view nobody had named it.
        "DATABASE_TARGET_CONFIRM",
        "RLS_ENFORCEMENT",
        "MODULE_ENFORCEMENT",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "API_URL",
        "ADMIN_ALLOWLIST",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "NGROK_URL",
        "REDIRECT_TO_CUSTOM_DOMAIN_IF_EXISTS",
        "NEXT_PUBLIC_ACCOUNTS_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_VERCEL_URL",
        // PostHog (DEC-125): the public project key, its host and the
        // workspace's session-replay switch are compiled into the browser
        // bundle, so a build with them differs from one without.
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_POSTHOG_REPLAY",
        "NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE",
        // saroh.in: shows Resources pages before their publish date on a
        // preview deployment; ignored on production (plan KTD-2). Hashed, not
        // passed through: a build without it pre-renders /help as a 404, and
        // a cache hit reused that build with the flag on.
        "RESOURCES_PREVIEW"
    ],
    "globalPassThroughEnv": [
        "PORT",
        // PostHog on the servers (DEC-125): the api's and the merchant
        // sites' own, read per request, never compiled into a browser bundle.
        "POSTHOG_KEY",
        "POSTHOG_HOST",
        "POSTHOG_ENVIRONMENT",
        // help.saroh.in: where its proxy sends people once Help moves to
        // saroh.in/help (17 Oct 2026). Read per request, never at build.
        "MARKETING_URL",
        "APP_URL",
        "ACCOUNTS_URL",
        "CORS_ORIGIN",
        "EMAIL_FROM",
        "SENDER_EMAIL_ID",
        "SMTP_HOST",
        "SMTP_HOSTNAME",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        // Where the admin console opens the pricing page and its preview.
        "MARKETING_SITE_URL",
        "USER_ACCOUNT",
        "USER_PASSWORD",
        "TEST_DATABASE_URL",
        "SPACES_ENDPOINT",
        "SPACES_REGION",
        "SPACES_KEY",
        "SPACES_SECRET",
        "SPACES_NAME",
        "SPACES_FOLDER",
        "SPACES_IMAGES_CDN_BASE_URL",
        "R2_ENDPOINT",
        "R2_BUCKET",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_PUBLIC_BASE_URL",
        // Signs saroh.app's calls to the api's site sign-in routes (ADR-011).
        "SITE_RELAY_SECRET",
        // saroh.in's pricing revalidation hook (plans catalogue U24, KTD-10).
        "PRICING_REVALIDATE_SECRET",
        // Set by Next itself while building; saroh.in's pricing read checks it.
        "NEXT_PHASE",
        "VERCEL_ENV",
        "AUTH_COOKIE_PREFIX",
        "DEV_ACCESS_KEY",
        "DEV_ACCESS_COOKIE_DOMAIN",
        "DEV_REDIRECT_ORIGIN",
        "DEV_REDIRECT_PATH",
        "VERCEL_GIT_COMMIT_REF",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        // saroh.in's launch switch (plan KTD-16): Pricing, its links and the
        // plan sections appear once it is "open"; read at build.
        "NEXT_PUBLIC_LAUNCH_MODE",
        // saroh.in: the build's page routes, written by its next.config.js
        // (routes.config.js), never set by hand.
        "SAROH_BUILT_ROUTES",
        // The customer account area's release switch, in the api and saroh.app
        // (round-2 A5): off until A6-A8 and A13 ship.
        "SITE_ACCOUNT_AREA",
        // saroh.app's template renders for the gallery's captures (industry
        // templates U14): off unless "on", never on a production deployment.
        "TEMPLATE_RENDERS",
        // Where e2e's template captures find those renders (U14).
        "TEMPLATE_RENDER_URL",
        // The api's fake site-code transport writes to os.tmpdir(), which the
        // e2e runner reads (`e2e/tests/site-codes.ts`). Strict env mode drops
        // TMPDIR, so on macOS the api fell back to /tmp while the runner read
        // /var/folders/…/T and never found a code.
        "TMPDIR",
        // Runs the site shop's e2e (G13) where the stack has the shop on.
        "E2E_SITE_SHOP",
        // Runs the own-domain hosting states' e2e (#861) where the stack's
        // api has a fake verifier and hosting provider: DOMAIN_HOSTING_FAKE,
        // the api's test-only switch for them (refused in production).
        "E2E_DOMAIN_HOSTING",
        "DOMAIN_HOSTING_FAKE",
        // Runs the workspace's paused-by-plan e2e (#800) against a business
        // the stack was prepared to have paused (its id).
        "E2E_PAUSED_ORG",
        // The merchant site in the paused state (#800), for its e2e.
        "E2E_PAUSED_SITE",
        // A page on that site with a Class packs or Plans block (#800).
        "E2E_PAUSED_PRICES_PATH",
        "npm_package_version"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            // What a build reads, so its hash is the app's build fingerprint:
            // tests, stories and docs change nothing that ships, so they
            // neither break the cache nor deploy an app (scripts/cf-plan.mjs).
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.{ts,tsx,js,mjs}",
                "!**/*.spec.{ts,tsx,js,mjs}",
                "!**/*.stories.{ts,tsx}",
                "!**/__tests__/**",
                "!**/*.md",
                "!**/vitest.config.*",
                "!**/jest.config.*"
            ],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "db:migrate:deploy": {},
        "db:push": {},
        // Seeding validates every section it lays down through the block
        // contract, which lives in a BUILT package (#252). Without ^build the
        // seed resolves @saroh/block-contract to a dist nobody made — which is
        // exactly how it broke CI: the e2e job seeds two steps before it builds
        // anything, and the failure reads as a missing module rather than a
        // missing step.
        "db:seed": {
            "dependsOn": ["^build"],
            "cache": false
        },
        // The browser E2E job seeds the showcase: its specs are set in Rye & Co.,
        // Pulse Fitness and Leela & Loom, which the base seed does not make.
        // CI runs it in the same turbo run as the apps' build so the two
        // overlap; it waits for the package's OWN build too, because that
        // build's `prisma generate` rewrites the client the seed runs on.
        "db:seed:showcase": {
            "dependsOn": ["^build", "build"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "generate": {
            "dependsOn": ["^generate"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "@saroh/database#lint": {
            "dependsOn": ["^build", "build"]
        },
        "@saroh/database#typecheck": {
            "dependsOn": ["^build", "build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        // Tests write nothing worth keeping, so a cache hit replays the log.
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        // As its lint and typecheck: the package's own build runs prisma
        // generate, which its specs import.
        "@saroh/database#test": {
            "dependsOn": ["^build", "build"],
            "outputs": []
        },
        // The api's DB-free jest project (`scripts/prepush.sh` runs it through
        // turbo for the cache; CI calls the script directly).
        "test:unit": {
            "dependsOn": ["^build"],
            "outputs": []
        }
    }
}
