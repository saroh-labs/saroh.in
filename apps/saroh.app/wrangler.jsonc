// Cloudflare Worker for the merchant-site renderer, built by OpenNext
// (`pnpm cf:build`). Trial only: `saroh-sites-dev` serves a few dev
// businesses on saroh.io against the dev API. Vercel still serves saroh.app.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-sites-dev",
    "account_id": "498cfe3e983411f15a0b6184f43bfc8d",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "saroh-sites-dev"
        }
    ],
    "images": {
        "binding": "IMAGES"
    },
    "observability": {
        "enabled": true
    },
    "workers_dev": true,
    // Trial addresses: published dev businesses, one label under saroh.io
    // (the universal certificate covers one level).
    "routes": [
        { "pattern": "northwind.saroh.io", "custom_domain": true },
        { "pattern": "pulse-fitness.saroh.io", "custom_domain": true },
        { "pattern": "plan-test.saroh.io", "custom_domain": true },
        { "pattern": "test--northwind.saroh.io", "custom_domain": true },
        // A merchant's own domain, attached through Cloudflare for SaaS
        // (custom hostname on saroh.io, fallback origin sites.saroh.io).
        { "pattern": "shop-test.virashi.dev/*", "zone_name": "saroh.io" }
    ],
    // Public values; SITE_RELAY_SECRET is a Worker secret.
    "vars": {
        "API_URL": "https://api.saroh.io"
    }
}
