// Cloudflare Worker for the merchant-site renderer, built by OpenNext
// (`pnpm cf:build`). The top level is dev: `saroh-sites-dev` serves dev
// businesses on <address>.saroh.dev against the dev API. `env.production`
// below is saroh.app's Worker.
// The account comes from CLOUDFLARE_ACCOUNT_ID (a repository variable in CI;
// set it locally to Saroh labs' id before `wrangler deploy`).
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-sites-dev",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-01",
    // Off: esbuild's name-keeping wraps functions in __name(), which breaks
    // functions Next turns into inline <script>s ("__name is not defined").
    "keep_names": false,
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "saroh-sites-dev",
        },
    ],
    "images": {
        "binding": "IMAGES",
    },
    // Run the Worker next to the API (Mumbai, where api.saroh.in is), not
    // where the visitor connected: each page calls the API several times,
    // and India's traffic often arrives through Singapore or Hong Kong.
    // AWS ap-south-1 is the cloud region nearest that server.
    "placement": { "region": "aws:ap-south-1" },
    "observability": {
        "enabled": true,
    },
    // Only our own domains: no second public address on *.workers.dev
    // (it would copy the site onto a foreign domain and skip zone rules).
    "workers_dev": false,
    "preview_urls": false,
    // Dev merchant sites: <address>.saroh.dev, and the renderer's own apex
    // saroh.dev (preview and review links), as saroh.app is in production
    // (DEC-081, amended 8 Oct). Both one level deep, so the universal
    // certificate covers them.
    "routes": [
        { "pattern": "saroh.dev/*", "zone_name": "saroh.dev" },
        { "pattern": "*.saroh.dev/*", "zone_name": "saroh.dev" },
    ],
    // Settings that aren't secret; the build reads them too (scripts/cf-env.mjs).
    // SITE_RELAY_SECRET is a Worker secret, from GitHub.
    "vars": {
        "API_URL": "https://api.saroh.io",
        "NEXT_PUBLIC_API_URL": "https://api.saroh.io",
        "NEXT_PUBLIC_ROOT_DOMAIN": "saroh.dev",
    },
    "env": {
        // Production (`wrangler deploy --env production`, from main):
        // `saroh-sites` serves saroh.app and every <address>.saroh.app against
        // api.saroh.in (cut over 2026-10-07). A deploy replaces the Worker's
        // routes with these, so they live here, not only in the dashboard;
        // deploy-frontends.yml then sets them to fail open, so a failing Worker
        // falls through to the origin (Vercel) instead of an error page.
        // Bindings and vars are not inherited, so each is repeated.
        "production": {
            "name": "saroh-sites",
            "workers_dev": false,
            "preview_urls": false,
            "placement": { "region": "aws:ap-south-1" },
            "routes": [
                { "pattern": "saroh.app/*", "zone_name": "saroh.app" },
                { "pattern": "*.saroh.app/*", "zone_name": "saroh.app" },
            ],
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "saroh-sites",
                },
            ],
            "images": {
                "binding": "IMAGES",
            },
            "vars": {
                "API_URL": "https://api.saroh.in",
                "NEXT_PUBLIC_API_URL": "https://api.saroh.in",
                "NEXT_PUBLIC_ROOT_DOMAIN": "saroh.app",
            },
        },
    },
}
