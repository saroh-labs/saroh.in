# Environment
NODE_ENV=development
PORT=3333
# Which proxies may say who the client is: cloudflare (Cloudflare's edge + the
# private network: Cloudflare -> Traefik on Coolify, portless locally),
# private (a proxy in front, no CDN) or none (a bare port).
TRUST_PROXY=cloudflare

# CORS — explicit *.saroh.in allowlist (comma-separated). Defaults to the
# trusted origins + localhost dev ports when unset. Never "*".
CORS_ORIGIN=https://accounts.saroh.localhost,https://admin.saroh.localhost,https://app.saroh.localhost

# Database — api.saroh.in is the ONLY app that connects to Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/saroh_dev

# Better Auth — api hosts the auth server at /api/auth/*. The secret must be
# identical anywhere a session is validated; the URL is api's own origin.
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=https://api.saroh.localhost
# The API's own public address; payment webhook URLs are built from it (DEC-063).
# Merchants paste them into Razorpay, so keep it stable. Production: https://api.saroh.in
API_PUBLIC_URL=https://api.saroh.localhost

# Frontend origin for links emailed by api (e.g. store invitation accept
# links → {APP_URL}/invitations/{token}). The app, not api's own origin.
APP_URL=https://app.saroh.localhost
# Merchant-site renderer, for links customers open there (review invitations).
RENDERER_URL=https://saroh.app.localhost
# Accounts app, for sign-up links in waitlist invitations (admin console).
ACCOUNTS_URL=https://accounts.saroh.localhost
# Admin console, for business links in account managers' daily email.
ADMIN_URL=https://admin.saroh.localhost
# Optional: override the trusted *.saroh.in origins (comma-separated).
# Global's development domain, on the development API only. Never commit its value.
# GLOBAL_DEV_DOMAIN=
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.saroh.in,https://admin.saroh.in

# OAuth — register callbacks at {BETTER_AUTH_URL}/api/auth/callback/{github,google}
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Object storage (S2-008 — media uploads). Cloudflare R2 (S3-compatible).
# Leave these unset in local/dev and the media module falls back to a
# network-free in-memory adapter (uploads are trusted, bytes are not persisted).
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=saroh-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://cdn.saroh.in

# Site sign-in for a business's customers (ADR-011). Optional in dev and test,
# which use fixed public values; required everywhere else. SITE_RELAY_SECRET
# must match saroh.app's. 32+ characters each.
# SITE_RELAY_SECRET=
# SITE_ACCOUNTS_CODE_SECRET=
# The merchant sites' page cache (#863): `on` tells the sites' Worker
# (RENDERER_URL) which kept pages a publish, stock or price change made
# stale. Unset or `off`: nothing is sent. Switch on before the Worker's own.
# SITE_PAGE_CACHE=on
# `on` adds X-Robots-Tag: noindex, nofollow to every answer. Set on the dev
# API (api.saroh.io) only; unset or `off` adds nothing.
# ROBOTS_NOINDEX=on
# Global (saroh.tech) behind the access key until it opens: the saroh.tech
# sites' key. Only key holders reach *.saroh.tech; unset at launch.
# GLOBAL_API_ACCESS_KEY=
# The secret a public page view's visitor hash is derived from, by a salt
# that changes every day; it also keys the phone and address hashes the
# sign-in limits count by. Optional in dev and test, which use a fixed public
# value; REQUIRED in production (the API refuses to boot without it). Any
# long random string.
# ANALYTICS_IP_SALT=
# Signs the pricing draft-preview token (admin › Plans & modules). Optional
# in dev and test, which use a fixed public value; required elsewhere for
# preview to work. 32+ characters.
# PRICING_PREVIEW_SECRET=
# saroh.in is static: after a pricing publish and at a scheduled version's
# go-live, start its build (the deploy-frontends workflow) with a fine-grained
# GitHub token allowed only to run this repo's Actions. Wins over the older
# hook below. Unset: the change shows at saroh.in's next deploy. The token
# also lets Platform Owners deploy any Cloudflare app from admin's Deployments
# page (#886), to SITE_DEPLOY_ENVIRONMENT only; unset, that page deploys nothing.
# SITE_DEPLOY_GITHUB_TOKEN=
# SITE_DEPLOY_ENVIRONMENT=development
# The older revalidation hook (secret 32+ characters, the same in saroh.in).
# PRICING_SITE_URL=https://saroh.localhost
# PRICING_REVALIDATE_SECRET=
# Custom domains' hosting (#859): a verified domain is registered as a custom
# hostname on the merchant-sites zone (Cloudflare for SaaS). Its own API token,
# allowed ONLY "SSL and Certificates: Edit" on that one zone — never the sites'
# deploy token — and the zone's id. Unset: hosting is off; domains still verify.
# CLOUDFLARE_HOSTNAMES_TOKEN=
# CLOUDFLARE_HOSTNAMES_ZONE_ID=
# The zone's fallback origin, the CNAME target a merchant points at (optional).
# CLOUDFLARE_HOSTNAMES_CNAME_TARGET=
# TEST ONLY (#861's browser tests): custom domains on fakes — .example.com
# verifies without DNS, hosting puts a hostname in the state its first label
# names (live-…, problem-…). Honoured only with CI set or NODE_ENV=test;
# the API refuses to boot with it under NODE_ENV=production.
# DOMAIN_HOSTING_FAKE=1
# TEST ONLY: Stripe on a fake (U8): any restricted key connects, intents are
# made up, only the signed webhook settles. Honoured only with CI set or
# NODE_ENV=test; the API refuses to boot with it under NODE_ENV=production.
# STRIPE_FAKE=1
# Cloudflare Turnstile, the bot challenge past a shared ceiling. Unset: none asked.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# The code email's own address and stream; falls back to the SMTP_* below.
# SITE_CODES_EMAIL_FROM=codes@saroh.in
# SITE_CODES_SMTP_HOST=
# SITE_CODES_SMTP_PORT=465
# SITE_CODES_SMTP_USER=
# SITE_CODES_SMTP_PASS=
# true/false; unset, the port decides (465 = TLS, else STARTTLS).
# SITE_CODES_SMTP_SECURE=
# Development with no SMTP: log (print the code) or fail (every send fails).
# SITE_CODES_EMAIL_FAKE=log
# Saroh's own MSG91 account (DEC-191): WhatsApp verification codes, sent as
# Saroh. Unset outside production = an in-memory fake. Never a merchant's key.
# MSG91_AUTH_KEY=
# MSG91_WHATSAPP_NUMBER=
# MSG91_WHATSAPP_TEMPLATE=
# MSG91_BASE_URL=
# Delivery reports: the same value goes in MSG91's webhook as header x-saroh-webhook-secret.
# MSG91_WEBHOOK_SECRET=
# The ceiling on Saroh-paid WhatsApp sign-in codes, platform-wide: past it no
# more are sent until the window turns (SMS still is) and Platform owners are
# emailed. Unset: 100 an hour, 500 a day.
# WHATSAPP_CODES_PER_HOUR=
# WHATSAPP_CODES_PER_DAY=
# Invitation emails a day, counted per send (withdraw and invite again counts
# each time): per business, and per recipient address. Unset: defaults in code.
# INVITE_SENDS_PER_BUSINESS_PER_DAY=
# INVITE_SENDS_PER_EMAIL_PER_DAY=
# Wrong passwords one account may take in a window, from any address, before
# password sign-in waits for the window to turn. Unset: defaults in code.
# PASSWORD_FAILS_PER_ACCOUNT=
# PASSWORD_FAIL_WINDOW_MINUTES=
# Bounds on database waits, in ms (0 turns one off): a connection from a full
# pool, one statement, a transaction left idle, and a plan meter lock before a
# 429. Unset: defaults in code.
# DB_POOL_CONNECT_TIMEOUT_MS=
# DB_STATEMENT_TIMEOUT_MS=
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# PLAN_METER_LOCK_WAIT_MS=
# Requests a minute one signed-in person may make to the API. Unset: 1200;
# 0 turns it off (browser-test stacks only).
# MEMBER_REQUESTS_PER_MINUTE=
# Google Calendar changes (move bookings, Meet access, a booking's link) one
# business may ask for an hour. Unset: 120.
# GOOGLE_CALENDAR_CHANGES_PER_HOUR=
# Days a disconnected Google Calendar account is kept for a reconnect. Unset: 30.
# GOOGLE_CALENDAR_DISCONNECTED_KEEP_DAYS=
# key=template_name pairs, comma separated (WhatsApp utility templates).
# MSG91_WHATSAPP_UTILITY_TEMPLATES=
# OTP widget (SMS codes until our own DLT): public client config.
# MSG91_WIDGET_ID=
# MSG91_WIDGET_TOKEN=
# msg91 or fake (fake only in development and test). docs/architecture/MESSAGING_MSG91.md
# MESSAGING_PROVIDER=
# Encryption keys (DEC-214). Each is a 32-byte key (base64 or 64-hex), or a
# key ring written newest first: v2:<key>,v1:<key> (ids are a-z and 0-9).
# One key alone is id v1. Replacing one: docs/architecture/runbooks/KEY_ROTATION.md
# Never put a value in this file.
# Seals a queued WhatsApp send until it is accepted.
# MESSAGING_ENC_KEY=
# Seals merchants' payment and messaging provider credentials.
# PAYMENTS_ENC_KEY=
# Seals a teammate's tax id (DEC-169).
# STAFF_PII_ENC_KEY=
# Fingerprints public API keys.
# APIKEY_ENC_KEY=
# Seals outbound webhook signing secrets.
# WEBHOOK_SECRET_KEY=
# Seals Ask AI conversation and report text (DEC-220).
# AI_TEXT_ENC_KEY=
# Ask AI's provider key (Anthropic, DEC-220). Optional; checked when Ask AI calls it.
# ANTHROPIC_API_KEY=
# TEST ONLY: Ask AI answers from a script, never calling Anthropic (the Ask
# AI browser spec). Honoured only with CI set or NODE_ENV=test; the API
# refuses to boot with it under NODE_ENV=production.
# AI_PROVIDER_FAKE=1
# Saroh Social: one Meta app. Facebook Pages and Instagram sign in with
# Facebook Login for Business (the app's id, META_APP_SECRET, and a login
# configuration's id each); Threads has its own id and secret. Optional;
# connecting a channel answers 503 naming the missing one.
# META_APP_ID=
# META_APP_SECRET=
# META_FB_LOGIN_CONFIG_ID=
# META_IG_LOGIN_CONFIG_ID=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# Seals a connected channel's token.
# SOCIAL_ENC_KEY=
# TEST ONLY: Saroh Social talks to an in-memory Meta (the browser specs).
# Honoured only with CI set or NODE_ENV=test.
# SOCIAL_FAKE=1
# Seals each person's Google refresh token for Calendar sync (#1047). The
# Google client itself is AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET above.
# CALENDAR_ENC_KEY=
# TEST ONLY: Google Calendar runs on an in-memory fake, never calling Google.
# Honoured only with CI set or NODE_ENV=test.
# GOOGLE_CALENDAR_FAKE=1
# Waitlist invites (marketing U31): days of the launch offer a business made
# through an invite gets. Unset = no invites can be sent. The owner sets it.
# LAUNCH_OFFER_DAYS=
# The customer account area (Home, Me) on merchant sites: on | off (unset = off).
# Switch on together with saroh.app's SITE_ACCOUNT_AREA, API first.
# SITE_ACCOUNT_AREA=off
# Share as a post and Create post (DEC-217): on | off (unset = off; 404s).
# `pnpm dev` sets it on; switch on together with the app's NEXT_PUBLIC_SHARE_POSTS.
# SHARE_POSTS=on
# The Website area's rules in the api (owner, 20 Nov 2026): on | off. Unset is
# on only under NODE_ENV=development. On, post approval (O7) applies; off,
# posts publish as before. Switch with the app's NEXT_PUBLIC_WEBSITE_AREA.
# WEBSITE_AREA=on

# Saroh's own invoices to businesses for their plan (U17). All optional; set
# them on every instance that bills. Never commit real values.
# SAROH_LEGAL_NAME=
# 15-character GSTIN; unset, the paper is an "Invoice", not a tax invoice.
# SAROH_GSTIN=
# Two-digit GST state code; unset, the GSTIN's first two digits.
# SAROH_GST_STATE=
# SAROH_REGISTERED_ADDRESS=
# SAROH_BILLING_EMAIL=
# SAROH_INVOICE_SAC=
# Series prefix, 1–3 capitals or digits (default SA → SA/26-27/0001: the
# financial year, then a count that runs the whole year; DEC-162).
# SAROH_INVOICE_PREFIX=SA
# Export invoices to Global businesses (stage 9): their own series' prefix
# (1–3 capitals or digits, never India's) and the LUT reference and wording
# the CA confirms. Unset: no export invoice is written (Needs action says so).
# SAROH_INVOICE_PREFIX_GLOBAL=
# SAROH_EXPORT_LUT=

# Email (optional in dev — links are logged to the console when SMTP is unset).
# Production sends through Amazon SES in ap-south-1 (DEC-085): host
# email-smtp.ap-south-1.amazonaws.com, port 465, SES SMTP credentials.
# EMAIL_FROM="Saroh <noreply@saroh.in>"
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# PostHog (DEC-125): unhandled errors and the workspace's product milestones.
# Off when POSTHOG_KEY is unset. The key is the project's public key (phc_…),
# not a secret. POSTHOG_HOST defaults to https://eu.i.posthog.com.
# POSTHOG_ENVIRONMENT (development | production) is required with the key:
# one PostHog project holds both, and without it nothing is sent.
# POSTHOG_KEY=
# POSTHOG_HOST=
# POSTHOG_ENVIRONMENT=

# Days a deleted business's data is kept before its files and personal data
# are erased (DEC-122). Default 180, as the Privacy Policy says; a value can
# only lengthen it (lower is refused).
# RETENTION_AFTER_DELETION_DAYS=180

# Local only: Google refuses *.saroh.localhost redirects. Register this in the
# Google client and set it; the bare-port hit is bounced to API_PUBLIC_URL.
# GOOGLE_CALENDAR_LOCAL_REDIRECT=http://localhost:3333/integrations/google-calendar/callback
