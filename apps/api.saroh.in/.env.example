# Environment
NODE_ENV=development
PORT=3333
# Which proxies may say who the client is: cloudflare (Cloudflare's edge + the
# private network: Cloudflare -> Traefik on Coolify, portless locally),
# private (a proxy in front, no CDN) or none (a bare port).
TRUST_PROXY=cloudflare

# CORS — explicit *.saroh.in allowlist (comma-separated). Defaults to the
# trusted origins + localhost dev ports when unset. Never "*".
CORS_ORIGIN=https://accounts.saroh.localhost,https://admin.saroh.localhost,https://app.saroh.localhost

# Database — api.saroh.in is the ONLY app that connects to Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/saroh_dev

# Better Auth — api hosts the auth server at /api/auth/*. The secret must be
# identical anywhere a session is validated; the URL is api's own origin.
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=https://api.saroh.localhost
# The API's own public address; payment webhook URLs are built from it (DEC-063).
# Merchants paste them into Razorpay, so keep it stable. Production: https://api.saroh.in
API_PUBLIC_URL=https://api.saroh.localhost

# Frontend origin for links emailed by api (e.g. store invitation accept
# links → {APP_URL}/invitations/{token}). The app, not api's own origin.
APP_URL=https://app.saroh.localhost
# Merchant-site renderer, for links customers open there (review invitations).
RENDERER_URL=https://saroh.app.localhost
# Accounts app, for sign-up links in waitlist invitations (admin console).
ACCOUNTS_URL=https://accounts.saroh.localhost
# Optional: override the trusted *.saroh.in origins (comma-separated).
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.saroh.in,https://admin.saroh.in

# OAuth — register callbacks at {BETTER_AUTH_URL}/api/auth/callback/{github,google}
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Object storage (S2-008 — media uploads). Cloudflare R2 (S3-compatible).
# Leave these unset in local/dev and the media module falls back to a
# network-free in-memory adapter (uploads are trusted, bytes are not persisted).
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET=saroh-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://cdn.saroh.in

# Site sign-in for a business's customers (ADR-011). Optional in dev and test,
# which use fixed public values; required everywhere else. SITE_RELAY_SECRET
# must match saroh.app's. 32+ characters each.
# SITE_RELAY_SECRET=
# SITE_ACCOUNTS_CODE_SECRET=
# Signs the pricing draft-preview token (admin › Plans & modules). Optional
# in dev and test, which use a fixed public value; required elsewhere for
# preview to work. 32+ characters.
# PRICING_PREVIEW_SECRET=
# saroh.in's revalidation hook, called after a pricing publish and at a
# scheduled version's go-live. Unset: saroh.in refreshes on its ISR timer.
# The secret (32+ characters) is the same in saroh.in.
# PRICING_SITE_URL=https://saroh.localhost
# PRICING_REVALIDATE_SECRET=
# Cloudflare Turnstile, the bot challenge past a shared ceiling. Unset: none asked.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# The code email's own address and stream; falls back to the SMTP_* below.
# SITE_CODES_EMAIL_FROM=codes@saroh.in
# SITE_CODES_SMTP_HOST=
# SITE_CODES_SMTP_PORT=465
# SITE_CODES_SMTP_USER=
# SITE_CODES_SMTP_PASS=
# true/false; unset, the port decides (465 = TLS, else STARTTLS).
# SITE_CODES_SMTP_SECURE=
# Development with no SMTP: log (print the code) or fail (every send fails).
# SITE_CODES_EMAIL_FAKE=log
# The customer account area (Home, Me) on merchant sites: on | off (unset = off).
# Switch on together with saroh.app's SITE_ACCOUNT_AREA, API first.
# SITE_ACCOUNT_AREA=off

# Email (optional in dev — links are logged to the console when SMTP is unset).
# EMAIL_FROM="Saroh <noreply@saroh.in>"
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Error tracking (#103). Off when unset; no tracker SDK is wired yet.
# ERROR_TRACKING_DSN=
