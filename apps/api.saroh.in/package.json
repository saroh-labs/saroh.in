{
    "name": "@saroh/api",
    "version": "0.1.0",
    "description": "NestJS API for Saroh.io",
    "author": "Saroh Team",
    "license": "MIT",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main",
        "lint": "echo 'Linting skipped - use tsc --noEmit for type checking'",
        "format": "prettier --write \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "dependencies": {
        "@nestjs/common": "^10.3.3",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.3",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.3",
        "@nestjs/terminus": "^10.0.1",
        "@prisma/client": "catalog:prisma",
        "@saroh/database": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.0",
        "@nestjs/schematics": "^10.0.3",
        "@nestjs/testing": "^10.3.3",
        "@saroh/eslint-config": "workspace:*",
        "@saroh/tsconfig": "workspace:*",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@types/passport-jwt": "^3.0.13",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^10.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.8.1",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.5.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=9.0.0"
    }
}
