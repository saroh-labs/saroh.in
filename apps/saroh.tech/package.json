{
    "name": "tech",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "portless tech.saroh next dev",
        "dev:app": "next dev",
        "prebuild": "tsx scripts/make-template-files.ts && tsx scripts/check-templates.ts",
        "build": "next build",
        "postbuild": "node scripts/check-claims.mjs",
        "check:claims": "node scripts/check-claims.mjs",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "shots:sizes": "node ../saroh.in/scripts/shot-sizes.mjs --app .",
        "check:hreflang": "node scripts/check-hreflang.mjs",
        "check:templates": "tsx scripts/check-templates.ts",
        "make:templates": "tsx scripts/make-template-files.ts",
        "cf:preview": "wrangler dev",
        "cf:build": "pnpm build",
        "cf:deploy": "wrangler deploy"
    },
    "portless": "tech.saroh",
    "dependencies": {
        "@saroh/edition": "workspace:*",
        "@saroh/marketing": "workspace:*",
        "@saroh/pricing-catalog": "workspace:^",
        "@saroh/site-blocks": "workspace:*",
        "@saroh/ui": "workspace:*",
        "jspdf": "4.2.1",
        "lucide-react": "catalog:",
        "next": "^16.4.2",
        "react": "catalog:react19",
        "react-dom": "catalog:react19"
    },
    "devDependencies": {
        "@saroh/eslint-config": "workspace:*",
        "@types/node": "catalog:",
        "@types/react": "19.2.15",
        "@types/react-dom": "catalog:react19",
        "autoprefixer": "catalog:",
        "eslint": "catalog:",
        "postcss": "catalog:",
        "tailwindcss": "catalog:",
        "tsx": "^4.23.11",
        "typescript": "catalog:",
        "vitest": "^4.1.12",
        "wrangler": "4.148.0"
    }
}
