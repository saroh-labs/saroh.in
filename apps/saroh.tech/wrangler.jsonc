// saroh.tech: static files from `next build` (out/), behind worker/index.ts.
// No production routes until the owner says so: a production deploy adds them
// in its own checkout when GLOBAL_ROUTES is on (scripts/cf-global-prod.mjs).
// A Global development deploy adds its settings the same way
// (scripts/cf-global-dev.mjs).
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-tech-dev",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "out",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
    },
    "observability": { "enabled": true },
    "env": {
        "production": {
            "name": "saroh-tech",
            // Never a public workers.dev or preview address: Global answers
            // only on its own hosts, and only once the launch adds the routes.
            "workers_dev": false,
            "preview_urls": false,
            // Without it a build uses the local API (site.config.ts). Give it to
            // the build with scripts/cf-env.mjs, as deploy-frontends.yml does.
            // The release switches (plan 2026-11-13-002) are off while left
            // out, the only thing that hides a feature page here. At Global's
            // launch steps (ticket 10) add "NEXT_PUBLIC_AI_APPS": "on",
            // "NEXT_PUBLIC_SOCIAL": "on" and "NEXT_PUBLIC_TEMPLATES": "on"
            // (Global dev has them: scripts/cf-global-dev.mjs); "NEXT_PUBLIC_ASK_AI" and
            // "NEXT_PUBLIC_DEVELOPERS" wait for Global's paid plans.
            "vars": { "GLOBAL_PRODUCTION_HOSTS": "on" },
            "assets": {
                "directory": "out",
                "binding": "ASSETS",
                "run_worker_first": true,
                "html_handling": "auto-trailing-slash",
                "not_found_handling": "404-page",
            },
        },
    },
}
