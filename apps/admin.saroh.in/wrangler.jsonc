// Cloudflare Worker for the operator console, built by OpenNext (`pnpm cf:build`).
// The top level is dev; `env.production` is production. A deploy replaces
// the Worker's routes with these and the deploy workflow sets them to fail
// open. The account comes from CLOUDFLARE_ACCOUNT_ID.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-admin-dev",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-01",
    // Off: esbuild's name-keeping wraps functions in __name(), which breaks
    // functions Next turns into inline <script>s ("__name is not defined").
    "keep_names": false,
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "saroh-admin-dev",
        },
    ],
    // Run the Worker next to the API (Mumbai, where api.saroh.in is), not
    // where the visitor connected: each page calls the API several times,
    // and India's traffic often arrives through Singapore or Hong Kong.
    // AWS ap-south-1 is the cloud region nearest that server.
    "placement": { "region": "aws:ap-south-1" },
    "observability": {
        "enabled": true,
    },
    // Only our own domains: no second public address on *.workers.dev
    // (it would copy the site onto a foreign domain and skip zone rules).
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "admin.saroh.io/*", "zone_name": "saroh.io" }],
    // Settings that aren't secret. GitHub Actions builds with these too
    // (scripts/cf-env.mjs), so the build and the Worker can't disagree.
    // VERCEL_ENV / VERCEL_GIT_COMMIT_REF keep the names Vercel used: the
    // apps' checks read them. Secrets come from GitHub (deploy workflow).
    "vars": {
        "VERCEL_ENV": "preview",
        "VERCEL_GIT_COMMIT_REF": "development",
        "AUTH_COOKIE_PREFIX": "saroh-dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://api.saroh.io,https://app.saroh.io,https://accounts.saroh.io,https://admin.saroh.io,https://saroh.io,https://www.saroh.io",
        "DEV_ACCESS_COOKIE_DOMAIN": ".saroh.io",
        "DEV_REDIRECT_ORIGIN": "https://admin.saroh.in",
        "API_URL": "https://api.saroh.io",
        "NEXT_PUBLIC_ACCOUNTS_URL": "https://accounts.saroh.io",
        "NEXT_PUBLIC_API_URL": "https://api.saroh.io",
        "NEXT_PUBLIC_BETTER_AUTH_URL": "https://api.saroh.io",
    },
    "env": {
        "production": {
            "name": "saroh-admin",
            "workers_dev": false,
            "preview_urls": false,
            "placement": { "region": "aws:ap-south-1" },
            "routes": [
                { "pattern": "admin.saroh.in/*", "zone_name": "saroh.in" },
            ],
            "vars": {
                "VERCEL_ENV": "production",
                "VERCEL_GIT_COMMIT_REF": "main",
                "NEXT_PUBLIC_ACCOUNTS_URL": "https://accounts.saroh.in",
                "NEXT_PUBLIC_API_URL": "https://api.saroh.in",
                "NEXT_PUBLIC_BETTER_AUTH_URL": "https://api.saroh.in",
            },
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "saroh-admin",
                },
            ],
        },
    },
}
