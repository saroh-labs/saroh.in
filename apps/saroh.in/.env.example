# saroh.in — the public marketing site.
#
# It holds no database credentials: the only backend it talks to is
# api.saroh.in, and only from the server side.

# Server-only. api.saroh.in's origin; /api/waitlist forwards signups to
# POST {API_URL}/public/waitlist. If it is unset the route returns 500 rather
# than acknowledging a signup it did not store. The pricing page, the plan
# teasers and the free-plan line read GET {API_URL}/public/pricing; unset,
# they show the "Pricing announced at launch" placeholder.
API_URL=https://api.saroh.localhost

# Public. Where "Sign in" goes (accounts.saroh.in). Optional; defaults to
# https://accounts.saroh.in.
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.saroh.localhost

# Public. The launch switch (plan KTD-16): "waitlist" (the default) or "open".
# Waitlist mode labels every start button "Join the waitlist" and links it to
# /waitlist; open mode links to accounts' /signup with the chosen plan.
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# Server-only. Signs the visitor's address for api.saroh.in's waitlist rate
# limit (x-saroh-relay); 32+ characters, byte-identical to the API's
# SITE_RELAY_SECRET. Development and test fall back to the API's fixed dev
# value; leave unset there.
# SITE_RELAY_SECRET=

# Server-only. The shared secret api.saroh.in sends in the
# x-saroh-revalidate header when it calls POST /api/revalidate after a pricing
# version is published or goes live; 32+ characters, the same value as the
# API's. Unset, the hook refuses every call and the pricing pages refresh on
# their five-minute timer only.
# PRICING_REVALIDATE_SECRET=

# Server-only. "1" shows Resources pages and changelog entries before their
# publishOn date (plan KTD-2), to check them on a preview deployment.
# Ignored on a production deployment (VERCEL_ENV=production).
# RESOURCES_PREVIEW=1

# PostHog (DEC-125): errors only, from the browser and this app's server.
# Off, and nothing is loaded, until the project's PUBLIC key (phc_…, not a
# secret) is set. The host defaults to https://eu.i.posthog.com. Google
# Analytics above is separate and unchanged.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Session replay (DEC-125): off unless "on", which only production sets. On,
# it still records only after a visitor accepts the cookie notice (the same
# answer Google Analytics waits for), never for the team, never with Do Not
# Track or Global Privacy Control.
# NEXT_PUBLIC_POSTHOG_REPLAY=off
# Optional: the share of those visits recorded, 0 to 1. Unset: every one.
# NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE=

# Ad conversions (DEC-127): Google Ads (AW-…) and the Meta Pixel (digits),
# public ids, not secrets. Each is off, and nothing of its platform's is
# loaded or sent, until its id is set, and they are read on a production
# deployment only: set here they do nothing, so local runs and tests are
# never ad conversions. The two labels are Google Ads' own for "joined the
# waitlist" and "finished signing up". docs/architecture/ADS_TRACKING.md.
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_GOOGLE_ADS_WAITLIST_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
# NEXT_PUBLIC_META_PIXEL_ID=
