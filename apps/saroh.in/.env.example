# saroh.in — the public marketing site.
#
# It holds no database credentials: the only backend it talks to is
# api.saroh.in, and only from the server side.

# Server-only. api.saroh.in's origin; /api/waitlist forwards signups to
# POST {API_URL}/public/waitlist. If it is unset the route returns 500 rather
# than acknowledging a signup it did not store.
API_URL=https://api.saroh.localhost

# Public. Where "Sign in" goes (accounts.saroh.in). Optional; defaults to
# https://accounts.saroh.in.
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.saroh.localhost
