// Cloudflare Worker for accounts (sign-in and the business chooser), built by
// OpenNext (`pnpm cf:build`). The top level is dev (accounts.saroh.io, dev
// API); `env.production` is accounts.saroh.in. A deploy replaces the Worker's
// routes with these and the deploy workflow sets them to fail open. The
// account comes from CLOUDFLARE_ACCOUNT_ID.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-accounts-dev",
    // OpenNext's handler behind Saroh's crash page: worker.ts wraps
    // .open-next/worker.js, which `pnpm cf:build` writes.
    "main": "worker.ts",
    "compatibility_date": "2026-10-01",
    // Off: esbuild's name-keeping wraps functions in __name(), which breaks
    // functions Next turns into inline <script>s ("__name is not defined").
    "keep_names": false,
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "saroh-accounts-dev",
        },
    ],
    // Run the Worker next to the API (Mumbai, where api.saroh.in is), not
    // where the visitor connected: each page calls the API several times,
    // and India's traffic often arrives through Singapore or Hong Kong.
    // AWS ap-south-1 is the cloud region nearest that server.
    "placement": { "region": "aws:ap-south-1" },
    "observability": {
        "enabled": true,
    },
    // Only our own domains: no second public address on *.workers.dev
    // (it would copy the site onto a foreign domain and skip zone rules).
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "accounts.saroh.io/*", "zone_name": "saroh.io" }],
    // Settings that aren't secret. GitHub Actions builds with these too
    // (scripts/cf-env.mjs), so the build and the Worker can't disagree.
    // VERCEL_ENV / VERCEL_GIT_COMMIT_REF keep the names Vercel used: the
    // apps' checks read them. Secrets come from GitHub (deploy workflow).
    "vars": {
        "VERCEL_ENV": "preview",
        "NEXT_PUBLIC_VERCEL_ENV": "preview",
        // PostHog (DEC-125): errors. Off until the
        // project's public key (phc_…, not a secret) is set here. The
        // host defaults to https://eu.i.posthog.com.
        // Off on development (owner, 10 Oct): one free project, so only
        // production sends. Rehearsed on dev once, then removed.
        // "NEXT_PUBLIC_POSTHOG_KEY": "",
        // "NEXT_PUBLIC_POSTHOG_HOST": "https://eu.i.posthog.com",
        "VERCEL_GIT_COMMIT_REF": "development",
        "AUTH_COOKIE_PREFIX": "saroh-dev",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://api.saroh.io,https://app.saroh.io,https://accounts.saroh.io,https://admin.saroh.io,https://saroh.io,https://www.saroh.io",
        "DEV_ACCESS_COOKIE_DOMAIN": ".saroh.io",
        "DEV_REDIRECT_ORIGIN": "https://accounts.saroh.in",
        "NEXT_PUBLIC_ACCOUNTS_URL": "https://accounts.saroh.io",
        "NEXT_PUBLIC_APP_URL": "https://app.saroh.io",
        "NEXT_PUBLIC_BETTER_AUTH_URL": "https://api.saroh.io",
    },
    "env": {
        "production": {
            "name": "saroh-accounts",
            "workers_dev": false,
            "preview_urls": false,
            "placement": { "region": "aws:ap-south-1" },
            "routes": [
                { "pattern": "accounts.saroh.in/*", "zone_name": "saroh.in" },
            ],
            // Until early access opens (17 Oct), accounts.saroh.in admits
            // only browsers holding the prelaunch key (withDevAccess, the
            // GitHub secret PRELAUNCH_ACCESS_KEY); anyone else lands on
            // www.saroh.in. "off" here, and the next deploy takes the key
            // off the Worker and opens it.
            "vars": {
                "VERCEL_ENV": "production",
                "NEXT_PUBLIC_VERCEL_ENV": "production",
                // PostHog (DEC-125): errors. Off until the
                // project's public key (phc_…, not a secret) is set here. The
                // host defaults to https://eu.i.posthog.com.
                "NEXT_PUBLIC_POSTHOG_KEY": "phc_nXZeUYpc7a7qq5HDQM9DAwe7U9ZcvdcTiW6fLP6L5uxT", // gitleaks:allow — the project's PUBLIC key; it ships to browsers
                "NEXT_PUBLIC_POSTHOG_HOST": "https://eu.i.posthog.com",
                "VERCEL_GIT_COMMIT_REF": "main",
                "PRELAUNCH_GATE": "on",
                "DEV_REDIRECT_ORIGIN": "https://www.saroh.in",
                "DEV_REDIRECT_PATH": "/",
                "NEXT_PUBLIC_ACCOUNTS_URL": "https://accounts.saroh.in",
                "NEXT_PUBLIC_APP_URL": "https://app.saroh.in",
                "NEXT_PUBLIC_BETTER_AUTH_URL": "https://api.saroh.in",
            },
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "saroh-accounts",
                },
            ],
        },
    },
}
