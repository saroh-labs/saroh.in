// Cloudflare Worker for accounts (sign-in and the business chooser), built by
// OpenNext (`pnpm cf:build`). The top level is dev (accounts.saroh.io, dev
// API); `env.production` is accounts.saroh.in. Neither has routes until its
// cutover. The account comes from CLOUDFLARE_ACCOUNT_ID.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "saroh-accounts-dev",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "saroh-accounts-dev",
        },
    ],
    "observability": {
        "enabled": true,
    },
    "workers_dev": true,
    "routes": [],
    "env": {
        "production": {
            "name": "saroh-accounts",
            "workers_dev": true,
            "routes": [],
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "saroh-accounts",
                },
            ],
        },
    },
}
