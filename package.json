{
    "private": true,
    "license": "Elastic-2.0",
    "scripts": {
        "build": "turbo run build",
        "check:blocks": "node scripts/check-blocks.mjs",
        "check:catalog-lock": "node scripts/check-catalog-lock.mjs",
        "check:deploy-env": "node scripts/check-deploy-env.mjs",
        "check:cycles": "madge --circular --extensions ts,tsx --exclude 'node_modules|\\.next|dist|\\.turbo' apps packages",
        "check:edge-headers": "node scripts/check-edge-headers.mjs",
        "check:security-headers": "node scripts/check-security-headers.mjs",
        "check:e2e-covers": "node scripts/e2e-affected.mjs --check",
        "check:migration-ids": "node scripts/check-migration-ids.mjs",
        "check:mktemp": "node scripts/check-mktemp.mjs",
        "check:routes": "node scripts/check-app-routes.mjs",
        "check:words": "node scripts/check-words.mjs",
        "prepush": "bash scripts/prepush.sh",
        "db:migrate:deploy": "turbo run db:migrate:deploy",
        "db:push": "turbo run db:push",
        "db:seed": "turbo run db:seed",
        "dev": "turbo run dev --concurrency 100",
        "dev:accounts": "turbo run dev --filter=@saroh/api --filter=auth",
        "dev:admin": "turbo run dev --filter=@saroh/api --filter=auth --filter=admin",
        "dev:api": "turbo run dev --filter=@saroh/api",
        "dev:api-auth": "turbo run dev --filter=@saroh/api --filter=auth",
        "dev:app": "turbo run dev --filter=@saroh/api --filter=auth --filter=application",
        "dev:apps": "turbo run dev --filter=@saroh/api --filter=auth --filter=application --filter=admin --filter=sites",
        "dev:docs": "turbo run dev --filter=docs",
        "dev:emails": "turbo run dev --filter=@saroh/emails",
        "dev:help": "turbo run dev --filter=help",
        "dev:sites": "turbo run dev --filter=@saroh/api --filter=sites",
        "dev:templates": "turbo run dev --filter=@saroh/api --filter=ecom-templates",
        "dev:ui": "turbo run dev --filter=ui",
        "dev:web": "turbo run dev --filter=@saroh/api --filter=web",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md}\"",
        "lint": "turbo run lint",
        "portless:doctor": "portless doctor",
        "portless:list": "portless list",
        "portless:status": "portless service status",
        "prepare": "husky install",
        "test": "turbo run test --filter=!@saroh/api",
        "typecheck": "turbo run typecheck"
    },
    "prisma": {
        "schema": "./packages/database/prisma/schema.prisma",
        "seed": "tsx packages/database/src/seed.ts"
    },
    "devDependencies": {
        "@babel/traverse": "^7.29.8",
        "@saroh/tsconfig": "workspace:*",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.8.1",
        "husky": "^9.1.7",
        "madge": "^8.0.0",
        "portless": "^0.15.6",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pretty-quick": "^4.2.2",
        "tsx": "^4.23.11",
        "turbo": "^2.10.9"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,jsx,ts,tsx,md}": "prettier --write"
    },
    "dependencies": {
        "lint-staged": "^17.3.0",
        "prettier-quick": "^0.0.5"
    },
    "packageManager": "pnpm@9.9.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=9.9.0"
    },
    "name": "saroh.in",
    "pnpm": {
        "overrides": {
            "nextra>zod": "4.3.0",
            "nextra-theme-docs>zod": "4.3.0",
            "@types/react": "19.2.18",
            "postcss": "^8.5.26",
            "esbuild": "^0.28.1",
            "deepmerge-ts": "^8.0.1",
            "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
            "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
            "handlebars@>=4.0.0 <4.7.10": "4.7.10",
            "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
            "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
            "mysql2@<3.23.1": "3.23.1",
            "qs@<6.16.0": "6.16.0",
            "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
            "brace-expansion@<1.1.21": "1.1.21",
            "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
            "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
            "dompurify@<3.4.16": "3.4.16",
            "engine.io@>=6.6.0 <6.6.10": "6.6.10",
            "katex@>=0.11.0 <0.18.2": "0.18.2",
            "multer@<2.4.0": "2.4.0",
            "postcss-selector-parser@<7.1.6": "7.1.6",
            "sharp@<0.35.5": "0.35.5"
        }
    }
}
