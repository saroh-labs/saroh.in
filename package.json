{
    "private": true,
    "license": "Elastic-2.0",
    "scripts": {
        "prepare": "husky install",
        "build": "turbo run build",
        "db:migrate:deploy": "turbo run db:migrate:deploy",
        "db:push": "turbo run db:push",
        "db:seed": "turbo run db:seed",
        "dev": "turbo run dev --concurrency 100",
        "dev:api-auth": "turbo run dev --filter=@saroh/api --filter=auth",
        "dev:apps": "turbo run dev --filter=auth --filter=admin --filter=sites",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "check:cycles": "madge --circular --extensions ts,tsx --exclude 'node_modules|\\.next|dist|\\.turbo' apps packages",
        "check:routes": "node scripts/check-app-routes.mjs",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md}\""
    },
    "prisma": {
        "schema": "./packages/database/prisma/schema.prisma",
        "seed": "tsx packages/database/src/seed.ts"
    },
    "devDependencies": {
        "@babel/traverse": "^7.29.8",
        "@saroh/tsconfig": "workspace:*",
        "eslint": "^10.8.1",
        "husky": "^9.1.7",
        "madge": "^8.0.0",
        "portless": "^0.15.6",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pretty-quick": "^4.2.2",
        "tsx": "^4.23.11",
        "turbo": "^2.10.9"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,jsx,ts,tsx,md}": "prettier --write"
    },
    "dependencies": {
        "lint-staged": "^17.3.0",
        "prettier-quick": "^0.0.5"
    },
    "packageManager": "pnpm@9.9.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=9.9.0"
    },
    "name": "saroh.in",
    "pnpm": {
        "overrides": {
            "nextra>zod": "4.3.0",
            "nextra-theme-docs>zod": "4.3.0",
            "@types/react": "19.2.18",
            "postcss": "^8.5.26",
            "esbuild": "^0.28.1",
            "deepmerge-ts": "^8.0.1"
        }
    }
}
