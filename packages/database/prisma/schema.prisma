// Multi-Tenant SaaS Schema for Saroh.io
// E-commerce + Blogs + Multi-Payment Providers

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

// Global users (can own multiple stores)

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  image String?

  // Better Auth stores the email/password credential on the Account row,
  // so the User table no longer carries a password column.
  emailVerified Boolean @default(false)

  // Relations
  stores       StoreOwner[] // Stores they own
  memberships  Membership[] // Organizations they belong to
  storeMembers StoreMembers[] // Staff positions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@index([email])
}

// Organization: the sole tenant root (DEC-005 / ADR-001). Owns Stores and
// carries Membership. Renamed from the former optional Workspace grouping.

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Relations
  stores      Store[]
  memberships Membership[]

  createdAt DateTime @default(now())
}

// Membership: links a User to an Organization with a role (renamed from
// WorkspaceMember). The single membership table StoreOwner/StoreMembers
// converge on during the Stage 1 transition.
model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String @default("MEMBER") // OWNER, ADMIN, MEMBER

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// ============================================================================
// STORE (Multi-Tenant Root)
// ============================================================================

model Store {
  id String @id @default(cuid())

  // Basic info
  name        String
  slug        String  @unique
  description String?
  logo        String?

  // Ownership
  // ADR-001: Store becomes an Organization-owned commerce channel. Nullable
  // during the Stage 1 transition (dual-write + backfill), constrained NOT NULL
  // once every Store maps to a verified Organization.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  owners      StoreOwner[]
  members     StoreMembers[]
  invitations StoreInvitation[]

  // Products & E-commerce
  products   Product[]
  categories Category[]
  orders     Order[]
  carts      Cart[]
  customers  Customer[]
  inventory  Inventory[]

  // Blogs
  posts          Post[]
  postCategories PostCategory[]

  // Payments & Integrations
  paymentConfigs     StorePaymentConfig[]
  transactions       Transaction[]
  refunds            Refund[]
  integrationSecrets IntegrationSecret[]

  // Settings
  settings      StoreSettings?
  features      StoreFeatures?
  customDomains CustomDomain[]
  apiKeys       StoreApiKey[]

  // Audit
  auditLogs        AuditLog[]
  secretAccessLogs SecretAccessLog[]

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([slug])
  @@index([createdAt])
}

// Store owners

model StoreOwner {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String @default("OWNER") // OWNER, ADMIN

  @@unique([storeId, userId])
  @@index([storeId])
}

// Store members (staff/employees)

model StoreMembers {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        String // ADMIN, MANAGER, EDITOR, VIEWER
  permissions Int    @default(0) // Bitmask for fine-grained perms

  posts Post[] // Posts they authored

  createdAt DateTime @default(now())

  @@unique([storeId, userId])
  @@index([storeId])
}

// Pending invitations to join a store's team. Accepting one creates a
// StoreMembers row for the invited user (matched by email).

model StoreInvitation {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email String // who was invited (need not have an account yet)
  role  String @default("VIEWER") // ADMIN, MANAGER, EDITOR, VIEWER

  token  String @unique // random, carried in the accept link
  status String @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  invitedById String // User.id of the inviter
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([storeId, email]) // one live invite per email per store
  @@index([storeId])
  @@index([token])
}

// ============================================================================
// E-COMMERCE: PRODUCTS
// ============================================================================

model Product {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String? @db.Text
  image       String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  status String @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED

  // Relations
  variants   ProductVariant[]
  orderItems OrderItem[]
  inventory  Inventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku   String
  title String // e.g., "Red / Large"

  price Decimal? @db.Decimal(10, 2)
  image String?

  createdAt DateTime @default(now())

  @@unique([productId, sku])
}

model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())

  @@unique([storeId, slug])
  @@index([storeId])
}

// Inventory tracking

model Inventory {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity      Int @default(0)
  reserved      Int @default(0) // In pending orders
  lowStockAlert Int @default(10)

  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ============================================================================
// E-COMMERCE: CUSTOMERS & CARTS
// ============================================================================

// Customers are store-specific
// Email is unique PER STORE, not globally

model Customer {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email     String // NOT globally unique, unique per store
  firstName String?
  lastName  String?
  phone     String?

  // Address info
  country String?
  state   String?
  city    String?
  zipCode String?

  orders Order[]
  carts  Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
}

model Cart {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Items stored as JSON for flexibility
  items Json @default("[]") // [{ productId, variantId, quantity, price }]

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, customerId])
  @@index([storeId])
}

// ============================================================================
// E-COMMERCE: ORDERS
// ============================================================================

model Order {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderId    String // Store-specific order number (ORD-001, etc)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Pricing
  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  shipping Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  currency String @default("USD")

  // Status
  status        String @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus String @default("UNPAID") // UNPAID, PAID, FAILED, REFUNDED

  // Relations
  items        OrderItem[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, orderId])
  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// ============================================================================
// PAYMENTS & TRANSACTIONS
// ============================================================================

enum PaymentProvider {
  STRIPE
  RAZORPAY
  CASHFREE
  DODO
}

model StorePaymentConfig {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  provider PaymentProvider

  // Encrypted secrets stored here
  secretKeyEncrypted String
  publicKeyEncrypted String?

  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // Default payment method

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model Transaction {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Provider reference
  provider              PaymentProvider
  providerTransactionId String

  // Amount
  amount   Decimal @db.Decimal(12, 2)
  currency String

  // Status
  status       String // SUCCESS, FAILED, PENDING, REFUNDED
  errorMessage String?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  refund    Refund?

  @@unique([provider, providerTransactionId])
  @@index([storeId])
  @@index([orderId])
}

model Refund {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  reason String

  status String @default("PENDING") // PENDING, COMPLETED, FAILED

  createdAt DateTime @default(now())
}

// ============================================================================
// BLOGS
// ============================================================================

model Post {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title   String
  slug    String
  excerpt String?
  content String  @db.Text // Markdown or HTML

  // Optional: a post is authored by a staff member (StoreMembers), but a store
  // owner is a StoreOwner — not a member — so owner-authored posts have no
  // author row. See StoresService: owners are deliberately kept out of members.
  authorId String?
  author   StoreMembers? @relation(fields: [authorId], references: [id])

  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id])

  featured Boolean @default(false)
  image    String?

  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt DateTime?

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([authorId])
}

model PostCategory {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String
  slug String

  posts Post[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentHierarchy", fields: [parentId], references: [id])
  children Comment[] @relation("CommentHierarchy")

  authorName  String
  authorEmail String
  content     String

  approved Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([postId])
}

// ============================================================================
// INTEGRATIONS & SECRETS
// ============================================================================

model IntegrationSecret {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  key            String // STRIPE_SK, RAZORPAY_KEY, GMAIL_OAUTH, etc
  valueEncrypted String // Encrypted with SECRETS_MASTER_KEY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([storeId])
}

// ============================================================================
// STORE SETTINGS & FEATURES
// ============================================================================

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // General
  language String @default("en")
  timezone String @default("UTC")
  currency String @default("USD")

  // Taxes
  taxEnabled Boolean @default(false)
  taxRate    Decimal @default(0) @db.Decimal(5, 2)

  // Shipping
  shippingEnabled       Boolean  @default(true)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)

  // Theme
  theme        String  @default("light") // light, dark, custom
  primaryColor String?

  updatedAt DateTime @updatedAt
}

model StoreFeatures {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ecommerceEnabled    Boolean @default(true)
  blogsEnabled        Boolean @default(false)
  customDomainEnabled Boolean @default(false)
  apiAccessEnabled    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model CustomDomain {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  domain            String    @unique
  verified          Boolean   @default(false)
  verificationToken String?
  verifiedAt        DateTime?

  primary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([storeId])
}

model StoreApiKey {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name   String
  key    String @unique
  secret String // Encrypted

  permissions Json @default("{}") // {"orders:read": true, "products:write": false}

  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("ApiKey")
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

model AuditLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId   String? // Who did it (null for system)
  action   String // PRODUCT_CREATED, ORDER_UPDATED, etc
  entity   String // Product, Order, etc
  entityId String? // ID of affected entity

  changes   Json? // Before/after values
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

model SecretAccessLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  action    String // SECRET_ACCESSED, SECRET_CREATED, etc
  secretKey String // STRIPE_SK, RAZORPAY_KEY, etc

  actorType String // system, user
  actorId   String?

  status String // success, failed
  reason String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
