// Multi-Tenant SaaS Schema for Saroh.io
// E-commerce + Blogs + Multi-Payment Providers

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  // Partial unique indexes (ADR-007): one live invoice per subscription
  // period, one active enrolment per person per course, one pending renewal
  // run. Declaring them here keeps migration replay free of drift.
  previewFeatures = ["partialIndexes"]
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

// Global users (can own multiple stores)

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  image String?

  // Better Auth stores the email/password credential on the Account row,
  // so the User table no longer carries a password column.
  emailVerified Boolean @default(false)

  // Relations
  stores       StoreOwner[] // Stores they own
  memberships  Membership[] // Organizations they belong to
  storeMembers StoreMembers[] // Staff positions

  // Project-level access (S1-010): team memberships and direct project grants
  teamMemberships TeamMember[] // Teams they belong to
  projectAccess   ProjectAccess[] // Direct project-role grants

  // Saroh-staff grants (S1-012 admin). Two sides: the grant held BY this user,
  // and the grants they have issued to others.
  platformAdmin         PlatformAdmin?  @relation("PlatformAdminUser")
  platformAdminsGranted PlatformAdmin[] @relation("PlatformAdminGrantedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // Sites this user was invited to review (#276), and the invitations they sent.
  siteReviews        SiteReviewer[]           @relation("SiteReviewerUser")
  siteReviewsGranted SiteReviewer[]           @relation("SiteReviewerGrantedBy")
  invitationsSent    OrganizationInvitation[]

  siteComments     SiteComment[]
  posts            Post[] // Posts they wrote (ADR-004)
  siteApprovals    SiteApproval[]
  sitePreviewLinks SitePreviewLink[]

  // Bookings they moved or cancelled on a customer's behalf (#121).
  bookingEvents BookingEvent[] @relation("BookingEventActor")

  // What this person chose to hear about, per business (round-2 F14).
  notificationPreferences NotificationPreference[]

  @@index([email])
}

// Organization: the sole tenant root (DEC-005 / ADR-001). Owns Stores and
// carries Membership. Renamed from the former optional Workspace grouping.

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Platform lifecycle is independent of a tenant user's membership role.
  // Changes are made only through audited control-plane commands.
  lifecycleStatus  String @default("ACTIVE")
  lifecycleVersion Int    @default(1)

  // What is being set up (DEC-070): BUSINESS (a shop, studio, practice),
  // SOLO ("Just me": a freelancer, consultant, creator) or WORK ("A site for
  // my work": a portfolio, blog, projects). It changes Saroh's words and
  // defaults only, never a feature, gate or entitlement. The API reads it
  // through `organizations/organization-kind.ts`, and a source scan pins who
  // may. Every business before it is BUSINESS. A CHECK constraint holds the
  // values.
  kind String @default("BUSINESS")

  suspendedAt         DateTime?
  suspendedByUserId   String?
  suspensionReason    String?
  deletionScheduledAt DateTime?
  deletionScheduledBy String?
  deletionReason      String?
  deletedRetainedAt   DateTime?

  // Relations
  stores              Store[]
  memberships         Membership[]
  adminAccessSessions AdminAccessSession[]

  // Optional groupings beneath the org (S1-010). Projects and Teams are NEVER
  // a tenant/ownership/billing root — always org-scoped (ADR-001).
  projects Project[]
  teams    Team[]

  // Organization module (capability) installations (ADR-003 / #113). One row
  // per (org, moduleKey); lifecycle DISABLED|ENABLED|ARCHIVED. Readiness is
  // derived, never stored here.
  organizationModules OrganizationModule[]

  // Explicit customer identity links (#120): a user-confirmed connection between
  // a CRM Contact and a commerce Customer. Never an automatic merge.
  customerIdentityLinks CustomerIdentityLink[]
  contactNotes          ContactNote[]
  contactNoteAllergens  ContactNoteAllergen[]

  // Saved list views (#124): per-actor, per-resource named filter sets.
  savedViews SavedView[]

  // Pending and settled invitations to join this organization (#276).
  invitations OrganizationInvitation[]

  // Per-site review grants held by this org's REVIEWER members (#276).
  siteReviewers SiteReviewer[]

  // Optional 1:1 business identity captured at onboarding (S1-004)
  businessProfile BusinessProfile?

  // Per-organization feature-flag overrides (S1-012)
  featureFlagOverrides FeatureFlagOverride[]

  // Time-bounded raises of one plan limit, granted from the admin console.
  entitlementOverrides EntitlementOverride[]

  // Uploaded media objects, org-owned (S2-008). Bytes live in object storage
  // (R2); this is the tenant-scoped metadata index.
  media Media[]

  // Products v2 (#460): photos, per-variant stock, store options, defaults.
  productImages      ProductImage[]
  variantInventory   VariantInventory[]
  productOptions     ProductOption[]
  productOptionVals  ProductOptionValue[]
  catalogueDefaults  CatalogueDefaults[]
  productFields      ProductField[]
  productFieldValues ProductFieldValue[]
  storeAllergens     StoreAllergen[]
  productAllergens   ProductAllergen[]

  // Listings and stock per storefront (#510).
  productListings        ProductListing[]
  productListingVariants ProductListingVariant[]
  stockLevels            StockLevel[]
  stockEntries           StockEntry[]
  stockCheckResolutions  StockCheckResolution[]

  // Collections: hand-picked or automatic by category (#516).
  collections        Collection[]
  collectionProducts CollectionProduct[]

  // CMS / publishing (Stage 2 — S2-001). Every CMS entity is org-owned and
  // carries `organizationId` for tenant scoping / RLS.
  sites                Site[]
  pages                Page[]
  pageVersions         PageVersion[]
  sections             Section[]
  siteComments         SiteComment[]
  siteApprovals        SiteApproval[]
  sitePreviewLinks     SitePreviewLink[]
  publications         Publication[]
  // Frozen candidates of a site and their links (DEC-071).
  siteTestReleases     SiteTestRelease[]
  siteTestReleaseLinks SiteTestReleaseLink[]
  // A site's verification codes and own trackers (DEC-108).
  siteVerifications    SiteVerification[]
  siteTrackers         SiteTracker[]
  siteTrackingSettings SiteTrackingSettings[]
  // A site's QR codes and their daily scan counts.
  qrCodes              QrCode[]
  qrScanDays           QrScanDay[]

  // Subdomain / custom-domain claims (S2-007). Each Domain is org-owned and its
  // `hostname` is globally unique, so a hostname maps to at most one org.
  domains Domain[]

  // Enquiry / CRM (Stage 3 — S3-001). The public enquiry funnel and its CRM.
  // Every entity is org-owned and carries `organizationId` for tenant scoping.
  contacts    Contact[]
  forms       Form[]
  submissions Submission[]
  pipelines   Pipeline[]
  stages      Stage[]
  leads       Lead[]
  activities  Activity[]

  // Durable background jobs / transactional outbox (Stage 3 — S3-003). Optional
  // tenant scope: some jobs are org-bound (an enquiry notification), some are
  // system-wide, so the back-relation is nullable on the Job side.
  jobs Job[]

  // In-app notification inbox (Stage 3 — S3-006). Durable per-org (optionally
  // per-user) records surfaced in the dashboard; email is a delivery channel
  // driven by the job worker on top of these rows.
  notifications Notification[]

  // Scheduling / bookings (Stage 4 — S4-001). Org-owned bookable Services with
  // weekly AvailabilityRules and immutable Bookings.
  services          Service[]
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  bookingEvents     BookingEvent[]

  // Commerce attached to the Organization (Stage 5 — S5-001). Store becomes an
  // optional channel; catalog/orders/inventory/customers are org-owned via a
  // denormalized organizationId (backfilled from Store), nullable during the
  // transition.
  products   Product[]
  categories Category[]
  inventory  Inventory[]
  customers  Customer[]
  carts      Cart[]
  orders     Order[]

  // Payments (Stage 5 — S5-002/003). Org-owned provider connections (encrypted
  // credentials), intents/attempts/refunds, and the signed webhook inbox.
  merchantPaymentProviders MerchantPaymentProvider[]
  paymentIntents           PaymentIntent[]
  paymentAttempts          PaymentAttempt[]
  paymentRefunds           PaymentRefund[]
  webhookEvents            WebhookEvent[]

  // Communications (Stage 6 — S6-001). Org-connected email/WhatsApp providers,
  // outbound messages, delivery records, per-contact channel consent, and the
  // new-lead automation rules (S6-003).
  communicationProviders CommunicationProvider[]
  messages               Message[]
  deliveries             Delivery[]
  consents               Consent[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]

  // Stage 7 — analytics (S7-001)
  analyticsEvents          AnalyticsEvent[]
  analyticsDailyAggregates AnalyticsDailyAggregate[]

  // Stage 7 — SaaS billing (S7-005). One current subscription per org.
  subscription Subscription?

  createdAt           DateTime             @default(now())
  idempotencyRecords  IdempotencyRecord[]
  roles               OrganizationRole[]
  discounts           Discount[]
  discountRedemptions DiscountRedemption[]
  productReviews      ProductReview[]
  reviewInvitations   ReviewInvitation[]

  // Subscriptions, invoices, courses and class packs (ADR-007).
  subscriptionPlans     SubscriptionPlan[]
  customerSubscriptions CustomerSubscription[]
  subscriptionSkips     SubscriptionSkip[]
  invoices              Invoice[]
  invoiceLines          InvoiceLine[]
  invoiceSequences      InvoiceSequence[]
  courses               Course[]
  courseSessions        CourseSession[]
  courseEnrollments     CourseEnrollment[]
  classPacks            ClassPack[]
  classPackServices     ClassPackService[]
  packPurchases         PackPurchase[]
  packRedemptions       PackRedemption[]

  // Staff who take bookings, their hours and the business's booking rules
  // (ADR-008, U3).
  staffMembers    StaffMember[]
  staffServices   StaffService[]
  staffHours      StaffHours[]
  staffTimeOff    StaffTimeOff[]
  staffExtraHours StaffExtraHours[]
  bookingRules    BookingRules?

  // A business's own customers who sign in on its site (ADR-011, DEC-037).
  customerAccounts    CustomerAccount[]
  customerSignInCodes CustomerSignInCode[]
  customerSessions    CustomerSession[]

  // Needs attention on a customer (DEC-040, C1).
  contactAttention ContactAttention[]

  // Days or hours the whole business is closed (E3).
  businessClosures BusinessClosure[]

  // Every change to a plan, append-only (plan 2026-09-26-004, D2).
  subscriptionPlanEvents SubscriptionPlanEvent[]

  // Everything done to a subscription, append-only (plan 2026-09-26-004, D9).
  subscriptionEvents SubscriptionEvent[]

  // When an owner or admin dismissed Team's one-time notice naming the
  // storefront people the F16 backfill put on the team (DEC-048). Null: not
  // dismissed. Only people added after it are listed again.
  storefrontTeamNoticeDismissedAt DateTime?

  // The business's referral code (DEC-102, #812): the `?ref=` its site's
  // "Made with Saroh" credit links with on Free. 8 characters a reader can't
  // confuse, never the business name. Null until the credit is first
  // drawn, which gives it one; referral attribution (#809) reads it.
  referralCode String? @unique

  // A customer's message thread with the business (round-2 A13).
  customerThreads        CustomerThread[]
  customerThreadMessages CustomerThreadMessage[]

  // Autopay mandates at the business's own provider (round-2 D11, D20).
  paymentMandates          PaymentMandate[]
  // A class pack's history and its holders' extensions (round-2 E13).
  packEvents               PackEvent[]
  packExtensions           PackExtension[]
  // The notices told about a customer's bookings and orders (round-2 A14).
  customerNotices          CustomerNotice[]
  // Places in line for full classes (round-2 A12).
  classWaitlistEntries     ClassWaitlistEntry[]
  // Bulk kitchen moves held on the server, then committed (round-2 B6).
  orderStageBatches        OrderStageBatch[]
  // Each person's alert choices here (round-2 F14).
  notificationPreferences  NotificationPreference[]
  // Its one order-number series, across every storefront (P3, DEC-066).
  orderNumberSequence      OrderNumberSequence?
  // Web addresses it used to have, held for it after a change (DEC-069, L1).
  addressReservations      AddressReservation[]
  // Saroh billing: add-ons bought and coupons used (pricing catalogue U1).
  subscriptionAddons       SubscriptionAddon[]
  pricingCouponRedemptions PricingCouponRedemption[]
  // Saroh billing: checkouts for a plan change (pricing catalogue U15).
  billingCheckouts         BillingCheckout[]
  sarohInvoices            SarohInvoice[]
  // Saroh billing: add-ons owed on the next charge (pricing catalogue U16).
  subscriptionAddonCharges SubscriptionAddonCharge[]
}

// BusinessProfile: optional 1:1 business identity for an Organization, captured
// during onboarding (S1-004). Kept separate from Organization so the tenant root
// stays lean while legal/tax/contact details evolve independently. All fields are
// optional — an org can onboard with just a name and fill this in later.
model BusinessProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  legalName         String?
  type              String? // individual, partnership, llp, pvt, public, trust; an old `company` = pvt until the F10b backfill rewrites it; accepted until Z4 (business-type.ts)
  // Setup's answer to "Is it registered?": true for Registered (Pvt Ltd,
  // LLP, partnership…), which saves no `type`, false for Not registered.
  // Null: not asked (a site for someone's work, a business set up before
  // it was kept). True with no `type` asks for the real type before the
  // business goes live (the take-money checklist).
  legallyRegistered Boolean?
  country           String?
  taxId             String?
  contactEmail      String?
  website           String?

  // IANA zone the business keeps time in (ADR-007): the default a new
  // subscription snapshots for its renewal dates. Null until the business
  // sets it; the subscribe flow asks when it is missing.
  timezone String?

  // GST (ADR-008, U5). A registered business issues tax invoices; its GSTIN
  // is `taxId`, checked against `gstState` (a two-digit GST state code, e.g.
  // "29" Karnataka) when registration is switched on. Unregistered: receipts.
  // `gstState` is also the state of the registered address below, registered
  // or not — one field, so the address and the GSTIN can never disagree.
  gstRegistered Boolean @default(false)
  gstState      String?

  // The registered address (CGST rule 46: a tax invoice names the supplier's
  // address). Required once GST-registered; its state is `gstState`. Copied
  // onto each invoice at issue (`Invoice.sellerAddress`).
  addressLine1        String?
  addressLine2        String?
  city                String?
  postalCode          String?
  // The invoice number's prefix ("RC" → RC/26-27/0001 when registered,
  // RC-0001 when not). Null: the legacy INV series.
  invoicePrefix       String?
  // How the business's invoice numbers are built — { parts, separator,
  // digits, restart } (invoices/numbering.ts, NumberFormat). Null: the
  // default for its GST standing, the numbers every business had before it
  // could choose (RC/26-27/0001 registered, RC-0001 not).
  invoiceNumberFormat Json?
  // Delivery on an order's invoice is a taxed line: this rate and SAC.
  deliveryGstRate     Decimal @default(18) @db.Decimal(5, 2)
  deliverySacCode     String?

  // The logo printed at the top of the business's invoices and receipts: a
  // library object, and the address it is served from, taken when it was
  // set (the product-photo pattern). The library refuses to delete it while
  // it is the logo; the SetNull is only a backstop.
  logoMediaId String?
  logoMedia   Media?  @relation("BusinessLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  logoUrl     String?

  // Products (#484, the business's since #529): how the editor suggests a
  // SKU. Null = the built-in pattern; suggestions off leave the SKU empty.
  skuPattern String?
  skuSuggest Boolean @default(true)

  // Track stock for the whole business (#515). Off: every product always
  // sells and nothing is counted, whatever its own switch says; turned off
  // only while nothing is promised anywhere, with a counted-to-0 entry per
  // shelf that had stock. No profile yet reads as on.
  stockTracking Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The business's public phone (DEC-053): the merchant's own number, shown
  // only on this business's site — the Visit us Call button and "Or call
  // ‹Business› on ‹phone›" when a sign-in code can't be sent. E.164
  // ("+919845012345"), checked by the API and by a CHECK constraint. Null:
  // no number, and the site shows no Call button rather than an empty one.
  phone String?

  // "Members can pause from their account" (round-2 A8), beside the
  // subscriptions' time zone above: on, a member pauses their own plan for
  // 2, 4 or 8 weeks from the account area on the business's site; off, the
  // account shows no Pause and the API refuses a customer's pause (403).
  // Staff pause either way. No profile yet reads as on.
  membersCanPause Boolean @default(true)

  // When autopay debits a renewal (round-2 D13B, DEC-065): ON_RENEWAL_DATE
  // (the invoice and bank notice go out early so the debit lands on the
  // renewal date), DAY_AFTER_RENEWAL (D13: invoice on the renewal date,
  // debit about a day later) or ON_DUE_DATE (debit on the invoice's due
  // date). A plan's `autopayChargeTiming` wins when set. A CHECK constraint
  // holds the values. No profile yet reads as DAY_AFTER_RENEWAL.
  autopayChargeTiming String @default("DAY_AFTER_RENEWAL")

  // "How to pay us" (R32): how a customer pays the business offline, on
  // every plan. Shown only on a customer's own unpaid invoice, order and
  // booking pages (the public reads by token or session), never listed by
  // slug. All optional; nothing set keeps the generic "pay them the way
  // they've asked" line. Checked and trimmed by the API
  // (`organizations/business-pay-instructions.ts`) and never logged; the
  // audit stream names a change, never the value.
  // A UPI ID ("name@bank"), lower-cased; the page draws its QR.
  payUpiId             String?
  // Bank transfer: the name on the account, its number (digits only, CHECK),
  // the IFSC (CHECK) and the bank's name.
  payBankAccountName   String?
  payBankAccountNumber String?
  payBankIfsc          String?
  payBankName          String?
  // A short note under them ("Send a screenshot to 98450 12345 once paid").
  payNote              String?
}

// Membership: links a User to an Organization with a role (renamed from
// WorkspaceMember). The single membership table StoreOwner/StoreMembers
// converge on during the Stage 1 transition.
model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The role's `key`, resolved against OrganizationRole rows in the SAME
  // organization. Not a foreign key: a membership must survive its role being
  // renamed or removed, and a dangling key resolves to the read-only floor
  // rather than to an error nobody can sign in past. Still OWNER, ADMIN,
  // MEMBER or REVIEWER for every business that has invented nothing.
  role String @default("MEMBER")

  // The staff member this team member is on the diary as, if any (U3).
  staffMember StaffMember?

  // Extra permissions for this one person, on top of their role (F17,
  // DEC-039). Action keys, like OrganizationRole.actions: unknown strings are
  // dropped on read, and an extra only ever adds. Set by someone holding
  // `member:role:update`, within their own reach, never on themselves.
  extraActions String[] @default([])

  // When they joined the business (#800): who stays when a move to a lower
  // plan leaves fewer seats — the owner, then the earliest to join. Rows
  // from before the column were backfilled from the invitation they
  // accepted, else the later of the account's and the business's start.
  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// OrganizationRole: a role, and the permissions it grants (custom roles).
//
// A business invents the roles it needs — "Stock clerk", "Bookkeeper" — and
// the owner ticks what each may do from the catalogue in
// `organization-policy.ts` / `capability-catalogue.ts`. The four built-ins are
// seeded per organization as `system` rows so the screen can render every role
// the same way; they cannot be renamed, re-permissioned or deleted.
//
// `actions` holds OrgAction strings. Not a join table: the set is small, read
// on every authorized request, and never queried ACROSS organizations — the
// question is always "what may this role, in this business, do", which is one
// row. A join table would add a hop to the hottest path in the API to answer
// a question nothing asks.
model OrganizationRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stable, referenced by Membership.role and OrganizationInvitation.role.
  // Uppercase for the built-ins; a slug for invented ones.
  key   String
  label String

  // OrgAction values (organization-policy.ts). Empty is legal and means a role
  // that can reach nothing yet — a half-built role is not an invalid one.
  actions String[] @default([])

  // The ring the avatar wears on Team, so two people are never visually
  // identical. Named, never a hex: the palette belongs to the token layer.
  ringTone String @default("slate")

  // Built-in. OWNER, ADMIN, MEMBER and REVIEWER are seeded for every
  // organization and are read-only: their permissions are the shipped policy,
  // and letting a business edit them would make role names mean different
  // things in different businesses.
  system Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Media: an org-owned uploaded object (S2-008). The bytes live in object
// storage (Cloudflare R2 in prod, in-memory in dev/tests) behind the
// `@saroh/object-storage` port; this row is the tenant-scoped metadata index.
//
// Lifecycle: a row is created `PENDING` when a presigned upload URL is issued,
// then flipped to `READY` once the client confirms (via the complete endpoint)
// that the bytes landed. `key` is the server-derived, tenant-scoped storage key
// (`org/<organizationId>/...`) — never client-supplied — and is globally unique.
// SiteReviewer: one person's permission to review ONE site (#276).
//
// A REVIEWER's org role grants site:read, site:comment and site:approve, but a
// reviewer is brought in to look at a particular site — often an outside
// copywriter or a client's own manager. Without this table the role would mean
// "read every site this business has", which is not what anyone inviting a
// reviewer intends. Enforced in site-access.ts (assertSiteInOrg) and listSites:
// to a REVIEWER, a site with no grant does not exist.
//
// Deleted with the site, the user, or the org. A grant outliving any of the
// three is meaningless.
model SiteReviewer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("SiteReviewerUser", fields: [userId], references: [id], onDelete: Cascade)

  // Who granted it. SetNull, not cascade: the grant survives the granter
  // leaving, the same way an approval survives its author.
  grantedByUserId String?
  grantedBy       User?   @relation("SiteReviewerGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([siteId, userId])
  @@index([organizationId])
  @@index([userId])
}

// OrganizationInvitation: an offer to join an Organization at a role (#276).
//
// Separate from StoreInvitation, which invites to a Store with the store role
// vocabulary. Organization is the tenant root (ADR-001), and org roles are what
// authorization is actually decided from.
//
// The token is stored HASHED (sha256 hex), like SitePreviewLink: the plaintext
// exists only in the invitee's email. A leaked database row cannot be used to
// join an organization.
model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email String // who was invited; they need not have an account yet
  role  String // OWNER, ADMIN, MEMBER, REVIEWER

  // Sites a REVIEWER invite grants on accept. Empty for every other role.
  // Held here rather than as rows because the invitee has no User row yet.
  siteIds String[]

  // The person on the diary this invite gives a login to (#868): someone
  // taking bookings with no login (DEC-105). Accepting links them to the new
  // membership; while it is open they are counted once, as that diary
  // person. SetNull: a diary person deleted leaves an ordinary invite.
  staffId     String?
  staffMember StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  tokenHash String @unique // sha256 of the token carried in the accept link
  status    String @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  // SetNull: an invitation outlives the person who sent it.
  invitedByUserId String?
  invitedBy       User?   @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([organizationId, email]) // one live invite per email per org
  @@index([organizationId])
  @@index([staffId])
}

// ============================================================================
model Media {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String  @unique // object-storage key (server-derived, tenant-scoped)
  contentType String
  sizeBytes   Int
  filename    String
  purpose     String? // logical bucketing, e.g. product-image, avatar
  status      String  @default("PENDING") // PENDING → READY, or FAILED when the bytes are not what the type says

  uploadedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Products that show this object. Taking it off a product never deletes it.
  productImages  ProductImage[]    @relation("ProductImageMedia")
  // Product videos that use it as their poster.
  productPosters ProductImage[]    @relation("ProductImagePoster")
  // The business whose logo it is (at most one: a logo is per business).
  businessLogos  BusinessProfile[] @relation("BusinessLogo")

  @@index([organizationId])
}

// ============================================================================
// STORE (Multi-Tenant Root)
// ============================================================================

model Store {
  id String @id @default(cuid())

  // Basic info
  name        String
  // Dead: the storefront "Web address" went nowhere (DEC-069). L14 made it
  // nullable and stopped reading and writing it; existing rows keep theirs.
  // L15 drops the column (a later release).
  slug        String? @unique
  description String?
  logo        String?

  // Ownership
  // ADR-001: Store is an Organization-owned commerce channel. The nullable
  // Stage 1 transition (dual-write + backfill) is complete; the column is now
  // NOT NULL (B5), so every Store maps to a verified Organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Relations
  owners      StoreOwner[]
  members     StoreMembers[]
  invitations StoreInvitation[]

  // Products & E-commerce
  products   Product[]
  categories Category[]
  orders     Order[]
  carts      Cart[]
  customers  Customer[]
  inventory  Inventory[]

  // Payments & Integrations
  paymentConfigs     StorePaymentConfig[]
  transactions       Transaction[]
  refunds            Refund[]
  integrationSecrets IntegrationSecret[]

  // Settings
  settings      StoreSettings?
  features      StoreFeatures?
  customDomains CustomDomain[]
  apiKeys       StoreApiKey[]

  // Audit
  auditLogs        AuditLog[]
  secretAccessLogs SecretAccessLog[]

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  discountReach DiscountStore[]

  productReviews ProductReview[]

  productOptions    ProductOption[]
  catalogueDefaults CatalogueDefaults[]
  productFields     ProductField[]
  allergens         StoreAllergen[]

  // What it sells from the business's catalogue, and its shelf (#510).
  listings     ProductListing[]
  stockLevels  StockLevel[]
  stockEntries StockEntry[]

  // The sites that sell from it (G11, `Site.storefrontId`).
  sitesSellingHere Site[] @relation("SiteStorefront")

  // The target of (storeId, organizationId) foreign keys: a listing or a
  // stock row can only name a storefront of its own business.
  @@unique([id, organizationId])
  @@index([slug])
  @@index([createdAt])
}

// Store owners

model StoreOwner {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String @default("OWNER") // OWNER, ADMIN

  @@unique([storeId, userId])
  @@index([storeId])
}

// Store members (staff/employees)

model StoreMembers {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        String // ADMIN, MANAGER, EDITOR, VIEWER
  permissions Int    @default(0) // Bitmask for fine-grained perms

  createdAt DateTime @default(now())

  @@unique([storeId, userId])
  @@index([storeId])
}

// Pending invitations to join a store's team. Accepting one creates a
// StoreMembers row for the invited user (matched by email).

model StoreInvitation {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email String // who was invited (need not have an account yet)
  role  String @default("VIEWER") // ADMIN, MANAGER, EDITOR, VIEWER

  token  String @unique // random, carried in the accept link
  status String @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  invitedById String // User.id of the inviter
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([storeId, email]) // one live invite per email per store
  @@index([storeId])
  @@index([token])
}

// ============================================================================
// E-COMMERCE: PRODUCTS
// ============================================================================

// A product in the business's catalogue (#510, ADR-010). Storefronts sell it
// through a ProductListing and count it in StockLevel.
model Product {
  id             String       @id @default(cuid())
  // The storefront it was first made at, from when a product belonged to
  // one. Kept for the readers that still scope by it until #531; a store
  // going never takes a catalogue product with it. Dropped in a later deploy.
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String? @db.Text
  // The cover, mirrored from the first ProductImage so lists, orders and
  // imports keep reading one string. Written only through the photo set.
  image       String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  price    Decimal  @db.Decimal(10, 2)
  // The printed / compare-at price, shown struck through. At or above price.
  mrp      Decimal? @db.Decimal(10, 2)
  currency String   @default("USD")

  status     String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  // When it was last archived (#485); null unless status is ARCHIVED.
  archivedAt DateTime?

  // Details (products v2). Each customer-facing one has a switch in
  // shopFields: { howToUse, materials, keyPoints, maker, warranty, returns }.
  howToUse     String?
  materials    String?  @db.Text
  keyPoints    String[] @default([])
  madeHere     Boolean  @default(true)
  maker        String?
  madeIn       String?
  supplierCode String? // team only, never on the shop
  warranty     String?
  returnsMode  String   @default("STOREFRONT") // STOREFRONT | OWN
  returnsText  String?
  shopFields   Json     @default("{}")

  // GST (ADR-008, U5): the rate the price includes and the HSN code, printed
  // on a registered business's tax invoice. Null rate: not set (0% on paper).
  gstRate Decimal? @db.Decimal(5, 2)
  hsnCode String?

  // SEO — stored and edited; the website renders them later (#473).
  seoTitle       String?
  seoDescription String?
  seoImageId     String?
  seoImage       ProductImage? @relation("ProductSeoImage", fields: [seoImageId], references: [id], onDelete: SetNull)

  // Track stock (#515). Off: it always sells and nothing counts it — its
  // StockLevel rows stay (at 0, for the log) but hold nothing. Turned off
  // only while nothing is promised, with a counted-to-0 entry per shelf that
  // had stock; turned on at 0. A line placed while off stays untracked for
  // life. Counts only while the business tracks stock too
  // (BusinessProfile.stockTracking). stockTrackedAt: when it last started
  // counting, so a sale made before then isn't a missed one.
  stockTracked   Boolean   @default(false)
  stockTrackedAt DateTime?

  // The one store option its variants are chosen by ("Customers choose by").
  optionId String?
  option   ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  // Relations
  variants   ProductVariant[]
  orderItems OrderItem[]
  // The stock as it was counted before StockLevel (#510). No longer
  // written; kept until a later deploy drops it.
  inventory  Inventory?
  images     ProductImage[]   @relation("ProductImages")

  // Where it is sold, and its shelf at each storefront (#510).
  listings        ProductListing[]
  listingVariants ProductListingVariant[]
  stockLevels     StockLevel[]
  stockEntries    StockEntry[]

  // The hand-picked collections it is in (#516). Kept while it is archived.
  collections CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discountReach DiscountProduct[]

  reviews ProductReview[]

  fieldValues ProductFieldValue[]
  allergens   ProductAllergen[]

  // How it can be fulfilled (B12, DEC-045): PICKUP, LOCAL_DELIVERY, SHIPPING
  // or DIGITAL (never an appointment type). Empty: every way its storefronts offer
  // (StoreSettings.fulfilmentTypes). An order offers only the types every
  // item allows; read it through `productTypesOf` in orders/fulfilment.ts.
  fulfilmentTypes OrderFulfilment[] @default([])

  // A product's address is unique in its business (#510).
  @@unique([organizationId, slug])
  // The target of (productId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([storeId])
  @@index([categoryId])
  @@index([organizationId])
  @@index([optionId])
  @@index([seoImageId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku   String
  title String // e.g., "Red / Large"

  price Decimal? @db.Decimal(10, 2) // null = the product's
  mrp   Decimal? @db.Decimal(10, 2) // null = the product's
  image String?

  // Its value of the product's option; deleting a value in use is refused.
  optionValueId String?
  optionValue   ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  // The product photo shown when someone picks it; null = the cover.
  imageId       String?
  photo         ProductImage?       @relation("VariantPhoto", fields: [imageId], references: [id], onDelete: SetNull)
  position      Int                 @default(0)

  // No longer written (#510); StockLevel counts per storefront.
  inventory  VariantInventory?
  orderItems OrderItem[]

  // The storefronts that sell it, and its shelf at each (#510).
  listings     ProductListingVariant[]
  stockLevels  StockLevel[]
  stockEntries StockEntry[]

  createdAt DateTime @default(now())

  @@unique([productId, sku])
  // The target of (variantId, productId) foreign keys: a row naming a
  // variant names that variant's own product.
  @@unique([id, productId])
  @@index([optionValueId])
  @@index([imageId])
}

// A product's photos, in the order customers see them; position 0 is the
// cover. At most five (enforced by the API). Taking one off deletes this row,
// never the Media object behind it.
model ProductImage {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  url      String
  mediaId  String?
  media    Media?  @relation("ProductImageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  alt      String  @default("")
  width    Int?
  height   Int?
  position Int

  // "photo" or "video" (#517). A video always comes from an uploaded MP4 or
  // MOV (mediaId); its poster is an image from the library, never a free URL.
  // posterUrl mirrors the poster's address the way url mirrors the media's.
  kind          String  @default("photo")
  durationSec   Int?
  posterMediaId String?
  poster        Media?  @relation("ProductImagePoster", fields: [posterMediaId], references: [id], onDelete: SetNull)
  posterUrl     String?

  // Photographer credit, for images from a licensed library (e.g. Unsplash).
  creditName String?
  creditUrl  String?

  createdAt DateTime @default(now())

  variants    ProductVariant[] @relation("VariantPhoto")
  seoProducts Product[]        @relation("ProductSeoImage")

  @@index([productId, position])
  @@index([organizationId])
}

// The business's variant option names ("Size", "Shade") and their values.
model ProductOption {
  id             String       @id @default(cuid())
  // The storefront it was first made at, from when settings were kept per
  // storefront. The business owns it (#529); nothing reads this, and it is
  // dropped in a later deploy.
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)

  values   ProductOptionValue[]
  products Product[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@index([storeId])
}

model ProductOptionValue {
  id             String        @id @default(cuid())
  optionId       String
  option         ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  value    String
  position Int    @default(0)

  variants ProductVariant[]

  @@unique([optionId, value])
  @@index([organizationId])
}

// What a new product starts with. key "all" is All products; otherwise the
// key is the category's id and a null field falls through to "all".
model CatalogueDefaults {
  id             String       @id @default(cuid())
  // The storefront it was first made at, from when settings were kept per
  // storefront. The business owns it (#529); nothing reads this, and it is
  // dropped in a later deploy.
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key        String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  howToUse      String?
  lowStockAlert Int?
  returnsMode   String? // STOREFRONT | OWN
  returnsText   String?

  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([storeId])
}

/// A thing a product records beyond the standard details (#482) — "Keeps
/// for", "Skin type" — asked of the products in the categories it names.
/// Team only unless `onShop`. Deleting one keeps its values for 30 days.
model ProductField {
  id             String       @id @default(cuid())
  // The storefront it was first made at, from when settings were kept per
  // storefront. The business owns it (#529); nothing reads this, and it is
  // dropped in a later deploy.
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  type      String    @default("TEXT") // TEXT | NUMBER | DATE | YES_NO
  onShop    Boolean   @default(false)
  position  Int       @default(0)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  categories ProductFieldCategory[]
  values     ProductFieldValue[]

  @@index([storeId])
  @@index([organizationId])
}

model ProductFieldCategory {
  id         String       @id @default(cuid())
  fieldId    String
  field      ProductField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([fieldId, categoryId])
  @@index([categoryId])
}

model ProductFieldValue {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldId        String
  field          ProductField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  value String

  updatedAt DateTime @updatedAt

  @@unique([productId, fieldId])
  @@index([fieldId])
  @@index([organizationId])
}

/// The business's allergen list (#483, #529) — what the editor offers under
/// "Contains" and "May contain". A new business starts with none.
model StoreAllergen {
  id             String       @id @default(cuid())
  // The storefront it was first made at, from when settings were kept per
  // storefront. The business owns it (#529); nothing reads this, and it is
  // dropped in a later deploy.
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)

  createdAt DateTime @default(now())

  products     ProductAllergen[]
  // Customers' notes that named it (U8). Unused since Z2a: dropped with Z2.
  contactNotes ContactNoteAllergen[]

  // Needs attention Allergy entries that name it (C1). Removing it is
  // refused while an entry that is still on a record does.
  contactAttention ContactAttention[]

  @@index([storeId])
  @@index([organizationId])
}

model ProductAllergen {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergenId     String
  // NoAction, not deferrable: it fails a same-statement cascade just as
  // Restrict would, so deleting a storefront in one statement is refused
  // while its products list allergens. Remove ProductAllergen rows (or the
  // products, which cascade them) before StoreAllergen, in one transaction —
  // as the seed's deleteSeeded removes products before their store. Removing
  // an allergen a product lists is refused in the API with the count.
  allergen       StoreAllergen @relation(fields: [allergenId], references: [id], onDelete: NoAction)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind String // CONTAINS | MAY_CONTAIN

  @@unique([productId, allergenId])
  @@index([allergenId])
  @@index([organizationId])
}

// The business's product categories (#529): one list, whatever storefront
// sells the product. Slugs are unique per business.
model Category {
  id             String       @id @default(cuid())
  // The storefront it was first made at; nothing reads it (see ProductOption).
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())

  discountReach DiscountCategory[]
  defaults      CatalogueDefaults[]
  fields        ProductFieldCategory[]
  // Automatic collections that fill themselves from it (#516).
  collections   Collection[]

  @@unique([organizationId, slug])
  // The target of (categoryId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([storeId])
}

/// A collection (#516): hand-picked (its products are stored, in order) or
/// automatic by category (its products are read from the category when
/// asked, never stored) — never both. Archived products don't show in
/// either; a hand-picked membership is kept, so "Sell again" restores it.
model Collection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?

  // Set: automatic — every product in this category that isn't archived.
  // Null: hand-picked. A category an automatic collection uses can't be
  // deleted: the categories service says which collection, and the key
  // refuses it too. NoAction, not Restrict, so deleting the business —
  // which takes both — still works (checked at the end of the statement).
  categoryId String?
  category   Category? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: NoAction)

  products CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  // The target of (collectionId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([categoryId])
}

/// A product hand-picked into a collection, at a position (#516).
model CollectionProduct {
  collectionId   String
  collection     Collection   @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  position Int

  createdAt DateTime @default(now())

  @@id([collectionId, productId])
  // A hand-picked collection's products, in order.
  @@index([collectionId, position])
  @@index([productId])
  @@index([organizationId])
}

// Inventory tracking

model Inventory {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity      Int @default(0)
  reserved      Int @default(0) // In pending orders
  lowStockAlert Int @default(10)

  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([organizationId])
}

// Stock for one variant. A product with variants counts here, one row per
// variant; its total is the sum. Orders reserve and commit against the
// variant their line names.
model VariantInventory {
  id             String         @id @default(cuid())
  variantId      String         @unique
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId      String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quantity      Int @default(0)
  reserved      Int @default(0) // promised to open orders; only Orders moves it
  lowStockAlert Int @default(10)

  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([organizationId])
}

// A storefront selling a product from the business's catalogue (#510,
// ADR-010). A product with variants sells only the variants listed in
// ProductListingVariant; a new variant is listed wherever its product is.
// Unlisting keeps the storefront's StockLevel rows and their stock.
model ProductListing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store   @relation(fields: [storeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Marked Sold out by hand at this storefront (#515). Only an untracked
  // product carries it: it refuses new shop and staff orders here until it
  // is marked available again. Turning tracking on clears it.
  soldOutAt       DateTime?
  soldOutByUserId String?

  variants ProductListingVariant[]

  @@unique([storeId, productId])
  // The target of (listingId, productId) foreign keys.
  @@unique([id, productId])
  @@index([productId])
  @@index([organizationId])
}

// A variant a storefront sells. A variant with no row at a storefront that
// lists its product is "Not sold here".
model ProductListingVariant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  listingId String
  productId String
  listing   ProductListing @relation(fields: [listingId, productId], references: [id, productId], onDelete: Cascade)
  product   Product        @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  @@unique([listingId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([organizationId])
}

// One storefront's shelf of one product (variantId null: the product counts
// as a whole) or of one variant (#510). A product counts stock at a
// storefront while it has a row there. `promised` belongs to Orders: the
// sum of open lines' heldQuantity on this row. Written only under a row
// lock, found and created rather than upserted (the uniques are partial).
model StockLevel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store           @relation(fields: [storeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  onHand        Int @default(0)
  promised      Int @default(0)
  lowStockAlert Int @default(10)

  updatedAt DateTime @updatedAt

  orderItems       OrderItem[]
  entries          StockEntry[]
  checkResolutions StockCheckResolution[]

  @@unique([id, organizationId])
  @@unique([storeId, productId], map: "StockLevel_storeId_productId_whole_key", where: raw("\"variantId\" IS NULL"))
  @@unique([storeId, variantId], map: "StockLevel_storeId_variantId_key", where: raw("\"variantId\" IS NOT NULL"))
  @@index([productId])
  @@index([variantId])
  @@index([organizationId])
  // Rows promising anything, for the held-stock check (#511).
  @@index([organizationId], map: "StockLevel_promising_idx", where: raw("promised <> 0"))
}

// The stock log (#513): one entry for every change to what is on a shelf —
// never a promise — so a row's entries add up to its on hand, and each entry
// reads before + quantity = after. Entries are never edited or deleted; Undo
// writes a REVERSED entry pointing at the one it undoes. A move is two
// entries (−N here, +N there) sharing a pairId. A count keeps what the
// counter was shown (expected) and what they counted; the shelf had moved
// meanwhile when expected differs from before ("Count didn't match").
// Store, product and variant repeat the row's, for filtering the log.
enum StockEntryKind {
  SOLD
  RETURNED
  BAKED
  RECEIVED
  WASTED
  COUNTED
  MOVED
  REVERSED
}

model StockEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stockLevelId String
  stockLevel   StockLevel      @relation(fields: [stockLevelId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storeId      String
  store        Store           @relation(fields: [storeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  kind     StockEntryKind
  // Signed change to on hand.
  quantity Int
  before   Int
  after    Int

  // COUNTED only: what the counter was shown, and what they counted.
  expected Int?
  counted  Int?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // The two sides of a move, or of undoing one.
  pairId  String?

  // On a REVERSED entry: the entry it undoes. Unique, so nothing is undone twice.
  reversesId String?     @unique
  reverses   StockEntry? @relation("StockEntryReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy StockEntry? @relation("StockEntryReversal")

  // Who made the change. Not a foreign key, like OrderEvent: someone who
  // leaves the team keeps their entries. Null for the system.
  actorUserId String?
  note        String?
  // Why Saroh wrote this entry, not a person or an order: TRACKING_OFF
  // (Track stock turned off counted the shelf to 0), PER_VARIANT (the switch
  // to counting each variant) or VARIANT_REMOVED (a removed variant's stock
  // taken back to the product). Null for everything else. An entry Saroh
  // wrote is never undone through the stock log.
  system      String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([stockLevelId, createdAt])
  @@index([storeId, createdAt])
  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([pairId])
}

// ============================================================================
// E-COMMERCE: CUSTOMERS & CARTS
// ============================================================================

// Customers are store-specific
// Email is unique PER STORE, not globally

model Customer {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  email     String // NOT globally unique, unique per store
  firstName String?
  lastName  String?
  phone     String?

  // Address info
  country String?
  state   String?
  city    String?
  zipCode String?

  orders Order[]
  carts  Cart[]

  // Explicit links to CRM Contact records (#120).
  identityLinks CustomerIdentityLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productReviews ProductReview[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([organizationId])
}

model Cart {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Items stored as JSON for flexibility
  items Json @default("[]") // [{ productId, variantId, quantity, price }]

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, customerId])
  @@index([storeId])
  @@index([organizationId])
}

// ============================================================================
// E-COMMERCE: ORDERS
// ============================================================================

// A stock check someone has looked at and resolved (#514). The checks
// themselves are computed when read (GET organizations/:org/stock/checks):
// a shelf short of what is promised, a count that didn't match the log, a
// sale not taken from stock, and promised not adding up to what open order
// lines hold. `key` names one check ("short:<stockLevelId>", …);
// `fingerprint` is what it read when it was resolved, so a check whose
// numbers move on opens again. Never deleted by the app.
enum StockCheckKind {
  SHORT
  COUNT_MISMATCH
  SALE_NOT_TAKEN
  PROMISED_MISMATCH
}

model StockCheckResolution {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String
  kind        StockCheckKind
  fingerprint String

  // The shelf the check is about, when it is about one.
  stockLevelId String?
  stockLevel   StockLevel? @relation(fields: [stockLevelId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Who resolved it. Not a foreign key, like StockEntry.actorUserId.
  resolvedByUserId String?
  note             String?
  resolvedAt       DateTime @default(now())

  @@unique([organizationId, key])
  @@index([stockLevelId])
}

model Order {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  orderId    String // Store-specific order number (ORD-001, etc)
  // Null only for a walk-in (plan B, B13): someone served at the counter who
  // left no email, so no storefront customer and no contact is made. Their
  // name (and phone, if given) stays on the order as `walkInName` and
  // `walkInPhone`. Every other order names its storefront customer.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Pricing
  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  shipping Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  currency String @default("USD")

  // Status
  status         String  @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus  String  @default("UNPAID") // UNPAID, PAID, FAILED, REFUNDED
  // Money taken outside Saroh and recorded on the order: cash, UPI or a
  // card machine at the counter, a payment marked by hand, a difference
  // after an edit recorded as paid — less what an edit handed back from the
  // till. With the order's SUCCEEDED payments, what it has been paid
  // (`orders/hand-payments.ts`). 0 on an order paid by hand before it was
  // kept: such an order counts its total, as it did.
  paidByHand     Decimal @default(0) @db.Decimal(12, 2)
  // Money handed back outside Saroh and recorded on the order ("Record as
  // refunded", #865, DEC-116): every amount recorded, in full or in part.
  // What is left to refund is what it was paid less every refund, these
  // included (`orders/hand-refund.ts`). 0 on an order recorded refunded
  // before it was kept: that order reads REFUNDED, so nothing is left.
  refundedByHand Decimal @default(0) @db.Decimal(12, 2)

  // Relations
  items        OrderItem[]
  transactions Transaction[]

  // Org-owned payment intents against this order (Stage 5 — S5-002).
  paymentIntents PaymentIntent[]

  // The kitchen flow (ADR-008, U6). The stage sits UNDER `status`: each
  // stage move maps to a status move (order-stage.ts), and every move is an
  // OrderEvent. Existing orders were backfilled from their status.
  stage      OrderStage      @default(NEW)
  fulfilment OrderFulfilment @default(PICKUP)

  // Where a local delivery or a shipment goes. `deliveryState` is also the place of
  // supply for GST when no bill-to state is set (U5).
  deliveryName       String?
  deliveryPhone      String?
  deliveryLine1      String?
  deliveryLine2      String?
  deliveryCity       String?
  deliveryState      String?
  deliveryPostalCode String?

  // What the counter needs to know ("no sesame", "ring the bell").
  notes       String?
  // A typed courier tracking link — no courier integration (ADR-008).
  trackingUrl String?

  events       OrderEvent[]
  stockEntries StockEntry[]

  // Its invoice, and the credit notes and supplementary invoices that
  // correct it (ADR-008, U5). The order stays the ledger.
  invoices Invoice[]

  // The QR code whose scan opened the page this order was placed from
  // (`QrCode.id`), when the page's address still carried the scan's tag.
  // Null for every other order.
  sourceCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discountRedemption DiscountRedemption?

  reviewInvitation ReviewInvitation?

  // An order a customer started at the site's checkout (G13). Until it is
  // paid it is an abandoned checkout, not an order: the Orders list and its
  // counts leave out every `placedOnline` order still UNPAID (plan B, B1).
  // False for every order taken by staff and for every order before G13.
  placedOnline Boolean   @default(false)
  // When the money for the order arrived (G13 sets it on payment). Null
  // until then, and for every order before G13.
  paidAt       DateTime?

  // Who took it and its number, typed by staff when the order is handed to
  // a courier, or added after (plan B, B2b; DEC-045). Saroh never books a
  // courier. Trimmed, at most 80 characters; `trackingUrl` stays the
  // optional link.
  courierName    String?
  trackingNumber String?

  // An order's pay link (plan B, B11), as ADR-007's invoice pay link: only
  // the SHA-256 of its token is kept, so no one can read the link back, and
  // `order:read` sees only when it was made. Both are cleared when the order
  // is paid online, cancelled or refunded.
  payTokenHash     String?   @unique
  payLinkCreatedAt DateTime?

  // A treatment's visits (E9, DEC-050): one booking per visit.
  bookings    Booking[]
  // The key the site's checkout sheet sent when it started this order (G13):
  // a double tap or a retry with the same key finds this order and its
  // intent instead of making a second. Null on every order not started at a
  // site's checkout.
  checkoutKey String?

  // The customer's site account when they placed it signed in: at the
  // site's checkout (G13), or a treatment booked signed in (E9, A9). The
  // account's Orders read it beside the contact's identity links, so an
  // order it placed shows even when its store customer stands for someone
  // else; "This isn't them" (A4) moves what it made (round 2, A7). A
  // single-column key, as Booking's: RLS keeps it in the business.
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  // A walk-in's name, and their phone if they gave one, for "call when it's
  // ready" (plan B, B13). Set only when `customerId` is null; kept like any
  // order's contact details (DEC-042). No contact is made from them, because
  // a contact needs an email.
  walkInName  String?
  walkInPhone String?

  // The number the order had before the P3 backfill (DEC-066) renumbered it:
  // two storefronts of one business had each counted from ORD-001, so the
  // later of two orders with one number took the business's next one. Kept
  // so a customer quoting the old number still finds it (search, the Orders
  // list). Null for every order never renumbered.
  renumberedFrom String?

  // Placed at the site's checkout to be paid when it is handed over: "Pay
  // when you collect" or "Pay on delivery" (2026-10-06). Such an order is a
  // real order from the moment it is made, as a staff pay-later order is: it
  // promises its units at once, shows in Orders as not paid yet, never
  // closes as an abandoned checkout, and is marked paid by staff. False for
  // every other order, and every order before it.
  payOnHandover Boolean @default(false)

  @@unique([storeId, orderId])
  @@unique([storeId, checkoutKey])
  @@index([storeId])
  @@index([customerId])
  @@index([organizationId])
  // The calendar's Orders layer and Home's week read a business's orders
  // by when they were placed (round 2, E20).
  @@index([organizationId, createdAt])
  // What an account ordered, newest first (A7).
  @@index([customerAccountId, createdAt])
  // The QR list's Orders count: the few orders that name a code.
  @@index([sourceCode], map: "Order_sourceCode_idx", where: raw("\"sourceCode\" IS NOT NULL"))
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // What the line bills: a product, or a service (a treatment, E9,
  // DEC-050). Exactly one is set, CHECKed (`OrderItem_bills_one_thing`). A
  // service line holds no stock (`stockRow` NONE), has no variant and a
  // quantity of 1, and takes its GST from the service.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  // The variant bought. Null on lines from before per-variant stock, and on
  // products without variants; those move the product's own stock.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  // Where this line's reservation sits, set when the order first holds
  // stock; every later release or fulfil settles on the same row. NONE: the
  // product counted no stock, so nothing was held. Null only on lines from
  // before this was recorded (open ones were backfilled).
  stockRow StockRow?

  // The storefront shelf row the line's stock sits on (#510), set with
  // stockRow and kept after the line is fulfilled, and how many units the
  // line holds on it right now. Null with stockRow NONE, for life.
  stockLevelId String?
  stockLevel   StockLevel? @relation(fields: [stockLevelId], references: [id], onDelete: SetNull)
  heldQuantity Int         @default(0)
  // How many units the line took off that shelf when it was fulfilled
  // (#511): a kitchen undo holds them again, and a return puts back at most
  // this many less what was already put back.
  soldQuantity Int         @default(0)

  review ProductReview?

  // What has been refunded of this line (U6): caps the next line refund.
  refundLines PaymentRefundLine[]

  // The invoice lines that bill it (U5): a line refund credits these.
  invoiceLines InvoiceLine[]

  // The service a treatment's line bills (E9, DEC-050). Restrict: services
  // are soft-deleted, so the row stays and the order keeps its line.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@index([stockLevelId])
  @@index([serviceId])
  // Lines holding stock, for the held-stock check (#511): few of all lines.
  @@index([stockLevelId], map: "OrderItem_holding_idx", where: raw("\"heldQuantity\" <> 0"))
}

enum StockRow {
  PRODUCT
  VARIANT
  NONE
}

// The kitchen stage (ADR-008). Each fulfilment type walks its own steps
// (DEC-045; the table is apps/api.saroh.in/src/modules/orders/fulfilment.ts):
// NEW → PREPARING → READY → COLLECTED for a pick-up, READY →
// OUT_FOR_DELIVERY → DELIVERED for a local delivery, READY →
// HANDED_TO_COURIER → DELIVERED for shipping, NEW → SENT for a download.
// OUT_FOR_DELIVERY and SENT arrive in release 1 of the expand/contract
// (docs/architecture/ORDER_FULFILMENT_ROLLOUT.md) and are written from
// release 2 on.
enum OrderStage {
  NEW
  PREPARING
  READY
  COLLECTED
  HANDED_TO_COURIER
  DELIVERED
  OUT_FOR_DELIVERY
  SENT
}

// How an order leaves (DEC-045). The six types came in by expand and
// contract (docs/architecture/ORDER_FULFILMENT_ROLLOUT.md): release 1 (B2a)
// added them beside the legacy COLLECT and DELIVERY, release 2 (B2c)
// switched every row and write to them (20261011160000), and release 3
// (B2d, 20261013100000) dropped the legacy two. Read it through `typeOf` in
// orders/fulfilment.ts, never raw.
enum OrderFulfilment {
  PICKUP
  LOCAL_DELIVERY
  SHIPPING
  DIGITAL
  APPOINTMENT_IN_PERSON
  APPOINTMENT_ONLINE
}

enum OrderEventKind {
  // A kitchen stage move (and the status move it maps to).
  STAGE
  // The Undo of the last STAGE step; `undoesEventId` names it.
  UNDO
  // A status change made outside the kitchen flow (cancel, the legacy PATCH).
  STATUS
  // Items, address, fulfilment or notes changed before preparing.
  EDIT
  // A refund asked for, by line or in full.
  REFUND
}

// One step on an order's timeline (ADR-008, U6): who, when, from → to. Undo
// reverts only the latest step, within a server-side limit, and marks it
// `undoneAt`. Org-owned, RLS org_isolation.
model OrderEvent {
  id             String @id @default(cuid())
  organizationId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind OrderEventKind

  // Who took the step. Not a foreign key: someone who leaves the team keeps
  // their steps on the timeline. Null for the system (a webhook).
  actorUserId String?

  fromStage  OrderStage?
  toStage    OrderStage?
  fromStatus String?
  toStatus   String?
  note       String?

  // Money this step moved (a refund, an edit's difference), minor units.
  // Left out of every read by a role without a money permission.
  amountCents Int?

  // Set on a STAGE step when it is undone; on the UNDO step, which one.
  undoneAt      DateTime?
  undoesEventId String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([organizationId])
}

// ============================================================================
// PAYMENTS & TRANSACTIONS
// ============================================================================

enum PaymentProvider {
  STRIPE
  RAZORPAY
  CASHFREE
  DODO
}

model StorePaymentConfig {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  provider PaymentProvider

  // Encrypted secrets stored here
  secretKeyEncrypted String
  publicKeyEncrypted String?

  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // Default payment method

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model Transaction {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Provider reference
  provider              PaymentProvider
  providerTransactionId String

  // Amount
  amount   Decimal @db.Decimal(12, 2)
  currency String

  // Status
  status       String // SUCCESS, FAILED, PENDING, REFUNDED
  errorMessage String?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  refund    Refund?

  @@unique([provider, providerTransactionId])
  @@index([storeId])
  @@index([orderId])
}

model Refund {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  reason String

  status String @default("PENDING") // PENDING, COMPLETED, FAILED

  createdAt DateTime @default(now())
}

// ============================================================================
// BLOGS
// ============================================================================

// A post belongs to the SITE it is published on (ADR-004, #209).
//
// It used to belong to a Store, which meant a business with a website and no
// shop could not write at all — writing is not a commerce capability. It is not
// owned by the Organization either (the answer #164 gave for Sales): a post is
// published to an audience AT AN ADDRESS, so "which site does this appear on"
// is the ownership question, and answering it with the owner leaves nothing to
// a second column.
model Post {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  title   String
  slug    String
  excerpt String?
  content String  @db.Text // Markdown or HTML

  // Who wrote it. Was a StoreMembers row, which carried an oddity: a store
  // owner is not a member, so owner-written posts had no author at all. Under
  // site ownership that indirection buys nothing.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id])

  featured Boolean @default(false)
  image    String?

  // The DRAFT-side state the merchant sees. `status` is what they set;
  // `publishedAt` is stamped the first time it goes PUBLISHED and kept after.
  // Neither is what the public reads — that is the pointer below.
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt DateTime?

  // The publication the public is being served for this post, or null when it
  // is not live (ADR-004 §3, #232). Mirrors Site.currentPublicationId exactly:
  // publishing appends an immutable Publication and repoints this; taking a
  // post down is repointing to null, which keeps the history. Per POST, so
  // publishing one does not republish the site's pages and restoring an old
  // site publication does not unpublish this week's writing.
  currentPublicationId String?       @unique
  currentPublication   Publication?  @relation("PostCurrentPublication", fields: [currentPublicationId], references: [id], onDelete: SetNull)
  publications         Publication[] @relation("PostPublications")

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([authorId])
}

/**
 * A flat list of categories per SITE (ADR-004), no hierarchy.
 */
model PostCategory {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name String
  slug String

  posts Post[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentHierarchy", fields: [parentId], references: [id])
  children Comment[] @relation("CommentHierarchy")

  authorName  String
  authorEmail String
  content     String

  approved Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([postId])
}

// ============================================================================
// INTEGRATIONS & SECRETS
// ============================================================================

model IntegrationSecret {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  key            String // STRIPE_SK, RAZORPAY_KEY, GMAIL_OAUTH, etc
  valueEncrypted String // Encrypted with SECRETS_MASTER_KEY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([storeId])
}

// ============================================================================
// STORE SETTINGS & FEATURES
// ============================================================================

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // General
  language String @default("en")
  timezone String @default("UTC")
  currency String @default("USD")

  // Taxes
  taxEnabled Boolean @default(false)
  taxRate    Decimal @default(0) @db.Decimal(5, 2)

  // Shipping
  shippingEnabled       Boolean  @default(true)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)

  // What kind of place this is (Sell → Storefronts). A SHOP is somewhere a
  // customer can walk into, so it has an address, hours and collection; an
  // ONLINE store has none of them.
  kind              String    @default("ONLINE") // SHOP | ONLINE
  address           String?   @db.Text
  // Seven entries, Monday first: { day, open: "09:00", close: "18:00", closed }
  openingHours      Json?
  collectionEnabled Boolean   @default(false)
  tipsEnabled       Boolean   @default(false)
  guestCheckout     Boolean   @default(true)
  // Paused: customers cannot pay; everything is kept.
  pausedAt          DateTime?
  // Which of the business's connected providers this storefront's checkout
  // uses (MerchantPaymentProvider.provider). Null: the business's only one.
  checkoutProvider  String?

  // Theme
  theme        String  @default("light") // light, dark, custom
  primaryColor String?

  // Products (#484). Moved to the business (BusinessProfile, #529) and no
  // longer read; dropped in a later deploy.
  skuPattern String?
  skuSuggest Boolean @default(true)

  updatedAt DateTime @updatedAt

  // The physical ways this storefront's orders leave (DEC-045): only
  // PICKUP, LOCAL_DELIVERY and SHIPPING are ever stored here; Digital and the
  // appointment types follow the product. Set by B17's chips, which keep
  // `collectionEnabled` (Pick-up) and `shippingEnabled` (any delivery) in
  // step; a save of either toggle from an older app still updates it.
  fulfilmentTypes OrderFulfilment[] @default([])

  // When this storefront's open orders count as late, in minutes from when
  // each was placed, per way it offers (B17; default 16, DEC-045). Bounds
  // (5 minutes to 30 days) are the API's. Never stored on an order: a change
  // re-labels open orders on the next read.
  pickupLateAfterMinutes        Int       @default(120)
  localDeliveryLateAfterMinutes Int       @default(1440)
  shippingLateAfterMinutes      Int       @default(2880)
  // When the one-time "Pick-up orders now count as late after 2 hours"
  // notice on Orders was dismissed for this storefront (B17).
  lateRuleNoticeDismissedAt     DateTime?

  // The shop's delivery fee (G13): a flat amount added to an order's
  // `shipping` when the site's checkout picks Local delivery or Shipping.
  // Null is free. B9 prefills a change of fulfilment from it.
  localDeliveryFee Decimal? @db.Decimal(10, 2)
  shippingFee      Decimal? @db.Decimal(10, 2)

  // Customers who share an email (DEC-055, C15). Set: from this moment on,
  // a customer of this storefront who pays with an email that a contact
  // made from another store customer already holds is linked to that
  // contact on their own (`customer-workspace/same-email-link.ts`). Null
  // leaves the pair for staff: the default, and every existing
  // storefront's. Store customers from before it was set stay as they
  // are, so turning it on never re-links a pair that already existed.
  linkSameEmailSince DateTime?

  // "Pay when you collect" and "Pay on delivery" at the site's checkout
  // (2026-10-06, the owner's rule: online needs a paid plan, Free takes money
  // offline). On a plan without online payments the checkout always offers
  // them — it is the only way to pay there — so this is read only where the
  // plan takes money online: on, the checkout shows them beside paying
  // online; off (the default, and every existing storefront's), online only.
  offerPayOnHandover Boolean @default(false)
}

model StoreFeatures {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  ecommerceEnabled    Boolean @default(true)
  blogsEnabled        Boolean @default(false)
  customDomainEnabled Boolean @default(false)
  apiAccessEnabled    Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model CustomDomain {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  domain            String    @unique
  verified          Boolean   @default(false)
  verificationToken String?
  verifiedAt        DateTime?

  primary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([storeId])
}

model StoreApiKey {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name   String
  key    String @unique
  secret String // Encrypted

  permissions Json @default("{}") // {"orders:read": true, "products:write": false}

  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("ApiKey")
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

model AuditLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId   String? // Who did it (null for system)
  action   String // PRODUCT_CREATED, ORDER_UPDATED, etc
  entity   String // Product, Order, etc
  entityId String? // ID of affected entity

  changes   Json? // Before/after values
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

model SecretAccessLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  action    String // SECRET_ACCESSED, SECRET_CREATED, etc
  secretKey String // STRIPE_SK, RAZORPAY_KEY, etc

  actorType String // system, user
  actorId   String?

  status String // success, failed
  reason String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
}

// Organization-level immutable audit-event stream (S1-009).
//
// Distinct from the store-scoped `AuditLog` above: this records sensitive
// ACTIONS taken against an Organization tenant (membership changes, Team /
// Project access, profile edits, security-sensitive operations). It is
// append-only BY CONVENTION — application code only ever calls
// `prisma.auditEvent.create`; there is no update/delete path (see AuditService).
//
// DELIBERATELY NO RELATIONS. The compliance value of an audit trail is that it
// outlives the things it describes: an event must survive the deletion of its
// Organization, actor User, or Project. Foreign keys with cascade (or even a
// restrict) would either destroy history or block deletions, so actor /
// organization / project are stored as bare id strings, not relations.
model AuditEvent {
  id String @id @default(cuid())

  action         String // e.g. "membership.invite", "organization.onboard", "secret.access"
  actorUserId    String // Who performed the action (the authenticated actor)
  organizationId String // Tenant the action belongs to
  projectId      String? // Optional Project scope (Projects arrive in a later ticket)

  targetType String? // Kind of entity acted upon, e.g. "membership", "profile"
  targetId   String? // Id of that entity, when applicable

  outcome  String // "SUCCESS" | "FAILURE" | "DENIED"
  metadata Json? // Redacted, non-sensitive context (never secrets/PII)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================================
// FEATURE FLAGS (S1-012)
// ============================================================================

// Server-side feature flags. Evaluation is server-only (never trust the
// client for flag state). A flag has a global default (FeatureFlag) which can
// be overridden per Organization (FeatureFlagOverride). Every write is
// recorded immutably in FeatureFlagAudit. `key` is drawn from the typed
// registry in src/modules/feature-flags/flags.ts (e.g. ORG_AUTHORIZATION).

model FeatureFlag {
  id String @id @default(cuid())

  key         String  @unique // matches FlagKey in code
  description String?

  enabledByDefault Boolean @default(false)

  overrides FeatureFlagOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-Organization override of a flag's global default.
model FeatureFlagOverride {
  id String @id @default(cuid())

  flagKey String
  flag    FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean

  updatedAt DateTime @updatedAt

  @@unique([flagKey, organizationId])
  @@index([organizationId])
}

// Immutable, append-only audit history of every flag/override write. A null
// organizationId denotes a change to the global default; otherwise it is the
// affected Organization. No updates or deletes are performed in code.
model FeatureFlagAudit {
  id String @id @default(cuid())

  flagKey        String
  organizationId String? // null => global default change

  previousValue Boolean? // null when the flag/override did not exist before
  newValue      Boolean

  actorUserId String

  // Why the operator made this change. Nullable only because rows written
  // before the admin surface existed have none; the admin API requires it.
  reason String?

  createdAt DateTime @default(now())

  @@index([flagKey])
  @@index([organizationId])
}

// PlatformAdmin: a Saroh STAFF grant — the control-plane identity behind
// admin.saroh.in (S1-012).
//
// Deliberately NOT a Membership role and NOT an Organization concept: every
// role in `organization-policy` is scoped to one tenant, whereas this is the
// opposite — the right to act across all of them. Keeping it in its own table
// means a tenant OWNER can never escalate into staff by editing their own org.
//
// Data rather than env config, because staff access must be grantable and
// revocable at runtime with a record of WHO granted it. `ADMIN_ALLOWLIST`
// survives only as the break-glass bootstrap that seeds the first admin (and
// recovers access if every grant is revoked by mistake).
//
// Revocation is a `revokedAt` stamp, never a delete: who held control-plane
// access, and when, is exactly the history an incident review needs.
model PlatformAdmin {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)

  roleAssignments PlatformAdminRoleAssignment[]
  accessSessions  AdminAccessSession[]

  grantedByUserId String?
  grantedBy       User?   @relation("PlatformAdminGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  grantedAt DateTime  @default(now())
  revokedAt DateTime? // null => currently active

  /// Why this person has staff access (e.g. "on-call platform engineer").
  note String?

  @@index([revokedAt])
}

// Short-lived, read-only staff access to one Organization support workspace.
// The session is never a tenant Membership and cannot authorize mutations.
model AdminAccessSession {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Null only for ADMIN_ALLOWLIST break-glass staff.
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)

  actorUserId String
  reason      String
  scope       String @default("READ_ONLY")

  idempotencyKey String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  revokedByUserId  String?
  revocationReason String?

  @@index([organizationId, expiresAt, revokedAt])
  @@index([actorUserId, expiresAt, revokedAt])
  @@index([platformAdminId, revokedAt])
}

// One fixed control-plane role held by a PlatformAdmin. Assignments are
// append-only lifecycle records: revocation stamps `revokedAt`; it never
// deletes the record. `role` is validated through the typed API registry and a
// database CHECK constraint.
model PlatformAdminRoleAssignment {
  id String @id @default(cuid())

  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  role String

  // Bare actor id by design. Historical staff assignments must survive if the
  // assigning User is later removed.
  assignedByUserId String?
  reason           String

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([platformAdminId, revokedAt, expiresAt])
  @@index([role, revokedAt])
}

// Global, append-only history of staff activity in the Saroh control plane.
// Deliberately relation-free: deleting a User, Organization, or target business
// record must never cascade into the platform audit trail.
model AdminAuditEvent {
  id String @id @default(cuid())

  actorUserId String
  permission  String
  action      String
  targetType  String

  targetId       String?
  organizationId String?
  reason         String?
  outcome        String
  correlationId  String?
  // Optional because read events are not commands. Mutation events always set
  // this key so retries become transactionally idempotent.
  idempotencyKey String? @unique

  // Redacted operational context only. The API rejects secret-bearing keys.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// An operator's note on one Organization, written in the admin console and
// read only there. Relation-free like AdminAuditEvent: a note is the platform's
// record about a business, not the business's own data, so it never cascades
// from a tenant delete and no tenant path reads it.
model AdminOrganizationNote {
  id String @id @default(cuid())

  organizationId String
  authorUserId   String
  body           String

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// A durable bulk operation run from the admin console: retry a set of failed
// jobs, replay a set of webhook deliveries. The operation and one row per
// target are written before anything executes, so a restart resumes from the
// items still PENDING and the record says what happened to each one.
model AdminOperation {
  id String @id @default(cuid())

  kind        String // "jobs.retry" | "webhooks.replay"
  status      String @default("PENDING") // PENDING | RUNNING | DONE | FAILED | CANCELLED (#907)
  actorUserId String
  reason      String

  idempotencyKey String @unique

  total     Int @default(0)
  succeeded Int @default(0)
  skipped   Int @default(0)
  failed    Int @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  items AdminOperationItem[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model AdminOperationItem {
  id String @id @default(cuid())

  operationId String
  operation   AdminOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  targetType String // "job" | "webhook_event"
  targetId   String

  status      String    @default("PENDING") // PENDING | DONE | SKIPPED | FAILED
  detail      String?
  processedAt DateTime?

  @@unique([operationId, targetId])
  @@index([operationId, status])
}

// ============================================================================
// PROJECTS, TEAMS & PROJECT-LEVEL ACCESS (S1-010)
// ============================================================================

// Project: an OPTIONAL grouping beneath an Organization (ADR-001). NEVER a
// tenant/ownership/billing root — always org-scoped. OWNER/ADMIN implicitly see
// every Project in their org; a MEMBER sees only Projects granted to them
// directly or via a Team.
model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  access ProjectAccess[]

  // Modules this Project has selected from its Organization's enabled set
  // (ADR-003 / #113). A Project can only ever reference an OrganizationModule of
  // its OWN Organization — enforced by the compound FK on ProjectModule.
  modules ProjectModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  // Compound-unique target so ProjectModule can carry a denormalized
  // organizationId and reference [organizationId, id] — making it structurally
  // impossible for a Project to select another Organization's module.
  @@unique([organizationId, id])
  @@index([organizationId])
}

// OrganizationModule: an Organization's installation of one capability module
// (ADR-003 / DEC-016). The Organization is the tenant and the module owner.
// `moduleKey` is a string (validated through the typed registry in the API
// layer) so new modules can ship without a schema migration. `status` is the
// persisted lifecycle — DISABLED | ENABLED | ARCHIVED (a DB CHECK constraint in
// the migration enforces the set). Operational readiness (SETUP_REQUIRED /
// ACTIVE / ATTENTION_REQUIRED) is DERIVED at read time and never stored.
model OrganizationModule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  moduleKey String
  status    String @default("DISABLED")

  enabledAt        DateTime?
  enabledByUserId  String?
  disabledAt       DateTime?
  disabledByUserId String?

  // Optional per-installation module configuration (opaque here; each module
  // owns its own shape). Distinct from feature flags and entitlements.
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectModule[]

  @@unique([organizationId, moduleKey])
  // Compound-unique target for ProjectModule's org-consistency FK (see below).
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// ProjectModule: a Project's selection of one of its Organization's enabled
// modules (ADR-003 / DEC-016). Organization enablement is authoritative — a
// Project can never select a module its Organization has not enabled.
//
// The denormalized `organizationId` is shared by BOTH compound foreign keys, so
// the database itself guarantees the Project and the OrganizationModule belong
// to the SAME Organization; a cross-Organization selection cannot be written
// even if application code is wrong. Do not rely on app code alone (plan §2).
model ProjectModule {
  id                   String @id @default(cuid())
  organizationId       String
  projectId            String
  organizationModuleId String

  project            Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  organizationModule OrganizationModule @relation(fields: [organizationId, organizationModuleId], references: [organizationId, id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, organizationModuleId])
  @@index([organizationId, projectId])
}

// CustomerIdentityLink: a user-confirmed link between a CRM Contact and a
// commerce Customer (#120). Saroh NEVER merges people automatically on weak
// evidence (e.g. similar names); an exact normalized email/phone only *suggests*
// a link — a person confirms it. The record is Organization-scoped, carries the
// actor for audit, and is reversible (deletable) without touching either
// underlying record. It links, it does not merge: Contact and Customer keep
// their own identity and domain ownership.
model CustomerIdentityLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // The team member who linked them, for a MANUAL link only. A link the
  // backfill, a payment or a site sign-in made has none (C2, DEC-041).
  linkedByUserId String?
  createdAt      DateTime @default(now())

  // Why the link exists (C2, DEC-041). Links from before C2 read MANUAL.
  reason CustomerLinkReason @default(MANUAL)

  @@unique([contactId, customerId])
  @@index([organizationId])
  // "Is this store customer linked?" (review C-2): the unlinked payers, the
  // payment path and the backfill all ask it by the customer.
  @@index([customerId])
}

/// Why a store customer is linked to a contact (C2, DEC-041).
enum CustomerLinkReason {
  // A team member linked them (#120); `linkedByUserId` says who.
  MANUAL
  // The backfill that gave every paying store customer a contact.
  BACKFILL
  // Their order was paid (`ensureContactForPaidOrder`).
  PAYMENT
  // They placed the order signed in on the business's site (A4, G13).
  SITE_ACCOUNT
  // They booked a treatment, which is sold as an order (E9, DEC-050).
  BOOKING
}

// ContactNote: what the team has written down about a person (U8, ADR-008).
// Free text, plus the allergens it names as ids from the storefront's own
// allergen list — structured, not typed, so an order's allergy banner matches
// a product's "Contains" / "May contain" exactly rather than by spelling.
// Rooted on the Contact (every business kind has one); deleted with it.
model ContactNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  body String @default("")

  allergens ContactNoteAllergen[]

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contactId, createdAt])
  @@index([organizationId])
}

// One allergen a note named. Nothing reads or writes it since Z2a (notes are
// text only; allergies are ContactAttention entries), and it is dropped with
// Z2. Removing an allergen clears any rows still naming it (NoAction).
model ContactNoteAllergen {
  noteId         String
  note           ContactNote   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  allergenId     String
  allergen       StoreAllergen @relation(fields: [allergenId], references: [id], onDelete: NoAction)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([noteId, allergenId])
  @@index([allergenId])
  @@index([organizationId])
}

// ContactAttention: one entry on a customer's Needs attention list (DEC-040,
// C1) — an allergy, a medical note, an access need or anything else the team
// must know before serving them. One list per person, read by Customer
// Detail, orders, bookings and Home through one helper (`attentionFor`),
// which leaves out sensitive entries for anyone without the sensitive
// permission.
//
// An Allergy entry names an allergen from the business's list when it has
// one (structured, so an order can be checked against a product's
// "Contains"); without a list it is free text in `label`. A booking-page note
// or the customer's own note arrives as SUGGESTED and becomes ACTIVE only
// when staff add it; "Nothing to add" and removal set `removedAt`. Rows are
// never deleted by the API, so who added what stays readable.
model ContactAttention {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  kind      AttentionKind
  // At most 60 characters (the API checks it): what the tag says.
  label     String
  // At most 500 characters.
  detail    String?
  // Left out of every read for a role without the sensitive permission.
  sensitive Boolean       @default(false)

  // NoAction, as ContactNoteAllergen: removing an allergen from the list is
  // refused while an entry still on a record names it.
  allergenId String?
  allergen   StoreAllergen? @relation(fields: [allergenId], references: [id], onDelete: NoAction)

  source    AttentionSource @default(STAFF)
  status    AttentionStatus @default(ACTIVE)
  // The booking whose note suggested it (C12). The entry outlives the booking.
  bookingId String?
  booking   Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Users, by id and without a foreign key, as ContactNote: a person who
  // leaves the team keeps their entries.
  createdByUserId   String?
  confirmedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  removedAt         DateTime?

  @@index([organizationId, contactId])
  @@index([organizationId, status])
  @@index([allergenId])
  @@index([bookingId])
}

enum AttentionKind {
  ALLERGY
  MEDICAL
  ACCESS
  OTHER
}

/// Who put an entry on the record: the team, the booking page's
/// "Anything we should know?", or the customer on their own account.
enum AttentionSource {
  STAFF
  BOOKING_PAGE
  CUSTOMER
}

/// SUGGESTED waits for staff to add it; only ACTIVE entries are read out.
enum AttentionStatus {
  SUGGESTED
  ACTIVE
}

// SavedView: a per-actor, per-resource named set of list filters (#124). The
// `filters` payload is the SHAREABLE URL query contract (search/filter/sort/
// page) — plain JSON, NEVER raw SQL — so a saved view can never smuggle an
// unsafe query. Scoped to the Organization and the owner who created it.
model SavedView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerUserId String
  resource    String // e.g. "orders" | "leads" | "products"
  name        String
  filters     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, ownerUserId, resource])
}

// Team: a named group of org members, used to grant Project access in bulk.
// Org-scoped; deleting the Organization cascades.
model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  members TeamMember[]
  access  ProjectAccess[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

// TeamMember: a User's membership in a Team. Both sides cascade on delete.
model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ProjectAccess: a grant of a project role (MANAGER/EDITOR/VIEWER) on one
// Project, to EITHER a User directly OR a Team — exactly one of userId/teamId is
// set (enforced in code). Because Postgres treats NULLs as distinct, the two
// @@unique constraints act as partial uniques: at most one grant per
// (project, user) and per (project, team), while the unused column stays null.
model ProjectAccess {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role String // MANAGER, EDITOR, VIEWER

  // Direct grant to a user (userId set, teamId null) ...
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ... OR a grant to a team (teamId set, userId null). Exactly one is set.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([userId])
  @@index([teamId])
}

// ============================================================================
// CMS: SITES, PAGES, VERSIONS, SECTIONS & PUBLICATIONS (Stage 2 — S2-001)
// ============================================================================
//
// The publishing data model. Two clearly separated halves (see ADR-002):
//
//   1. DRAFT / working set — Site → Page → PageVersion → Section. Mutable while
//      editing (S2-004). DRAFTS ARE PRIVATE and are never read by the public
//      renderer.
//   2. IMMUTABLE published set — Publication. An append-only, fully-resolved,
//      sanitized snapshot produced at publish time (S2-005). The public
//      renderer (S2-006) reads ONLY Publications — never the draft tables.
//
// Every model is Organization-owned (ADR-001): it carries `organizationId`
// (indexed) so tenant scoping / RLS applies uniformly. `Section.content` is
// validated against the versioned section contract in
// `src/cms/section-contract.ts` for its (type, contractVersion).
//
// Note: this is NEW, distinct from the store-scoped blog `Post`/`PostCategory`
// and store `CustomDomain`. Those are intentionally left untouched here; the
// mapping from them into Sites/Pages is deferred (see ADR-002 §mapping).

// A version's editing lifecycle. A DRAFT is the mutable working copy; PUBLISHED
// marks the version a live Publication was snapshotted from; ARCHIVED is a
// retired version kept for history.
enum PageVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Site — an Organization-owned publishing property (public web presence).
// Distinct from Store (a commerce channel), per ADR-001.
model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String // unique within the owning Organization

  // Optional platform subdomain, e.g. "acme" → acme.saroh.in. Globally unique
  // when set (NULLs are distinct, so many sites may have no subdomain).
  subdomain String? @unique

  // The path segment this site's posts live under: /<postsPrefix>/<slug>, with
  // an index at /<postsPrefix> (#232). The merchant chooses it, because "blog"
  // is not what every business calls its writing — a practice has updates, a
  // studio has a journal. Null means the default, "blog"; it is not defaulted
  // in the column so that changing the default later does not silently move
  // every site's posts.
  postsPrefix String?

  // Search and social (#188). Site-level rather than per-page: they describe
  // the site, not any one page of it. Null means "not set" and MUST render as
  // absent — never as an empty title or a broken image.
  //
  // These travel into the Publication snapshot at publish time, because the
  // public renderer reads only that. Changing one is therefore an unpublished
  // change like any section edit.
  // The site's look: six curated colour choices and five spacing scalars
  // (#189). Validated by `site-style.ts`, stored as CHOICE KEYS rather than raw
  // hex so a palette can be retuned without rewriting every site, and resolved
  // into the `--site-*` layer the renderer already defines. Null = the defaults,
  // which reproduce today's appearance exactly.
  style Json?

  seoTitle          String? // <title> / og:title
  seoDescription    String? // meta description / og:description
  socialImageUrl    String? // og:image — the card shown when the link is shared
  // Facts about that picture, recorded when it is chosen (#220). WhatsApp draws
  // its large card only when og:image:width/height are present, and drops it for
  // files over ~300 KB; Facebook and LinkedIn want at least 1200×630. Stored
  // rather than measured at publish so the settings screen can warn while the
  // merchant is still choosing, and so publish stays a pure copy.
  socialImageWidth  Int?
  socialImageHeight Int?
  socialImageBytes  Int?

  // The footer a merchant writes for themselves (#202): `{ format, value }`,
  // the same shape richText sections carry, so one authoring surface and one
  // sanitizer serve both.
  //
  // AUTHORED, never derived. BusinessProfile holds a legal name and a contact
  // email, but a merchant gave those for billing and tax — publishing them to
  // the open internet would repurpose data collected for something else,
  // without asking. So this starts empty and stays empty until someone writes
  // in it, and an empty footer renders NO footer at all.
  //
  // `value` is authorable HTML and MUST be sanitized during publish, exactly as
  // `richText.value` is, before it reaches the immutable snapshot.
  footer Json?

  // The site's menu (#206): `{ items: [{ pageId, label? }] }`, site-level and
  // NOT a section. A menu that were a section would have to be added to every
  // page and kept in step by hand. Items reference pages by ID so a rename
  // cannot break the menu; the path and the default label are resolved into
  // the snapshot at publish. Null means no menu has been built.
  navigation Json?

  // The template this site was made from (industry templates, KTD-7): its id
  // and version, and the style (colourway) chosen with it, when it has
  // styles. Set once at creation and never rewritten by an edit. Null means
  // unknown — a site made before this was recorded — never guessed. Publish
  // stamps these on each Publication; a site without them stamps the
  // starter, as every publish did before.
  templateId      String?
  templateVersion Int?
  templateStyleId String?

  // Reserved placeholder for the S2-007 custom-domain claim/verification flow.
  // NOT wired to a relation here and NOT the legacy store `CustomDomain`.
  customDomainId String?

  // Pointer to the current live Publication served for the site root. Null
  // until first publish; (re)set on publish (S2-005). SetNull keeps the Site
  // if the pointed-at Publication ever disappears (publications are otherwise
  // append-only and never deleted).
  currentPublicationId String?      @unique
  currentPublication   Publication? @relation("SiteCurrentPublication", fields: [currentPublicationId], references: [id], onDelete: SetNull)

  pages            Page[]
  comments         SiteComment[]
  // The site's writing (ADR-004).
  posts            Post[]
  postCategories   PostCategory[]
  approvals        SiteApproval[]
  previewLinks     SitePreviewLink[]
  publications     Publication[]         @relation("SitePublications")
  // Frozen candidates of this site, served on its test host (DEC-071).
  testReleases     SiteTestRelease[]
  testReleaseLinks SiteTestReleaseLink[]
  // Search-engine verification codes and the merchant's own trackers
  // (DEC-108). Read live by the renderer, outside the publication: saving
  // one is never an unpublished change.
  verifications    SiteVerification[]
  trackers         SiteTracker[]
  trackingSettings SiteTrackingSettings?
  // The site's QR codes: short links at `/q/<code>` on its Saroh address.
  qrCodes          QrCode[]

  // "Publishing needs approval" (DEC-071, amends DEC-047). Off: approval is
  // advisory and a bypass is recorded. On: Publish, restore and Go live
  // succeed only for an approved test release, unless an owner overrides,
  // and the override is recorded. Only an owner turns it on or off.
  publishNeedsApproval Boolean        @default(false)
  // Who may review this site (#276).
  reviewers            SiteReviewer[]

  // Verified subdomain / custom-domain claims routed to this Site (S2-007).
  // Nullable on the Domain side (Domain.siteId) — a claim exists before it is
  // linked to a site — so onDelete is SetNull there, not a cascade.
  claimedDomains Domain[]

  // Enquiry forms bound to this site (S3-001). Nullable on the Form side, so
  // deleting a Site does not destroy its enquiry history (SetNull there).
  forms Form[]

  // Bookable services surfaced on this site (S4-001). Nullable on the Service
  // side (SetNull) — booking history outlives a site.
  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Customers signed in on this site (ADR-011): a session is good only on the
  // site, and so the host, it was made for.
  customerSessions CustomerSession[]

  // Addresses this site used to be served at, which forward to it while
  // their redirect lasts (DEC-069, L1).
  addressReservations AddressReservation[]

  // The storefront this site sells from (G11): what `/shop`, the Product
  // grid and checkout read. Set on its own only when the business has
  // exactly one open storefront with listings (the migration's backfill and
  // site creation); otherwise the merchant picks it in the site's settings.
  // Closing that storefront clears it. NoAction, not SetNull: a composite
  // SetNull would null organizationId too, and storefronts are soft-deleted.
  storefrontId String?
  storefront   Store?  @relation("SiteStorefront", fields: [storefrontId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([organizationId, slug])
  // The target of (siteId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([storefrontId])
}

// Page — a routable page within a Site, identified by its `path`.
model Page {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Denormalized tenant scope for isolation / RLS (ADR-001).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  path   String // "/", "/about", ...
  title  String
  isHome Boolean @default(false)

  // Visibility, modelled exactly as `Section.hidden` is: a hidden page keeps
  // its path, its title, its versions and its sections, and is simply left OUT
  // of the published snapshot. Two sibling lists in the same editor must not
  // behave differently — a merchant who learns "hide, don't delete" on sections
  // and then finds only Delete on pages loses work to our inconsistency.
  //
  // The home page can never be hidden: "/" is what the site's own address
  // serves, and a site whose front door is hidden has nothing to show.
  hidden Boolean @default(false)

  versions PageVersion[]
  comments SiteComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What the page is (round-2 G14, DEC-046): FREE is a page the merchant
  // lays out by hand, as every page was before; the others are module pages,
  // which sit beside them. At most one of each module kind per site (the
  // partial unique index below). A Book page is always at /book and a Shop
  // page at /shop; the others default to /prices, /journal and /contact.
  kind PageKind @default(FREE)

  // "Show in menu" (G14). A module page joins the site's menu on its own
  // while this is on; any page with it off is reachable by link but never
  // listed. On by default, so every page that existed before keeps the menu
  // it had.
  inMenu Boolean @default(true)

  @@unique([siteId, path])
  @@unique([siteId, kind], map: "Page_siteId_module_kind_key", where: raw("kind <> 'FREE'"))
  @@index([siteId])
  @@index([organizationId])
}

/// A page's kind (G14): FREE, or the module it presents.
enum PageKind {
  FREE
  SHOP
  BOOK
  PRICES
  JOURNAL
  CONTACT
}

// PageVersion — a DRAFT / working version of a Page. Editing happens here; a
// version is the source a Publication is snapshotted from at publish time.
/**
 * A reviewer's note, pinned to a section.
 * Scope is deliberately small (#193): notes and one approval. No assignment,
 * no states, no rounds — an approval workflow is an agency problem, and this
 * is for two to five people sharing a workspace.
 * Pinned by `sectionKey`, never by Section.id: ids are regenerated on every
 * save. If the section a note is about is later deleted, the note does NOT
 * disappear — nothing matches its key, and the Review tab shows it as being
 * about a section that is no longer on the page. A note that vanished silently
 * would lose the one piece of feedback nobody has acted on.
 */
model SiteComment {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade (#277): deleting a page used to delete every note
  // anyone had left on it. A note is a record of what a person said about the
  // work — the Review tab has always had a group for "On a page that no longer
  // exists", and it could never render because the rows were gone.
  pageId String?
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  // The page's title when the note was written. Kept so a note whose page is
  // gone can still say where it was; the live title wins while the page exists.
  pageTitle String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The section this is about. NOT a relation: the row it names is deleted and
  // recreated on every save, so a foreign key would either block the save or
  // cascade the note away with it.
  sectionKey String

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  body String

  // Resolution is a fact with a time, not a boolean: "when was this settled"
  // is worth being able to answer, and NULL reads unambiguously as open.
  resolvedAt       DateTime?
  resolvedByUserId String?

  // The test release the note was written while viewing (DEC-071), so the
  // release view lists its own notes. Null on a note about the draft. The
  // note is still pinned to a page and a section key, as every note is.
  testReleaseId String?
  testRelease   SiteTestRelease? @relation(fields: [testReleaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, resolvedAt])
  @@index([pageId, sectionKey])
  @@index([organizationId])
  @@index([testReleaseId])
}

/**
 * A reviewer signing the site off. One per review, appended not updated, so
 * "approved, then changes requested, then approved again" is a readable
 * history rather than a flag that flipped.
 */
model SiteApproval {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  byUserId String
  by       User   @relation(fields: [byUserId], references: [id], onDelete: Cascade)

  // REQUESTED | APPROVED | CHANGES_REQUESTED | BYPASSED | OVERRIDDEN |
  // WITHDRAWN (the merchant took a request back, UX-068).
  //
  // REQUESTED is the merchant asking for a review (#278) — the act that makes a
  // review pending, which the model previously had no way to express: a review
  // nobody had answered simply did not exist.
  //
  // APPROVED and CHANGES_REQUESTED are what a reviewer records; the spec's
  // "approved with notes" is APPROVED plus the open note count, not a third
  // verdict. BYPASSED is written by PUBLISH, never by a reviewer (#199): when a
  // site goes live while a review is still outstanding, the fact is appended
  // here — who, when, and which publication — because the epic's rule is that
  // bypassing is recorded, not prevented.
  //
  // OVERRIDDEN is written by an owner going live past "Publishing needs
  // approval" (DEC-071): the rule was on, nothing was approved, and the owner
  // went live anyway. Like BYPASSED it names its publication.
  outcome String

  // Which draft this row is about (#278): a hash of the snapshot publishing
  // would write, minus its timestamp.
  //
  // #193: an approval "does not survive later edits to that draft". Without
  // this, approve → change three sections → publish still read "Approved".
  // Written on REQUESTED and APPROVED; null on the other two, which record an
  // act rather than a state of the work.
  draftFingerprint String?

  // What a reviewer asked to change (UX-043): required on a new
  // CHANGES_REQUESTED, null on every other outcome.
  reason String?

  // The publication a BYPASSED row is about, so version history can show
  // which publish went past an outstanding review. Null on a verdict.
  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  // The test release a request or verdict is about (DEC-071). Its
  // `draftFingerprint` is then the release's fingerprint, not the moving
  // draft's, so the verdict holds for that frozen version. Null on a review
  // of the draft.
  testReleaseId String?
  testRelease   SiteTestRelease? @relation(fields: [testReleaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([organizationId])
  @@index([publicationId])
  @@index([testReleaseId])
}

/**
 * A link that shows a site's DRAFT to whoever holds it (#198).
 * The other half of review: notes and approvals shipped, and the Review tab's
 * empty state told the merchant to "share a preview" — an action that did not
 * exist. This is that action. The draft is rendered by the public renderer at
 * /preview/<token>, built by the same snapshot builder publish uses, and
 * NOTHING about it publishes anything.
 * The token is the whole secret: 32 random bytes, unguessable, carried only in
 * the link. Expiry is a fact with a time so the sharer can be told it in words
 * before they send the link; revocation is a fact with a time for the same
 * reason NULL reads as "still valid" on SiteComment.resolvedAt.
 */
model SitePreviewLink {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // SHA-256 (hex) of the link's secret, never the secret itself (#284). The raw
  // token is returned once, when the link is created.
  tokenHash String @unique

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  revokedAt  DateTime?
  // When the link was last opened. Tells the sharer whether it was ever used,
  // which is the first thing they ask when the feedback does not arrive.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([siteId, revokedAt])
  @@index([organizationId])
}

model PageVersion {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status PageVersionStatus @default(DRAFT)

  // Which edit of this draft the sections are (#285). Incremented inside the
  // replace transaction, and checked against the revision the editor was given
  // when it loaded.
  //
  // Saving a draft DELETES every section and recreates the list the client
  // sent, so without this two tabs on one page silently undo each other: each
  // one saves its whole list, the last write wins, and the loser's work is gone
  // with no conflict, error or trace. A counter is enough — there is exactly
  // one writer path, and it holds a transaction.
  revision Int @default(0)

  createdByUserId String? // authoring user, when known

  sections Section[] // ordered content blocks (see Section.order)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([organizationId])
}

// Section — a typed content block within a PageVersion. `content` is JSON
// validated against the versioned section contract keyed by
// (type, contractVersion) — the single source of truth for what a section may
// hold (src/cms/section-contract.ts).
model Section {
  id            String      @id @default(cuid())
  pageVersionId String
  pageVersion   PageVersion @relation(fields: [pageVersionId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            String // registry key, e.g. "hero", "richText", "cta", "gallery"
  contractVersion Int    @default(1) // contract version validating `content`
  order           Int // ordering within the PageVersion

  // A section's STABLE identity across saves.
  //
  // `id` is not that: saving a draft deletes every section on the page and
  // recreates them (see SitesService.replaceDraftSections — a whole-list
  // replace is what keeps the write atomic and the order gap-free), so every
  // row gets a new id each time. Anything that needs to point AT a section and
  // survive an edit — a reviewer's comment, above all — has to point at this.
  //
  // Minted by the editor when a section is first added and carried through
  // every save afterwards. Unique within a page version, not globally: two
  // versions of the same page hold the same key for the same section, which is
  // what lets a note follow its section from one draft to the next.
  key     String
  content Json // validated against the contract for (type, contractVersion)

  // Visibility is structural, not content: a hidden section keeps its place and
  // its copy in the draft, and is simply left OUT of the published snapshot.
  // That is what lets a merchant park a section without deleting the work.
  hidden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageVersionId, key])
  @@index([pageVersionId, order])
  @@index([organizationId])
}

// Publication — an IMMUTABLE, APPEND-ONLY published snapshot.
//
// Rows are never updated or deleted: republishing inserts a NEW row (hence no
// `updatedAt` — only `publishedAt`). `snapshot` is the fully-resolved, already
// SANITIZED page(s) + sections captured at publish time, so it is
// self-contained: the public renderer (S2-006) reads ONLY this table and never
// needs the draft tables (Page/PageVersion/Section). Rich content is sanitized
// on the way IN (during publish, S2-005) — see src/cms/section-contract.ts.
model Publication {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation("SitePublications", fields: [siteId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional page-level scoping: a publication may snapshot a whole site or a
  // single page/path.
  pageId String?
  path   String?

  // A post's publication names its post (#232), so history reads per post and
  // the live pointer has something to point from. Null on a site publication.
  postId String?
  post   Post?   @relation("PostPublications", fields: [postId], references: [id], onDelete: Cascade)

  // Fully-resolved, sanitized page(s) + sections at publish time. Self-contained.
  snapshot Json

  // The template (versioned — S2-002/S2-003) the snapshot was built with.
  templateId      String
  templateVersion Int

  publishedByUserId String?
  publishedAt       DateTime @default(now()) // immutable; republish == new row

  // Which route this publish took (#278): APPROVED, BYPASSED or NONE.
  //
  // #193 asks that all three be distinguishable after the fact. Only a bypass
  // was recorded before, through a SiteApproval row, so "a reviewer approved
  // this" and "nobody was ever asked" read identically in version history.
  // Null on rows published before this column existed, which is honest: we do
  // not know which route they took.
  //
  // OVERRIDDEN too (DEC-071): an owner went live past "Publishing needs
  // approval".
  reviewRoute String?

  // LIVE | TEST (DEC-071, CHECKed in the migration). A LIVE row is a version
  // the public has been served. A TEST row is a test release's frozen
  // snapshot: built and stored exactly as a publish stores it, and never
  // pointed at by a site. Going live appends a LIVE copy of it, so
  // `Site.currentPublication` is always LIVE, and every reader that means
  // "published" filters on `kind: 'LIVE'`.
  kind String @default("LIVE")

  // The row this one was copied from: the TEST row a go-live put live
  // (DEC-071). Null on an ordinary publish.
  sourcePublicationId String?
  sourcePublication   Publication?  @relation("PublicationSource", fields: [sourcePublicationId], references: [id], onDelete: SetNull)
  copies              Publication[] @relation("PublicationSource")

  // Back-relation for Site.currentPublication (the live pointer above).
  currentForSite Site?            @relation("SiteCurrentPublication")
  // The same, for a post (#232).
  currentForPost Post?            @relation("PostCurrentPublication")
  // Bypass records naming this publication (#199).
  approvals      SiteApproval[]
  // The test release this TEST row freezes, and the one this LIVE copy put
  // live (DEC-071).
  testRelease    SiteTestRelease? @relation("TestReleaseSnapshot")
  wentLiveFor    SiteTestRelease? @relation("TestReleaseLiveCopy")

  @@index([siteId, publishedAt])
  @@index([siteId, kind, publishedAt])
  @@index([organizationId])
  @@index([postId])
  @@index([sourcePublicationId])
}

/**
 * A test release (DEC-071): a named, non-live candidate of a site, served
 * whole at `test--<address>.saroh.app` to whoever holds one of its links.
 * The frozen snapshot is an ordinary `Publication` with `kind = 'TEST'`, so
 * publications stay append-only. Everything about the release that changes
 * (its name and note, a schedule, going live, being discarded) lives here.
 * Going live appends a LIVE copy of the snapshot (`livePublicationId`); the
 * site never points at the TEST row.
 * User ids are plain columns, as `Publication.publishedByUserId` is: removing
 * a person from Saroh never takes a release, or its record, with them.
 */
model SiteTestRelease {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The frozen TEST publication.
  publicationId String      @unique
  publication   Publication @relation("TestReleaseSnapshot", fields: [publicationId], references: [id], onDelete: Cascade)

  // 1, 2, 3 ... per site, for "Test release 2".
  number Int
  name   String
  note   String?

  // `draftFingerprint` of the frozen snapshot. A review of the release is
  // bound to it, and a go-live checks approval against it.
  fingerprint String

  createdByUserId String
  createdAt       DateTime @default(now())

  // Lifecycle: facts with a time. Neither set means the release is ready.
  discardedAt       DateTime?
  wentLiveAt        DateTime?
  // The LIVE copy going live appended.
  livePublicationId String?      @unique
  livePublication   Publication? @relation("TestReleaseLiveCopy", fields: [livePublicationId], references: [id], onDelete: SetNull)

  // A scheduled go-live. `goLiveAt` is the instant (UTC); `goLiveZone` is the
  // business's zone it was chosen in, for saying it back in local time.
  goLiveAt                   DateTime?
  goLiveZone                 String?
  scheduledByUserId          String?
  // The live publication when it was scheduled. If the site has been
  // published since, the scheduled go-live does not run (KTD-14).
  scheduledOverPublicationId String?
  // An owner scheduled it past "Publishing needs approval".
  scheduleOverride           Boolean   @default(false)
  // The PENDING `site.go_live` Job, deleted on cancel.
  goLiveJobId                String?
  // What the last scheduled attempt did (LIVE | NOT_LIVE), and why not.
  lastGoLiveOutcome          String?
  lastGoLiveReason           String?

  links     SiteTestReleaseLink[]
  approvals SiteApproval[]
  comments  SiteComment[]

  @@unique([siteId, number])
  // The target of (testReleaseId, organizationId) foreign keys.
  @@unique([id, organizationId])
  // One live schedule per site: a release waiting to go live that has
  // neither gone live nor been discarded.
  @@unique([siteId], map: "SiteTestRelease_one_schedule_per_site", where: raw("\"goLiveAt\" IS NOT NULL AND \"wentLiveAt\" IS NULL AND \"discardedAt\" IS NULL"))
  @@index([organizationId])
}

/**
 * A link that opens one test release on its test host (DEC-071), with the
 * token scheme of `SitePreviewLink` (#284): 32 random bytes, only the SHA-256
 * hex stored, the raw token returned once. Its own table, so a draft preview
 * token can never open a test host and a test token can never open
 * `/preview/<token>`.
 * SHARE is a link someone made to send; OPEN is a short one minted for the
 * person opening the release from the workspace. A link stops working when it
 * expires, is revoked, or its release is discarded or has gone live.
 */
model SiteTestReleaseLink {
  id            String          @id @default(cuid())
  testReleaseId String
  testRelease   SiteTestRelease @relation(fields: [testReleaseId, organizationId], references: [id, organizationId], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // SHA-256 (hex) of the link's secret, never the secret itself.
  tokenHash String @unique

  // SHARE | OPEN (CHECKed in the migration).
  purpose String

  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([testReleaseId, revokedAt])
  @@index([siteId])
  @@index([organizationId])
}

// ============================================================================
// SITE VERIFICATION AND OWN TRACKERS (DEC-108)
// ============================================================================
//
// What a merchant connects to their live site: a search engine's verification
// code, and their own analytics or ad tracker. Only public ids are stored,
// each checked against its tool's shape (`@saroh/block-contract`,
// `site-tracking.ts`); nothing a merchant enters can run code, and nothing
// secret is kept. All of it reaches the live site at once, read beside the
// publication, never inside it.

/// One search engine's verification code for a site, shown as a `<meta>` tag.
model SiteVerification {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // google | bing | meta | pinterest (CHECKed in the migration).
  service String
  // The bare code. Never the tag it came in.
  code    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, service])
  @@index([organizationId])
}

/// One of the merchant's own trackers on a site, by its public id.
model SiteTracker {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // ga4 | google-ads | meta-pixel | posthog | clarity | plausible | umami
  // (CHECKed in the migration). Loader hosts are fixed in code, never stored.
  kind      String
  trackerId String
  // PostHog only: us | eu.
  region    String?
  // Off keeps the id without loading it.
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, kind])
  @@index([organizationId])
}

/// A site's tracking settings: the merchant's privacy page, and Saroh's
/// switch-off.
model SiteTrackingSettings {
  siteId String @id
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // An https page the cookie banner links to. Null: the site's own
  // generated notice.
  privacyUrl String?

  // Saroh staff switched this site's trackers off (#897): none load until
  // staff switch them back on, whatever the plan.
  switchedOffAt        DateTime?
  switchedOffByStaffId String?
  switchedOffReason    String?

  updatedAt DateTime @updatedAt

  @@unique([siteId, organizationId])
  @@index([organizationId])
}

/// A QR code a business made for its site. The printed code holds a short
/// link, `<address>.saroh.app/q/<code>`, never the target itself: the target
/// is resolved when the code is scanned, so paper keeps working when a page
/// moves and a code can be pointed somewhere new.
model QrCode {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The short id in the link: 3 to 6 characters from an alphabet with no
  // look-alikes, made by the API. Unique per site, so finding one never
  // reads across businesses.
  code String

  // SITE | SHOP | BOOK | PRODUCT | PAGE (CHECKed in the migration).
  targetKind String
  // PRODUCT: the product's id. PAGE: the page's id. Null for the others.
  // An id, not an address, so a renamed product or a moved page still opens.
  targetRef  String?

  // Where the code is placed: COUNTER | MIRROR | CARD | FLYER | OTHER
  // (CHECKed in the migration), and the owner's own words for it.
  place     String
  placeNote String?
  // The line printed with the code ("Scan to book").
  label     String?

  // PLAIN | BRANDED (CHECKed in the migration).
  style String @default("PLAIN")
  // "#rrggbb", lower case (CHECKed in the migration).
  color String

  // Retired, never deleted: paper outlives the row, and a retired code
  // forwards to the site's home page without counting.
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanDays QrScanDay[]

  @@unique([siteId, code])
  // The target of (qrCodeId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId])
}

/// How many times a QR code was scanned on one day. One row per code and
/// day, added to in place; nothing about a visitor is stored.
model QrScanDay {
  qrCodeId String
  qrCode   QrCode @relation(fields: [qrCodeId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  day   DateTime @db.Date // the UTC day bucket, as the analytics rollups
  count Int      @default(0)

  @@id([qrCodeId, day])
  @@index([organizationId])
}

// ============================================================================
// DOMAINS: SUBDOMAIN / CUSTOM-DOMAIN CLAIM + VERIFICATION (Stage 2 — S2-007)
// ============================================================================
//
// A Domain is an Organization's CLAIM on a single hostname (a platform
// subdomain like "acme.saroh.in" or a custom domain like "shop.acme.com").
//
// `hostname` is GLOBALLY UNIQUE, which is the crux of the ownership model: a
// second organization physically cannot insert a row for a hostname another org
// already claimed (the DB rejects it), so the DomainsService can surface a clear
// 409 Conflict. A claim starts PENDING and only becomes VERIFIED once the org
// proves control by publishing the `verificationToken` in a DNS TXT record —
// verification is NEVER asserted by the client. Routing/link to a Site happens
// only AFTER a claim is VERIFIED, so at most one org ever controls a hostname.
model Domain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The subdomain or custom domain being claimed, e.g. "shop.acme.com".
  // Globally unique: a hostname maps to at most one org (see model note).
  hostname String @unique

  // The Site this hostname routes to once VERIFIED. Nullable until linked; the
  // Site may be attached at claim time or at verify time. SetNull so deleting a
  // Site un-links the claim rather than destroying it.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  status String @default("PENDING") // PENDING → VERIFIED (FAILED on a checked failure)

  // Random token (node:crypto) the org must publish in a DNS TXT record.
  verificationToken  String
  verificationMethod String    @default("DNS_TXT")
  verifiedAt         DateTime?

  // The last verification attempt (#200): when it ran, and why it failed —
  // NO_RECORD, WRONG_VALUE or LOOKUP_FAILED — because those have different
  // fixes and the screen must name the one that applies. Null once verified.
  lastCheckedAt   DateTime?
  lastCheckResult String?

  // Hosting (#859): once VERIFIED, the hostname is registered as a custom
  // hostname on the merchant-sites zone (Cloudflare for SaaS). `hostingId` is
  // Cloudflare's custom-hostname id; `hostingStatus` is PENDING (registered,
  // waiting for the CNAME and certificate), ACTIVE (serving), FAILED
  // (Cloudflare reports a problem) or REGISTER_FAILED (the call failed; the
  // next check retries). `hostingError` says in words what last went wrong,
  // null once a call works. A failure here never undoes the verification.
  hostingId        String?
  hostingStatus    String?
  hostingError     String?
  hostingCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([siteId])
}

// ============================================================================
// ENQUIRY / CRM: FORMS → SUBMISSIONS → CONTACTS → LEADS → PIPELINES (Stage 3)
// ============================================================================
//
// The public enquiry funnel and its CRM. Every entity is org-owned (ADR-001)
// and carries `organizationId` for tenant scoping / RLS. A public visitor
// submits a Form on a published Site (no auth); that atomically upserts a
// Contact (a person, deliberately DISTINCT from the commerce `Customer`) and
// creates one Lead placed at the first Stage of the org's default Pipeline. The
// raw Submission is kept immutably. Owners then work Leads across Pipeline
// Stages and log Activities on each Lead's timeline.

// Contact — an org-scoped person in the CRM. DISTINCT from the commerce
// `Customer` (store-scoped, tied to orders/carts): a Contact is a
// marketing/sales person captured from enquiries, deduped per org by email.
model Contact {
  // Their places in line for full classes (round-2 A12).
  classWaitlistEntries ClassWaitlistEntry[]

  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email     String // deduped per org (see @@unique); the primary identity
  firstName String?
  lastName  String?
  phone     String?
  company   String?

  // Free-form provenance, e.g. "enquiry:form:<id>" — where this contact first
  // entered the CRM. Never a tenant boundary; informational only.
  source String?

  leads       Lead[]
  submissions Submission[]
  bookings    Booking[]
  messages    Message[]
  consents    Consent[]

  // Explicit links to commerce Customer records (#120).
  identityLinks CustomerIdentityLink[]

  // What this person holds (ADR-007). Holdings go with the person; invoices
  // keep a bill-to snapshot and only lose the link.
  subscriptions     CustomerSubscription[]
  invoices          Invoice[]
  packPurchases     PackPurchase[]
  courseEnrollments CourseEnrollment[]

  // What the team has written down about this person (U8).
  notes ContactNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The email proven to belong to this person (DEC-049): a sign-in code for
  // it, or a confirmation of their online order or booking sent to it. A
  // site account links to an existing contact only when this is set. A staff
  // edit of the email, or "This isn't them", clears both. Never backfilled.
  emailVerifiedAt  DateTime?
  emailVerifiedVia ContactEmailVerifiedVia?

  // The customer's account on the business's site (ADR-011). At most one
  // that isn't REMOVED (a partial unique on CustomerAccount).
  customerAccounts         CustomerAccount[] @relation("CustomerAccountContact")
  // Accounts staff said "This isn't them" about this contact (A4), so the
  // pair is never suggested again.
  unlinkedCustomerAccounts CustomerAccount[] @relation("CustomerAccountUnlinkedFrom")

  // Needs attention: one shared list of what the team must know (DEC-040, C1).
  attention ContactAttention[]

  // A merge's tombstone (DEC-042, C9). The merged-away contact is never
  // deleted: it keeps its id, holds only ids (a reserved placeholder email,
  // no name, phone, company or address) and points at the survivor, so a
  // late webhook, job or sign-in carrying its id lands on the survivor
  // through `customer-workspace/resolve-contact.ts`. Never more than one hop:
  // a merge re-points tombstones that already pointed at the merged contact.
  // Deleting the survivor takes its tombstones with it.
  mergedIntoId String?
  mergedInto   Contact?  @relation("ContactMerge", fields: [mergedIntoId, organizationId], references: [id, organizationId], onDelete: Cascade)
  mergedFrom   Contact[] @relation("ContactMerge")
  mergedAt     DateTime?

  // Their postal address, as staff keep it on the edit sheet (C8, R10).
  // Never copied into orders already placed; New order may prefill from it.
  // `country` is ISO 3166-1 alpha-2. In India `state` is the GST state's
  // name and `postalCode` a six-digit PIN (checked by the API). A merge
  // fills it from the other contact, whole, when the survivor has none.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // Their message thread with the business, written from their account on
  // the business's site and answered by the team (round-2 A13). At most one.
  customerThread CustomerThread?

  // The autopay mandates they authorised (round-2 D11). Never moved by a
  // merge: the merged-away person's are cancelled (D20).
  paymentMandates PaymentMandate[]

  // When staff removed their details for a privacy request (DEC-042, C11).
  // The row stays so orders, invoices and bookings keep their keys; its
  // email is the `removed+<id>@removed.invalid` placeholder, and name,
  // phone, company and address are cleared. Lists, search and Customer
  // Detail leave it out, and `resolveContact` writers refuse it.
  removedAt DateTime?

  // Email is unique WITHIN an org (email is required, so no NULL rows): a repeat
  // enquiry from the same address updates the existing Contact rather than
  // forking a duplicate. NOT globally unique — two orgs may each hold the same
  // person independently.
  @@unique([organizationId, email])
  // The target of (contactId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId])
  // A survivor's tombstones (a merge re-points them), and "not a tombstone".
  @@index([organizationId, mergedIntoId])
}

// Form — an org-owned enquiry form definition. Optionally bound to a Site so a
// rendered enquiry section (S3-004) can target it. `fields` is the ordered set
// of field descriptors, validated at submit time (S3-002).
model Form {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional owning Site. SetNull keeps the Form (and its submissions/leads) if
  // the Site is deleted — enquiry history is valuable and outlives a site.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name   String
  // Ordered field descriptors: [{ name, label, type, required }]. The site
  // editor rewrites these on every autosave, so they are the DRAFT's fields. A
  // live submission is validated against the current publication's copy
  // instead, and falls back to these only when no publication carries the form
  // (#281).
  fields Json

  // The Pipeline new leads from this form land in. Null → the org's default.
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  status String @default("ACTIVE") // ACTIVE → ARCHIVED (stops accepting)

  submissions Submission[]
  leads       Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([siteId])
}

// Submission — an IMMUTABLE record of one public form submission. Append-only
// (no updatedAt): the raw `data` as the visitor sent it, captured before any
// CRM derivation, so there is always an audit of exactly what was submitted
// even if the derived Contact/Lead are later edited.
model Submission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  // The derived Contact + Lead (set in the same transaction as creation). Kept
  // as SetNull so purging a Contact/Lead never destroys the raw submission.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  data Json // the raw submitted values, keyed by form field name

  // Anti-abuse / dedupe metadata (S3-002).
  ipHash         String? // hashed source IP, never the raw IP
  idempotencyKey String? // client-supplied key to dedupe double-submits

  createdAt DateTime @default(now()) // immutable; no updatedAt

  // A given idempotency key produces at most one submission per form.
  @@unique([formId, idempotencyKey])
  @@index([organizationId])
  @@index([formId])
}

// Pipeline — an org-owned sales pipeline: an ordered set of Stages a Lead moves
// through. Exactly one Pipeline per org is the default (isDefault) that new
// enquiry leads land in when a Form doesn't name one.
model Pipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  stages Stage[]
  leads  Lead[]
  forms  Form[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Stage — one column of a Pipeline. `order` sorts the board left → right.
model Stage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name  String
  order Int // ordering within the Pipeline

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([pipelineId, order])
}

// Lead — a CRM opportunity for a Contact, positioned at one Stage of a
// Pipeline. Created from an enquiry Submission (or by hand) and worked by
// owners; its Stage changes as it progresses. Activities log its timeline.
model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  // Provenance: the Form that created this lead, when it came from an enquiry
  // (null for hand-created leads). SetNull so history survives form cleanup.
  formId String?
  form   Form?   @relation(fields: [formId], references: [id], onDelete: SetNull)

  title  String
  status String @default("OPEN") // OPEN → WON / LOST
  value  Int? // optional monetary value, in minor units

  submissions Submission[]
  activities  Activity[]
  messages    Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([pipelineId, stageId])
  @@index([contactId])
}

// Activity — an entry on a Lead's timeline: a system event (created, stage
// change) or a user-logged note / follow-up task (S3-007). Append-mostly; a
// follow-up task carries an optional dueAt + completedAt.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type String // "CREATED" | "STAGE_CHANGED" | "NOTE" | "TASK" | ...
  body String? // note text / description

  // Actor: the user who performed it, when done by a person (null for system
  // events). Informational — no FK cascade concerns.
  actorUserId String?

  // Follow-up task fields (used when type == "TASK"), S3-007.
  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([leadId, createdAt])
}

// ============================================================================
// DURABLE JOBS / TRANSACTIONAL OUTBOX (Stage 3 — S3-003)
// ============================================================================
//
// A persistent, at-least-once job queue behind the `JobQueue` port. Producers
// enqueue a Job in the SAME transaction as the domain change it follows (e.g.
// the enquiry command inserts the Lead and the "enquiry.notify" Job atomically)
// — the transactional-outbox pattern: if the tx commits the job is durably
// recorded, if it rolls back so does the job, so a committed lead ALWAYS has a
// pending notification and a rolled-back one never leaves a dangling job.
//
// A worker claims due PENDING jobs (status+runAt), sets a visibility lock
// (lockedAt/lockedBy) so concurrent workers don't double-run one, executes the
// registered handler for `type`, and on failure schedules a backed-off retry
// (attempts++/runAt) until `maxAttempts`, after which the job is FAILED
// (dead-letter). Handlers must be idempotent (at-least-once, not exactly-once).
model Job {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type    String // handler key, e.g. "enquiry.notify"
  payload Json // handler input

  status      String @default("PENDING") // PENDING → PROCESSING → DONE | FAILED; PENDING → CANCELLED (staff, #907)
  attempts    Int    @default(0)
  maxAttempts Int    @default(5)

  runAt     DateTime  @default(now()) // earliest execution (retry backoff)
  lockedAt  DateTime? // visibility lock — claimed but not yet finished
  lockedBy  String? // worker id holding the lock
  lastError String? // last failure message (dead-letter diagnostics)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime? // set when DONE or FAILED (terminal)

  // At most one pending run of the self-rescheduling renewal job (ADR-007):
  // the next run is enqueued with insert-on-conflict-do-nothing, so a retried
  // or reclaimed run can never fork a second chain.
  @@unique([type], map: "Job_one_pending_subscription_renew", where: raw("type = 'subscription.renew' AND status = 'PENDING'"))
  // One waiting run of the booking-hold sweep (U19), like the renewal chain.
  @@unique([type], map: "Job_one_pending_booking_release_holds", where: raw("type = 'booking.release-holds' AND status = 'PENDING'"))
  // One waiting run of the pending payment sweep (P1), like the renewal chain.
  @@unique([type], map: "Job_one_pending_payments_confirm_pending", where: raw("type = 'payments.confirm-pending' AND status = 'PENDING'"))
  // One waiting run of the waitlist retention sweep (U30), like the renewal chain.
  @@unique([type], map: "Job_one_pending_waitlist_retention", where: raw("type = 'waitlist.retention' AND status = 'PENDING'"))
  // One waiting run of Saroh billing's plan-move sweep (U15), like the renewal chain.
  @@unique([type], map: "Job_one_pending_billing_moves_apply", where: raw("type = 'billing.moves.apply' AND status = 'PENDING'"))
  // One waiting run of Insights' hourly rollup chain (DEC-075), like the renewal chain.
  @@unique([type], map: "Job_one_pending_analytics_rollup", where: raw("type = 'analytics.rollup' AND status = 'PENDING'"))
  // One waiting run of the custom-domain re-check chain (#860), like the renewal chain.
  @@unique([type], map: "Job_one_pending_domains_recheck", where: raw("type = 'domains.recheck' AND status = 'PENDING'"))
  // One waiting run of the daily analytics retention sweep (#799), like the renewal chain.
  @@unique([type], map: "Job_one_pending_analytics_retention", where: raw("type = 'analytics.retention' AND status = 'PENDING'"))
  // One waiting run of the daily business deletion sweep (#907), like the renewal chain.
  @@unique([type], map: "Job_one_pending_organization_deletion", where: raw("type = 'organization.deletion' AND status = 'PENDING'"))
  @@index([status, runAt])
  @@index([organizationId])
}

// ============================================================================
// NOTIFICATIONS (Stage 3 — S3-006)
// ============================================================================
//
// A durable in-app inbox record. The enquiry.notify job handler (S3-006)
// creates one Notification per new enquiry and, as a delivery channel, sends an
// email — both driven by the at-least-once Job worker, so handlers must be
// idempotent. The `(leadId, type)` unique guarantees "owner is notified once"
// per lead+type even if the job runs twice (NULL leadId rows stay distinct).
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Recipient. Null = an org-wide notice any member/owner may see; set = a
  // specific user's inbox item. Informational (no FK cascade wiring needed).
  userId String?

  type  String // "enquiry.new" | ...
  title String
  body  String?

  // The subject this notice points at (a Lead, for enquiries).
  leadId    String?
  // Or a product review ("A review needs a reply"). Informational, no FK,
  // like leadId — a notice outlives nothing it could dangle from.
  reviewId  String?
  // Or a customer's message thread (UX-014): the contact it opens on, and
  // the message that raised it. Informational, no FK, like leadId.
  contactId String?
  messageId String?

  readAt DateTime? // null = unread

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency backstop for the at-least-once worker: one notice per
  // (leadId, type). NULL leadId rows are distinct, so non-lead notices are
  // unconstrained.
  @@unique([leadId, type])
  @@unique([reviewId, type])
  @@unique([messageId, type])
  @@index([organizationId, userId, readAt])
  @@index([organizationId])
}

// NotificationPreference: one person's choice for one alert on one channel,
// in one business (round-2 F14, R13). "What you hear about" in Settings ›
// Your profile.
//
// The defaults are code (`notifications/alert-preferences.ts`): the bell on
// for everything, email on for Payment failed only, WhatsApp off. A row is
// written only when the person changes a switch, so a business that never
// opens the grid has no rows and hears exactly the defaults.
//
// `event` is an alert key (order | booking | failed | team) and `channel`
// one of bell | email | whatsapp. Strings, not enums, so a new alert is a
// code change and never a migration.
model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  event   String
  channel String
  enabled Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, event, channel])
  @@index([organizationId])
  @@index([userId])
}

// ============================================================================
// SCHEDULING / BOOKINGS (Stage 4 — S4-001)
// ============================================================================
//
// Org-owned bookable Services with weekly AvailabilityRules and immutable
// Bookings. Timezone-aware: availability windows are authored in the Service's
// IANA `timezone`; a Booking stores absolute UTC `startAt`/`endAt` (resolved at
// booking time, DST-correct) plus the display `timezone` the booker saw. Each
// Booking carries an immutable `snapshot` of the Service terms at booking time,
// so a later Service edit never rewrites booked history (same principle as
// Publication). Capacity-one slot safety + transactional reservation land in
// S4-002 (which may add a partial unique index on confirmed slots).

// Service — an org-owned bookable offering (one provider/resource for now,
// modeled as `capacity`).
model Service {
  // Who is waiting for a place in its full sessions (round-2 A12).
  waitlistEntries ClassWaitlistEntry[]

  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional owning Site (for a public booking page). SetNull keeps the Service
  // + its bookings if the Site is deleted.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name        String
  description String?

  durationMinutes     Int // length of one booking slot
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)
  capacity            Int @default(1) // max concurrent bookings per slot

  priceCents Int? // optional price, minor units
  currency   String? // ISO 4217 when priced

  // GST (ADR-008, U5): the rate the price includes and the SAC code.
  gstRate Decimal? @db.Decimal(5, 2)
  sacCode String?

  // IANA timezone the AvailabilityRules are expressed in, e.g. "Asia/Kolkata".
  timezone String

  status String @default("ACTIVE") // ACTIVE → ARCHIVED

  // Online classes (ADR-007): IN_PERSON | ONLINE | EITHER. An ONLINE or
  // EITHER service carries an https meeting link, frozen into each booking's
  // snapshot. The link is a shared credential: every public booker of an
  // online booking receives it. EITHER is chosen per booking
  // (`Booking.locationType`).
  locationType String  @default("IN_PERSON")
  meetingUrl   String?

  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  courses           Course[]
  classPackServices ClassPackService[]
  // Who takes it (U3). None: the service's own weekly rules, as before.
  staffServices     StaffService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Round 2 (E1). Columns land before behaviour: nothing honours `visits`
  // until E9/E10 or `depositMode` until E8, so every service books as one
  // visit with nothing taken at booking until then.
  // How many visits one booking of it is (a treatment): 1 to 12, CHECKed.
  visits            Int     @default(1)
  // What is paid at booking: NONE | PERCENT_25 | PERCENT_50 | FULL, of
  // `priceCents`, worked out on the server. Only a priced service has one.
  depositMode       String  @default("NONE")
  // Whether the business's booking page and services lists offer it. A
  // hidden service is still booked by staff.
  showOnBookingPage Boolean @default(true)

  // The order lines that bill it: a treatment sold as an order (E9).
  orderItems OrderItem[]

  @@index([organizationId])
  @@index([siteId])
}

// AvailabilityRule — a recurring WEEKLY availability window for a Service,
// authored in the Service's timezone (minutes from local midnight).
model AvailabilityRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes from local midnight (0–1439), in the Service tz
  endMinute   Int // exclusive; > startMinute

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([serviceId, dayOfWeek])
}

// Booking — an IMMUTABLE reserved slot. `startAt`/`endAt` are absolute UTC;
// `snapshot` freezes the Service terms (+ booker) at booking time. A public
// booking upserts a CRM Contact (booker), like an enquiry.
model Booking {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Optional CRM linkage (the booker). SetNull so purging a Contact keeps the
  // booking record + its snapshot.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  startAt  DateTime // absolute UTC slot start
  endAt    DateTime // absolute UTC slot end
  timezone String // IANA tz the booker saw the slot in

  status String @default("CONFIRMED") // PENDING → CONFIRMED → CANCELLED

  // A PENDING booking made to pay now on the booking page (U19, ADR-008)
  // holds its place until this instant; after it the place is free again —
  // at read time, and for good when the sweep job cancels the hold. Null on
  // every other booking.
  holdExpiresAt DateTime?

  // How the appointment actually went: ATTENDED, NO_SHOW, or null for one
  // nobody has said yet (#241). SEPARATE from `status` on purpose — status
  // says whether the booking stands, this says how it went, and collapsing
  // them would make "cancelled in advance" and "did not turn up" the same
  // fact about a customer, when they are two of the most different things a
  // merchant can be told. Set only by a person, never by time passing: a slot
  // that has elapsed is not evidence that anybody attended it.
  outcome String?

  // Immutable snapshot of the Service terms (+ booker) at booking time.
  snapshot Json

  bookerName  String?
  bookerEmail String?
  bookerPhone String?

  idempotencyKey String? // dedupe double-submits (like Submission)

  // The QR code whose scan opened the page this booking was made from
  // (`QrCode.id`), when the page's address still carried the scan's tag.
  // Null for every other booking.
  sourceCode String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // What has happened to this booking, in order (#121).
  events BookingEvent[]

  // A course session booking belongs to its enrolment (ADR-007); a booking
  // paid with a class pack has one redemption.
  courseEnrollmentId String?
  courseEnrollment   CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id], onDelete: SetNull)
  packRedemption     PackRedemption?

  // Who takes it (U3). Null on every booking made before staff existed —
  // there is no backfill; the calendar shows them as Unassigned. SetNull so
  // removing a person keeps their bookings.
  staffId String?
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  // How it was paid: MEMBERSHIP | PACK | PAID | DESK, or null when nobody
  // said (every booking made before this column). A membership booking names
  // the subscription whose monthly classes it uses.
  paidWith       String?
  subscriptionId String?
  subscription   CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Cancelled inside the business's free-cancellation window: a class paid
  // with a pack or a membership keeps the class used (U3).
  cancelledLate Boolean @default(false)

  // A paid online booking's own invoice (ADR-008).
  invoices Invoice[]

  // Where an EITHER service's booking happens: IN_PERSON | ONLINE, CHECKed
  // (E1 adds it, E7 writes it). Null — every booking before it, and every
  // booking of a service that isn't EITHER — means "as the service says".
  locationType String?

  // A booking-page note waiting to become Needs attention (C1, C12).
  attentionSuggestions ContactAttention[]

  // The booking page's "Anything we should know?" (E7): at most 1,000
  // characters, CHECKed. Sensitive: served only to someone who may see
  // sensitive Needs attention, never in a list read, kept out of logs and
  // out of the snapshot. C12 turns it into a Needs attention suggestion.
  intakeNote String?

  // The customer's site account when they booked it signed in (A9,
  // ADR-011). The contact is still the booker; this says the account made
  // it, so "This isn't them" (A4) moves it with the account. A single-column
  // key (PostgreSQL 14 has no column-list SET NULL, and a composite SET NULL
  // would null the required organization): RLS and the reservation code keep
  // the account within the booking's business.
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  // Made by the customer on the business's site, not by someone on the team
  // (DEC-095). Free's monthly bookings cap counts only these: a booking the
  // team makes in the workspace is never capped. Written once, when the
  // booking is made (`reserveInTx`: no actor means the booker did it).
  bookedOnline Boolean @default(false)

  // The free-cancel deadline, fixed when the booking is made (E8, DEC-051):
  // its start less the business's free-cancel hours then. A move never
  // changes it. Null — bookings before the column, or made with no rule —
  // is judged by its start and today's rules, as before.
  freeCancelUntil DateTime?

  // A visit of a treatment (E9, DEC-050): the order that sold the whole
  // treatment, and which visit this is (1, 2, …). An order always has its
  // visit number, CHECKed (`Booking_visit_of_order`). SetNull keeps the
  // booking, and the number it had, if the order goes. A visit never refunds on its own: money comes back through
  // the order's refund.
  orderId     String?
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  visitNumber Int?

  // A given idempotency key yields at most one booking per service.
  @@unique([serviceId, idempotencyKey])
  // One live booking per visit of a treatment (E9): two people booking
  // visit 2 at once can't both win. A cancelled visit leaves it, so the
  // visit can be booked again; bookings with no order coexist.
  @@unique([orderId, visitNumber], map: "Booking_one_live_visit", where: raw("status <> 'CANCELLED'"))
  @@index([organizationId])
  @@index([serviceId, startAt])
  @@index([contactId])
  // Finding the appointments that still need an answer — past, not cancelled,
  // no outcome yet — is the whole workflow (#241), so it is indexed rather
  // than scanned. Declared here as well as in the migration that created it:
  // an index that exists in the database but not in the datamodel reads to
  // `migrate dev` as drift, and the migration it generates DROPS it.
  @@index([organizationId, outcome, endAt])
  @@index([courseEnrollmentId])
  // One person's diary across services — the clash check and the calendar.
  @@index([staffId, startAt])
  @@index([subscriptionId])
  // The sweep job's read: holds whose time ran out.
  @@index([status, holdExpiresAt])
  // The whole-business calendar's month: every booking in a date range.
  @@index([organizationId, startAt])
  // What an account booked (the double-booking check, and unlinking).
  @@index([customerAccountId, startAt])
  // The QR list's Bookings count: the few bookings that name a code.
  @@index([sourceCode], map: "Booking_sourceCode_idx", where: raw("\"sourceCode\" IS NOT NULL"))
}

/// Someone who takes bookings (U3, ADR-008). Usually a team member, but a
/// front-desk trainer may never sign in, so the membership is optional.
model StaffMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The team member this person is, when they have an account. One staff
  // member per membership; removing the member keeps the person on the diary.
  membershipId String?     @unique
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  name  String // shown on the calendar and, as a display name, on the booking page
  title String? // e.g. "Trainer", "Physio"

  status     String    @default("ACTIVE") // ACTIVE | ARCHIVED — archived take no new bookings
  archivedAt DateTime?

  services    StaffService[]
  hours       StaffHours[]
  timeOff     StaffTimeOff[]
  extraHours  StaffExtraHours[]
  bookings    Booking[]
  // Invites that would give them a login (#868).
  invitations OrganizationInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Which services a person takes. For a class, the person is its instructor:
/// shown beside it and checked for clashes, but the class keeps its own times.
model StaffService {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([staffId, serviceId])
  @@index([organizationId])
  @@index([serviceId])
}

/// A person's weekly working hours, in the business's own timezone.
model StaffHours {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes from local midnight, inclusive
  endMinute   Int // exclusive; > startMinute

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([staffId, dayOfWeek])
}

/// Time a person is away. The reason is for the team only — no public read
/// ever carries it, or that the person is off at all.
model StaffTimeOff {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  startAt DateTime // absolute; a whole day starts at local midnight
  endAt   DateTime // exclusive
  allDay  Boolean  @default(false)
  reason  String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([staffId, startAt])
  // The calendar's days off read a business's time off overlapping a month
  // (round 2, E20).
  @@index([organizationId, startAt])
}

/// One-off hours on one date, on top of the weekly ones (a closed day opened).
model StaffExtraHours {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date // the business's local calendar date
  startMinute Int
  endMinute   Int

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([staffId, date])
}

/// The whole business closed: nobody can be booked, on any service, with or
/// without staff (E3). Kept apart from StaffTimeOff, whose staffId stays
/// required. A part-day range is one row per day, written in one transaction
/// and shown as one line. Unlike time off, a closure is public: the booking
/// page shows the day as closed. The reason is for the team only.
model BusinessClosure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startAt DateTime // absolute; a whole day starts at local midnight
  endAt   DateTime // exclusive
  allDay  Boolean  @default(false)
  reason  String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([organizationId, startAt])
}

/// Business-wide booking rules (U3). No row, or a null column, is no rule —
/// what every business had before, so nothing changes until one is set.
model BookingRules {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bookAheadDays        Int? // how far ahead a customer may book
  latestBookingMinutes Int? // the latest a customer may book before a start
  freeCancelHours      Int? // cancel at least this long before to get a class back

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The business's refund policy for a booking cancelled in time (E30,
  /// DEC-058): true refunds what the customer paid online automatically,
  /// which is what E8 shipped and the default for a business that never
  /// set it. Never more than was received; a late cancel is never refunded
  /// automatically.
  refundInTimeCancels Boolean @default(true)

  /// How people pay when they book on the booking page (DEC-088, #821,
  /// #822): ONLINE | DESK | BOTH, CHECKed. BOTH — the default, and what
  /// every business had before — offers paying online (when a provider can
  /// take it) and at the desk. A deposit or full price at booking is always
  /// paid online, so DESK leaves a service that asks one unbookable online.
  bookingPayment String @default("BOTH")
}

/// What has happened to a Booking, in order (#121).
///
/// Append-only. A reschedule must not silently overwrite the time a customer
/// agreed to: `Booking.startAt` is where it is NOW, and this is how it got
/// there. Without it the only record of the original slot is the immutable
/// `snapshot`, which holds the FIRST time and cannot show the ones in between.
model BookingEvent {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type String // BOOKED | RESCHEDULED | CANCELLED | ATTENDED | NO_SHOW

  // Who did it. Null when the booker did it themselves through the public
  // form, which is exactly the difference between "they booked it" and "we
  // moved it" — the first question asked when a customer turns up at the
  // wrong time. SetNull so removing a member keeps the history readable.
  actorUserId String?
  actor       User?   @relation("BookingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // The slot on either side of the change. `fromStartAt` is null on BOOKED
  // (there was no before); both are set on RESCHEDULED; CANCELLED, ATTENDED
  // and NO_SHOW carry the slot they are about in `fromStartAt`.
  fromStartAt DateTime?
  toStartAt   DateTime?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([organizationId])
}

// ============================================================================
// PAYMENTS (Stage 5 — S5-002 / S5-003)
// ============================================================================
//
// Organization-owned payment flow, isolated from Saroh's own billing (Stage 7).
// An org connects a merchant provider (Razorpay/Cashfree) whose API credentials
// are stored ENCRYPTED at the app layer (AES-256-GCM: only the ciphertext + iv
// + authTag live here, never plaintext). A PaymentIntent is created from a
// SERVER-CALCULATED order amount (never a client-supplied total); each provider
// interaction is a PaymentAttempt. Money-state changes are driven by the signed
// WebhookEvent inbox (S5-003) whose `(provider, providerEventId)` unique makes
// reconciliation idempotent — a duplicate webhook changes state exactly once.

// MerchantPaymentProvider — an org's connection to a payment provider.
model MerchantPaymentProvider {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider String // "RAZORPAY" | "CASHFREE"
  status   String @default("CONNECTED") // CONNECTED | DISABLED

  // Needs attention (UX-012): the provider refused these keys on a live
  // call. Null while it works; cleared when the keys are entered again.
  attentionReason String? // "KEYS_REFUSED"
  attentionAt     DateTime?

  // Non-secret public identifier (e.g. Razorpay key_id) — safe to read back.
  publicKey String?

  // AES-256-GCM encrypted secret credentials (JSON blob). Plaintext NEVER
  // stored; the key lives in app env. iv + authTag are needed to decrypt.
  encryptedCredentials String
  credentialsIv        String
  credentialsAuthTag   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At most one connection per provider per org.
  @@unique([organizationId, provider])
  @@index([organizationId])
}

// PaymentIntent — an intent to collect a SERVER-CALCULATED amount for an Order
// or, through its pay link, an Invoice (ADR-007, U13). Exactly one of
// `orderId` / `invoiceId` is set — or neither, on an autopay check
// (`purpose` AUTHORISATION, DEC-064): the migrations add a CHECK constraint
// ("PaymentIntent_one_target") that Prisma cannot express here.
model PaymentIntent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  provider         String // which MerchantPaymentProvider
  providerIntentId String? // the provider's order/intent id, set after create

  amountCents Int // server-calculated from the Order or Invoice; minor units
  currency    String

  // CREATED → REQUIRES_PAYMENT → PROCESSING → SUCCEEDED | FAILED | CANCELLED,
  // or SUPERSEDED: an edit's unpaid difference charge a later edit replaced
  // (payments/intent-state.ts); money paid on it anyway is owed back.
  status String @default("CREATED")

  idempotencyKey String? // dedupe client "create intent" calls

  attempts PaymentAttempt[]
  refunds  PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What the provider kept from this payment, in minor units, as its own
  // capture report says (plan 005 E19, default 47): Razorpay's `fee` (GST
  // included), Cashfree's service charge plus its tax. Null when the
  // provider reported none — never an estimate.
  feeCents Int?

  // A charge through an autopay mandate (D11, D13). Such a charge is two
  // steps: the provider's order is made with a pre-debit notice, and the
  // debit is asked for only once the notice is delivered and `debitAfter`
  // has passed. `preDebitStatus`: PENDING | DELIVERED | FAILED | NOT_NEEDED;
  // null on every other intent. `preDebitRef` is the provider's notice id.
  viaMandateId   String?
  viaMandate     PaymentMandate? @relation("MandateCharges", fields: [viaMandateId], references: [id], onDelete: SetNull)
  debitAfter     DateTime?
  preDebitStatus String?
  preDebitRef    String?

  // Why the money was taken. Null: a sale (an order's or an invoice's
  // payment). AUTHORISATION: the ₹1 check a provider takes to authorise
  // autopay when nothing is owed (DEC-064, D12B) — not revenue, on no order
  // or invoice, refunded automatically; `checkForMandateId` is the set-up
  // it authorised (one check per set-up).
  purpose           String?
  checkForMandateId String?         @unique
  checkForMandate   PaymentMandate? @relation("MandateAuthorisationCheck", fields: [checkForMandateId], references: [id], onDelete: SetNull)

  // When Saroh last asked the provider about this intent's order (P1): the
  // sweep that settles a capture whose webhook never came asks an open
  // intent again only after a pause that grows with its age
  // (webhooks/payment-lookup.service.ts). Null: never asked.
  lastLookupAt DateTime?

  @@unique([orderId, idempotencyKey])
  @@unique([invoiceId, idempotencyKey])
  @@index([organizationId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([provider, providerIntentId])
  @@index([viaMandateId])
  @@index([status, createdAt])
}

// PaymentAttempt — one interaction with the provider for an intent.
model PaymentAttempt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  provider    String
  providerRef String? // provider payment id
  // CREATED | AUTHORIZED | CAPTURED | FAILED, or CAPTURED_NEEDS_REFUND: money
  // taken on an invoice that was already paid or void when it arrived, or at
  // an amount or currency the intent didn't ask for (PAY-06), or
  // STOCK_HELD: Saroh's note that this payment's order held its units
  // (stock/reserve.ts reserveOnPayment), not a provider interaction.
  status      String
  rawResponse Json? // provider response (sanitized), for audit

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentIntentId])
}

// PaymentRefund — an org-owned refund against a PaymentIntent. Distinct from the
// legacy store-scoped `Refund` model.
model PaymentRefund {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  amountCents      Int
  currency         String
  status           String  @default("PENDING") // PENDING | SUCCEEDED | FAILED
  providerRefundId String?
  reason           String?

  // The client's key for one refund request (U6): a retry with the same key
  // returns this refund instead of making another.
  idempotencyKey String?
  // Money handed back because the order was edited down before preparing —
  // it lowers the order total, rather than refunding what was bought.
  forEdit        Boolean @default(false)

  // The order lines this refund covers, when it was asked for by line.
  lines PaymentRefundLine[]

  // The credit note this refund made on the order's invoice (U5).
  creditNote Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentIntentId, idempotencyKey])
  @@index([organizationId])
  @@index([paymentIntentId])
}

// How much of one order line a refund covers (U6). The next line refund is
// capped at the line's paid amount less every non-failed row here.
model PaymentRefundLine {
  id             String @id @default(cuid())
  organizationId String

  paymentRefundId String
  paymentRefund   PaymentRefund @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity        Int
  amountCents     Int
  // Units the refund puts back on the shelf ("Put N back in stock", #511):
  // a Returned entry once the provider confirms the refund, never before.
  putBackQuantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([paymentRefundId])
  @@index([orderItemId])
  @@index([organizationId])
}

// WebhookEvent — the SIGNED webhook inbox (S5-003). Every provider callback is
// recorded here first; `(provider, providerEventId)` is UNIQUE so a duplicate
// delivery is dropped and reconciliation applies exactly once.
model WebhookEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider        String
  providerEventId String // the provider's event id (idempotency key)
  eventType       String

  // The raw signed payload + signature, kept for verification + audit.
  payload   Json
  signature String?

  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  // Idempotency backstop: one row per provider event, per business (PAY-05,
  // #106). Unique across all businesses let one business, signing bodies to
  // its own endpoint, claim an event id first and have another's real
  // delivery dropped as a duplicate.
  @@unique([organizationId, provider, providerEventId])
  @@index([organizationId])
  @@index([status])
}

// ============================================================================
// COMMUNICATIONS (Stage 6 — S6-001/002/003)
// ============================================================================
//
// Durable business messaging over the Organization's OWN connected provider
// (email or WhatsApp), kept separate from Saroh's transactional email. A
// Message is the intent to communicate; each provider send is a Delivery with
// an auditable lifecycle; Consent gates who may be messaged on a channel
// (unsubscribe/opt-out enforced before send). Provider API credentials are
// AES-256-GCM sealed, exactly like MerchantPaymentProvider.

// CommunicationProvider — an org's connection for one channel.
model CommunicationProvider {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channel  String // "EMAIL" | "WHATSAPP"
  provider String // e.g. "RESEND" | "SENDGRID" | "SMTP" | "TWILIO" | "META"
  status   String @default("CONNECTED") // CONNECTED | DISABLED

  // Needs attention (UX-012): the provider refused these keys on a live
  // call. Null while it works; cleared when the keys are entered again.
  attentionReason String? // "KEYS_REFUSED"
  attentionAt     DateTime?

  fromAddress String? // verified sender (email address / WhatsApp number)

  // Sealed credentials (see crypto.ts). Plaintext never stored.
  encryptedCredentials String
  credentialsIv        String
  credentialsAuthTag   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, channel])
  @@index([organizationId])
}

// Message — an outbound business message (its intended content + context).
model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channel String // "EMAIL" | "WHATSAPP"

  // Optional CRM context.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  toAddress String // resolved recipient (email / number)
  subject   String?
  body      String

  status String @default("QUEUED") // QUEUED | SENT | FAILED | SUPPRESSED | CANCELLED (a review invitation resent before it went); a Saroh send (DEC-086) also UNKNOWN, or, not emailed, ALLOWANCE_USED | NO_ALLOWANCE | BOOKING_LIMIT

  createdByUserId String?

  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The invoice this message sent or reminded about (round-2 D17), and
  // which transactional template wrote it: INVOICE_SENT | INVOICE_REMINDER.
  // Null on a message someone typed. The invoice's "Sent to …" line and
  // its one-reminder-a-day rule read these rows.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  template  String?

  // The review invitation this message carried (REVIEW_INVITATION, D11).
  // Its deliveries say whether the invitation went: only one the provider
  // accepted (SENT or DELIVERED) shows as sent and counts as a send.
  reviewInvitationId String?
  reviewInvitation   ReviewInvitation? @relation(fields: [reviewInvitationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([contactId])
  @@index([invoiceId, createdAt])
  @@index([reviewInvitationId, createdAt])
}

// Delivery — one provider send attempt for a Message, with its final state.
model Delivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  provider          String
  providerMessageId String?
  status            String  @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | BOUNCED | CANCELLED (a review invitation resent before it went); a SAROH one (DEC-086) also STOPPED | UNKNOWN
  error             String?
  attempts          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([messageId])
  // A business's deliveries by route and time: the monthly count of the
  // emails Saroh sends for it (DEC-086, `COUNTED_SAROH_DELIVERIES`).
  @@index([organizationId, provider, createdAt])
  // Every business's Saroh sends in the last day: the platform's ceiling.
  @@index([createdAt], map: "Delivery_saroh_createdAt_idx", where: raw("provider = 'SAROH'"))
}

// Consent — a contact's opt-in/out for a channel. Enforced before any send.
model Consent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel String // "EMAIL" | "WHATSAPP"
  status  String  @default("GRANTED") // GRANTED | REVOKED
  source  String? // where consent was captured/changed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, channel])
  @@index([organizationId])
}

// AutomationRule — a constrained trigger→action rule for new leads (S6-003).
// Enabled rules fire ONCE per matching lead (idempotency enforced by the
// worker/outbox), and can be disabled + audited.
model AutomationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  trigger String // e.g. "lead.created"
  action  String // e.g. "send.message" | "create.task"
  config  Json // action parameters (template id, channel, ...)

  enabled Boolean @default(true)

  createdByUserId String?

  runs AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, trigger, enabled])
}

// AutomationRun — the ledger that makes a rule fire AT MOST ONCE per lead
// (@@unique([ruleId, leadId])) and provides the audit trail (S6-003).
model AutomationRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  leadId String
  status String  @default("DONE") // DONE | FAILED | SKIPPED
  error  String?

  createdAt DateTime @default(now())

  // Idempotency: one run per (rule, lead) — a rule fires once per matching lead.
  @@unique([ruleId, leadId])
  @@index([organizationId])
}

// AnalyticsEvent — the versioned, org-owned event taxonomy (S7-001).
//
// Every observable business event (a public site view, an enquiry submission, a
// paid order) is recorded against ONE contract: the pair (type, schemaVersion)
// selects a validator in code that the `properties` JSON must satisfy at intake
// (S7-002). Bumping `schemaVersion` lets a type evolve without rewriting
// history. Rows are tenant-owned (denormalized organizationId) and carry
// consent + retention metadata so a privacy/retention job can prune withdrawn
// or expired data.
//
// Site/project scoping is stored as plain ids (no FK cascade) so pruning a Site
// never rewrites the analytics ledger; the aggregate jobs group by these.
model AnalyticsEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  siteId    String?
  projectId String?

  // The contract selector.
  type          String // "site.view" | "enquiry.submitted" | "order.paid" | ...
  schemaVersion Int    @default(1)

  properties Json // validated against (type, schemaVersion) at intake

  // Consent basis at capture time ("anonymous" | "granted" | "revoked"). A
  // revoked/withdrawn basis lets the retention job drop identifying rows.
  consent String @default("anonymous")

  // Coarse, NON-identifying visitor grouping for unique counts — a salted hash
  // written by intake (S7-002), NEVER a raw IP. Null when not consented.
  visitorHash String?

  occurredAt DateTime // when the event happened (source clock, bounded at intake)
  receivedAt DateTime @default(now()) // when Saroh accepted it (server clock)

  // Retention: intake stamps an expiry from the org's retention policy; a prune
  // job deletes rows past it. Null = no expiry configured.
  expiresAt DateTime?

  // Idempotency: an optional producer-supplied key dedupes at-least-once intake
  // (P2002 → no-op). Nulls are distinct in Postgres, so only real keys dedupe.
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, type, occurredAt])
  @@index([organizationId, siteId, occurredAt])
  @@index([expiresAt])
  // The hourly rollup (DEC-075) asks what arrived since its last run, across businesses.
  @@index([receivedAt])
}

// AnalyticsDailyAggregate — pre-computed per-day rollups (S7-002 populates
// these) so dashboards never scan the raw event ledger. One row per
// (org, siteId, UTC day, type, dimension, dimensionValue). `siteId`/`dimension`
// default to "" (a non-null sentinel) so the unique key backs a clean upsert —
// "" means org-wide / the grand total for that type.
model AnalyticsDailyAggregate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  siteId String @default("") // "" = all sites / org-wide

  date           DateTime @db.Date // the UTC day bucket
  type           String // event type this row aggregates
  dimension      String   @default("") // "" = total; else e.g. "path" | "referrer"
  dimensionValue String   @default("")

  count       Int @default(0)
  uniqueCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, siteId, date, type, dimension, dimensionValue])
  @@index([organizationId, type, date])
}

// Plan — the VERSIONED catalog of Saroh subscription plans sold to
// Organizations (S7-005). NOT org-owned: a global catalog. A published plan
// version is immutable — changing price or entitlements means a NEW version, so
// existing subscribers keep the terms they signed up under. `entitlements` is
// the typed limit map the server-side EntitlementService enforces (e.g.
// { "sites": 3, "teamMembers": 5, "customDomain": true }).
model Plan {
  id      String @id @default(cuid())
  key     String // "free" | "pro" | "business"
  version Int    @default(1)
  name    String

  priceCents Int    @default(0)
  currency   String @default("INR")
  interval   String @default("month") // "month" | "year"

  entitlements Json // typed limit map enforced by EntitlementService

  active Boolean @default(true) // offerable to NEW subscribers

  subscriptions Subscription[] @relation("SubscriptionPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pricing catalogue (KTD-2): a published version writes one row per plan
  // AND billing cycle, keyed `catalog.<planId>`, so the unique key carries the
  // interval. The old (key, version) key could not hold both cycles.
  pendingSubscriptions Subscription[]        @relation("SubscriptionPendingPlan")
  providerPlans        PricingProviderPlan[]
  checkouts            BillingCheckout[]

  @@unique([key, version, interval])
}

// Subscription — an Organization's subscription to a Plan version (S7-005).
// Org-owned; at most one row per org (`organizationId @unique`) — the tenant's
// current plan. Billing runs through Saroh's OWN platform Razorpay/Cashfree
// account (env-configured, NOT stored here), NEVER an org's merchant
// MerchantPaymentProvider — credential separation is a hard boundary: Saroh
// billing never reads or writes org merchant-payment records.
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation("SubscriptionPlan", fields: [planId], references: [id])

  status String @default("ACTIVE") // TRIALING | ACTIVE | PAST_DUE | CANCELLED

  provider               String? // "RAZORPAY" | "CASHFREE" (null on a free plan)
  providerSubscriptionId String? // the provider's subscription id
  providerCustomerId     String?

  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  // When the owner chose to end the plan at the period's end (Free in
  // Plan and billing, or cancel), as against the term ending with nothing
  // renewed, which sets `cancelAtPeriodEnd` too (DEC-100). A term's end
  // then says "as you chose" rather than asking to pay. Cleared whenever
  // `cancelAtPeriodEnd` is.
  freeChosenAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pricing catalogue (KTD-4): a move to another plan version, applied by the
  // renewal path on `pendingFrom` (the first renewal at least 7 days after
  // go-live). Cleared when applied or when the scheduled version is cancelled.
  pendingPlanId String?
  pendingPlan   Plan?     @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  pendingFrom   DateTime?
  // "month" | "year". Mirrors the `Plan` row's interval the subscription is
  // billed on, so a cycle change can be pending on its own.
  billingCycle  String    @default("month")

  addons            SubscriptionAddon[]
  couponRedemptions PricingCouponRedemption[]
  addonCharges      SubscriptionAddonCharge[]

  // Saroh billing (U15): when the provider says the last event it applied
  // happened. A delivery older than this is acknowledged and changes
  // nothing, so a late `activated` can't undo a newer `cancelled`.
  providerEventAt DateTime?

  @@unique([provider, providerSubscriptionId])
  @@unique([id, organizationId])
  @@index([planId])
  @@index([pendingPlanId])
  @@index([pendingFrom])
}

// EntitlementOverride — one per-business exception, set by an operator (admin
// console), with a reason. An expired or revoked row is history and changes
// nothing.
//
// `kind` (pricing catalogue KTD-6): `raise` is the original meaning — a
// numeric cap raised over the plan's (`EntitlementService` applies the highest
// live one; never lowers). The others are read through the catalogue
// (`@saroh/pricing-catalog` resolveAccess), combined in the order plan →
// remove → grant → limit → raise, oldest first within a kind:
//   grant / remove  — a catalogue module (`moduleKey`) on or off
//   limit           — a catalogue module's cap set to `value`, up or down
//   price           — a custom monthly price, `value` in paise
//   plan            — the business is on catalogue plan `planKey` (how
//                     grandfathering and the launch offer work, KTD-7, OQ-1)
// `key` stays required: the legacy entitlement key for `raise`, the module id
// for a module kind, and "plan" / "price" otherwise. The CHECK constraint
// `EntitlementOverride_kind_shape` holds each kind to its columns.
// `expiresAt` null lasts until revoked.
model EntitlementOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key   String
  value Int?

  reason          String
  grantedByUserId String

  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  kind      String  @default("raise")
  moduleKey String?
  planKey   String?

  @@index([organizationId, expiresAt])
  @@index([organizationId, kind])
}

// BillingWebhookEvent — the idempotent inbox for Saroh's billing-provider
// webhooks (S7-005), the SaaS analogue of the merchant WebhookEvent. Signature
// is verified before any write; @@unique([provider, providerEventId]) makes a
// replay a 200 no-op. Kept ENTIRELY separate from merchant payments. The
// resolved org is a plain denormalized id (no FK) so the append-only inbox is
// never rewritten by a tenant delete.
model BillingWebhookEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String
  type            String

  organizationId String?

  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerEventId])
  @@index([organizationId])
}

// WaitlistSignup — pre-launch interest captured from the public marketing site.
//
// Deliberately NOT tied to Organization or User: nobody who signs up has either
// yet, and that is the whole point of a waitlist. It is the only tenant-less
// business table, which is why it carries no organizationId and is exempt from
// RLS considerations.
//
// One entry per email AND business (U30, plan KTD-17 and OQ-11), so one owner
// can list a second business. `email` is stored as typed (trimmed and
// lower-cased) because that is where the invite goes; `emailKey` is the same
// address normalised for "is this the same person" — `+tags` dropped
// everywhere, dots dropped and googlemail folded into gmail for Gmail — and
// `businessKey` is the business name lower-cased with its spaces collapsed
// ("" for the V1 form, which asked for an email only). The pair is unique, so
// a repeat join is an idempotent no-op rather than a duplicate row.
//
// `ipHash` is a sha256 of the visitor's address — the raw IP is never stored,
// matching the public enquiry surface — and exists so abuse can be
// investigated and a self-referral recognised.
model WaitlistSignup {
  id String @id @default(cuid())

  email       String
  emailKey    String
  businessKey String @default("")

  // What the V2 form asks (U30). Null on entries from the V1 form.
  businessName String?
  // One of the form's kinds (`WAITLIST_KINDS` in the API), never free text.
  kind         String?
  // Optional, free text the visitor typed.
  city         String?
  // The visitor's country as the site's host saw their connection
  // (Cloudflare's `cf-ipcountry`; Vercel's `x-vercel-ip-country` before
  // 8 Oct 2026; ISO 3166-1 alpha-2, e.g. "IN"), never asked. Null
  // when it wasn't known, and on entries before 5 Oct 2026.
  country      String?
  // The plan a "Get early access · ‹Plan›" button named, if one did.
  plan         String?
  // The gallery template a "Save ‹Template› for early access" button saved
  // (saroh.in/templates, industry templates U13): one of the gallery's slugs
  // (`waitlistTemplate` in the API), never free text. Null when none was.
  template     String?

  // Where the signup came from: the page's `?src=`, "direct" when none (V2),
  // "saroh.in" from the V1 form. Free text, never trusted for authorization.
  source String?

  // "#N on the list": assigned by a sequence, in the order people joined.
  position Int @default(autoincrement())

  // The stable short id in this entry's referral link (`?ref=`), never the
  // business name (names collide, plan D-5). Null on V1 entries.
  refCode String? @unique

  // Who sent them, when the link was someone else's: a self-referral (same
  // emailKey or same ipHash as the referrer) is not recorded.
  referredById String?
  referredBy   WaitlistSignup?  @relation("WaitlistReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    WaitlistSignup[] @relation("WaitlistReferrals")

  ipHash String?

  // The link preview tool (resources plan U2, KTD-5): an email given to
  // unlock its report is kept here with source "link-preview", with the
  // last address it checked and when. The retention sweep drops the link
  // after 12 months, and a link-preview-only entry with it (Privacy).
  checkedUrl       String?
  checkedAt        DateTime?
  // Marketing consent. Never set true by the link preview tool, which stopped
  // asking (security review, 5 Oct 2026): an unverified address can't give
  // it. False on its new entries; null on entries from forms that never asked.
  newsConsent      Boolean?
  // The link preview report emails this address was sent on one UTC day:
  // the day and how many (at most 3). `reportEmailDay` also lets the gate
  // count every report email sent today against its daily ceiling.
  reportEmailDay   DateTime? @db.Date
  reportEmailCount Int       @default(0)

  // Set when the batch containing this signup is opened, so "who is still
  // waiting" is a query rather than a spreadsheet.
  invitedAt DateTime?
  // Set when an invitee signs up (U31). The retention sweep deletes an entry
  // invited more than 12 months ago that never joined.
  joinedAt  DateTime?

  // The opening-day invite (U31, KTD-17): only the SHA-256 of the link's
  // token is kept, so the table never holds a usable link. Single use (the
  // entry's `joinedAt`), bound to this entry's email, and it expires.
  inviteTokenHash      String?   @unique
  inviteExpiresAt      DateTime?
  // When the invite email left. Null with `invitedAt` set: claimed, not sent
  // yet (or the send was interrupted, and a later batch sends it again).
  inviteSentAt         DateTime?
  // The business the invitee made with it. A plain id, no FK: the entry is
  // the waitlist's record and outlives a business that is deleted.
  joinedOrganizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emailKey, businessKey])
  @@index([createdAt])
  @@index([invitedAt])
  @@index([referredById])
  @@index([reportEmailDay])
}

/// A record of a completed or in-flight idempotent operation.
///
/// An idempotency key says "this is a retry". It does NOT say "this is the SAME
/// request" — and nothing was checking. A second call carrying the same key but
/// a different payload was treated as a duplicate and silently dropped, so the
/// caller received 200 and believed their new instruction had been applied when
/// it had been discarded (reproduced 2026-07-31: same key, opposite `enabled`,
/// flag unchanged).
///
/// `fingerprint` closes that: it is a hash of the canonical request, so a
/// mismatch against a stored key is a conflict rather than a duplicate.
model IdempotencyRecord {
  id String @id @default(cuid())

  /// Operation namespace, e.g. "flags.global.set". Keys are only unique within one.
  scope String
  /// The client-supplied key.
  key   String

  /// Who performed it; a key from one actor must never satisfy another's.
  actorUserId    String
  /// Present for tenant-scoped operations, null for platform-level ones.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// sha256 of the canonical request. Different payload, same key -> 409.
  fingerprint String

  /// IN_PROGRESS until the operation completes, then COMPLETED.
  status   String @default("IN_PROGRESS")
  /// The original response, replayed verbatim to an identical retry.
  response Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// Retention horizon; records past this are safe to prune.
  expiresAt   DateTime

  @@unique([scope, key, actorUserId])
  @@index([expiresAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Discount codes (plan 2026-09-20-001). A code belongs to the BUSINESS; what
// it reaches is the merchant's choice — the whole business, named
// storefronts, collections or products. `appliesTo` decides reach, never the
// number of rows in the reach tables: a STOREFRONT code whose storefronts
// were all deleted reaches nothing, it does not widen to everything.
// ---------------------------------------------------------------------------
model Discount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stored normalised (trimmed, upper case), which is what makes the
  // per-business uniqueness real without an expression index.
  code        String
  description String?

  kind       String // PERCENTAGE | FIXED_AMOUNT
  percentBps Int? // 15% = 1500
  amount     Decimal? @db.Decimal(12, 2)
  currency   String?

  appliesTo String // BUSINESS | STOREFRONT | COLLECTION | PRODUCT

  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?

  stores      DiscountStore[]
  categories  DiscountCategory[]
  products    DiscountProduct[]
  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Reach rows reach their organization through the discount (RLS EXISTS
// policy), as PostCategory and OrderItem do — no organizationId of their own.
model DiscountStore {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([discountId, storeId])
  @@index([storeId])
}

model DiscountCategory {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([discountId, categoryId])
  @@index([categoryId])
}

model DiscountProduct {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@index([productId])
}

// One use of a code, on one order. How often a code was used is a count of
// these, not a counter. It snapshots what it applied, so re-rating or
// renaming a code later cannot rewrite the history of the orders that used
// it. NoAction from Discount and Order: a discount or an order with a
// redemption cannot be deleted on its own, but an organization's cascade —
// which removes both in the same statement — still can.
model DiscountRedemption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  discountId     String
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: NoAction)
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: NoAction)

  amount   Decimal @db.Decimal(12, 2)
  currency String

  code       String
  kind       String
  percentBps Int?
  ruleAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([discountId, orderId])
  @@index([discountId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Product reviews (plan 2026-09-21-001). A review comes only from a customer
// the merchant invited, for an order that was paid and shipped: one link per
// order, whose token is stored ONLY as its SHA-256 hash.
// ---------------------------------------------------------------------------
model ReviewInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // One live invitation per order; a resend rotates the hash in place.
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tokenHash       String    @unique
  // The address it was sent to — shown on reviews as "invited to …".
  toAddress       String
  expiresAt       DateTime
  // Every line reviewed: the link has done its job.
  completedAt     DateTime?
  // Sends by Saroh's own sender, before invitations moved to the business's
  // provider (D11, 2026-10-07). Since then a send counts only once its
  // provider accepted it, read from `messages`' deliveries; new rows hold 0.
  sendCount       Int       @default(1)
  lastSentAt      DateTime  @default(now())
  createdByUserId String?

  reviews  ProductReview[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model ProductReview {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitationId   String
  invitation     ReviewInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  // One review per order line. SetNull keeps the review if the line goes.
  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshots: what was reviewed and whom it was sent to, as they were.
  productName String
  invitedTo   String

  rating      Int // 1–5, enforced in the API (a CHECK would drift the replay)
  body        String? @db.Text
  displayName String

  status         String    @default("PUBLISHED") // PUBLISHED | HIDDEN
  hiddenAt       DateTime?
  hiddenByUserId String?

  reply          String?   @db.Text
  repliedAt      DateTime?
  replyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, productId, status])
  @@index([organizationId, createdAt])
}

// ============================================================================
// SUBSCRIPTIONS, INVOICES, COURSES AND CLASS PACKS (ADR-007)
// ============================================================================
//
// What a service business sells beyond products and single bookings. The
// Organization owns every row, and the person is a CRM Contact — a gym or a
// clinic usually has no storefront, so none of this hangs off Store/Customer.
// Saroh's own plan billing is Plan/Subscription above; these names are kept
// apart on purpose.
//
// Money is Decimal(12,2) like Order, computed by the API in integer minor
// units. Anything sold copies its price (and terms) at the moment of sale, so
// editing a plan or a pack never rewrites what someone already bought.

// What a business sells on repeat: a membership, a monthly plan.
model SubscriptionPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  currency    String
  interval    String // WEEK | MONTH | QUARTER | YEAR
  status      String  @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED — only ACTIVE takes new subscribers (D21)

  // A membership's classes a month (U3). Null: as many as they like.
  classesPerMonth Int?

  subscriptions   CustomerSubscription[]
  // Subscriptions switching to this plan at their next renewal.
  pendingSwitches CustomerSubscription[] @relation("PendingPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every change to it, newest last (D2).
  events SubscriptionPlanEvent[]

  // Drafts (round-2 D5, `common/drafts/`). A live plan's unpublished changes:
  // only the fields that differ from the published columns, which buyers
  // keep reading. Null when there are none. A DRAFT plan writes its columns
  // directly and never holds a pending set.
  pendingChanges     Json?
  // When, and by whom, the pending set (or a draft's columns) was last
  // saved. Null once published or discarded. No foreign key: a teammate who
  // leaves keeps their saves; a Saroh operator's is never stored (DEC-035).
  pendingChangedAt   DateTime?
  pendingChangedById String?
  // Bumped by every draft save, publish, discard and plan write, so an
  // editor holding an older revision is refused instead of overwriting (#285).
  draftRevision      Int       @default(0)

  // When autopay debits this plan's renewals (round-2 D13B, DEC-065): one
  // of BusinessProfile.autopayChargeTiming's values, or null to use the
  // business's setting. Set straight from Plan Detail, not through a draft:
  // it is billing, never shown to buyers. A CHECK constraint holds the values.
  autopayChargeTiming String?

  // The composite key its events point at, so an event can't name another
  // business's plan.
  @@unique([id, organizationId])
  @@index([organizationId])
}

// One change to a plan: who made it, when, and each changed field's value
// before and after (plan 2026-09-26-004, D2). Append-only: nothing updates
// or deletes a row; it goes only with its plan (a draft deleted, D5).
model SubscriptionPlanEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // CREATED | PUBLISHED | PRICE_CHANGED | CLASSES_CHANGED | RENAMED |
  // DESCRIPTION_CHANGED | UPDATED | ARCHIVED | RESTORED | DRAFT_DISCARDED
  // (PLAN_EVENT_KINDS in plan-events.ts).
  kind        String
  // TEAM | JOB | OPERATOR. An operator's change reads as Saroh support
  // (DEC-035).
  actorKind   String
  // Who made it. Not a foreign key: someone who leaves the team keeps their
  // changes in the history. Null for the job.
  actorUserId String?

  // { field: [before, after] }, plan fields only; money as "1500.00".
  changes Json @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, planId, createdAt])
}

// A person on a plan. Invoiced forward, one invoice per period; "overdue" is
// derived from its invoices, never stored.
model CustomerSubscription {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  // Plans are archived, never deleted, while anyone holds one.
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status String @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED

  // Terms at the moment of sale.
  price    Decimal @db.Decimal(12, 2)
  currency String
  interval String // WEEK | MONTH | QUARTER | YEAR
  timezone String // IANA; renewal boundaries are computed in this zone

  anchorAt           DateTime // the start date renewal days are counted from
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  pausedAt           DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  createdByUserId    String?

  // The collection schedule: the ISO weekday (1 Monday … 7 Sunday) the
  // customer collects on, in the subscription's timezone, and what they
  // collect. Null weekday: nothing is collected (a membership). Collections
  // are dated from it within each period, so a monthly plan can collect weekly.
  collectionWeekday Int?
  collectionNote    String?

  // A plan change booked for the next renewal: the renewal (or a resume
  // past the paid period) switches plan, price and interval, then clears it.
  pendingPlanId String?
  pendingPlan   SubscriptionPlan? @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)

  invoices Invoice[]
  skips    SubscriptionSkip[]
  // Classes booked on this membership (U3).
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Everything done to it, newest last (D9).
  events SubscriptionEvent[]

  // A pause's end date (D8): the start of that day in its timezone. The
  // renewal job resumes it then; null pauses until someone resumes it.
  pausedUntil DateTime?

  // The classes a month this period includes (D10): the plan's value, taken
  // at subscribe and at each renewal, so a plan's new allowance reaches a
  // member at their next renewal. Null is no allowance (unlimited). Only a
  // set `classesPerPeriodSetAt` makes it authoritative: while that is null
  // (a row the previous image wrote), readers take the plan's value
  // (`subscriptions/classes-allowance.ts`), until follow-up Z1.
  classesPerPeriod      Int?
  classesPerPeriodSetAt DateTime?

  // Its autopay mandates (round-2 D11): at most one ACTIVE, and every one
  // ends when the subscription does (D20).
  paymentMandates PaymentMandate[]

  // One live subscription per person per plan: a second is a double-click,
  // and it would bill them twice every period.
  @@unique([planId, contactId], map: "CustomerSubscription_one_live_per_person", where: raw("status <> 'CANCELLED'"))
  // The composite key its events point at, so an event can't name another
  // business's subscription (D9).
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([contactId])
  @@index([status, currentPeriodEnd])
  @@index([pendingPlanId])
}

// One thing done to a subscription: what, who did it and when (plan
// 2026-09-26-004, D9). Written in the same transaction as the action it
// records. Append-only: nothing updates or deletes a row; it goes only with
// its subscription.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   CustomerSubscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // SUBSCRIBED | PAUSED | RESUMED | CANCELLED | CANCEL_SCHEDULED | KEPT |
  // ENDED | PLAN_CHANGE_BOOKED | PLAN_CHANGE_CANCELLED | PLAN_CHANGED | ...
  // (SUBSCRIPTION_EVENT_KINDS in subscription-events.ts).
  kind              String
  // TEAM | CUSTOMER | JOB | OPERATOR. An operator's action reads as Saroh
  // support (DEC-035).
  actorKind         String
  // The team member or operator. Not a foreign key: someone who leaves the
  // team keeps their actions in the log. Null for the job and a customer.
  actorUserId       String?
  // The customer's site account, when they acted themselves (ADR-011).
  // Not a foreign key, for the same reason.
  customerAccountId String?
  // The invoice the action issued or acted on. Not a foreign key: the log
  // outlives a voided invoice, and only links to it.
  invoiceId         String?
  note              String?
  // What the kind needs to be said in words, e.g. { weeks: 4 } or
  // { to: { id, name, price } }; money as "1500.00".
  data              Json    @default("{}")

  createdAt DateTime @default(now())

  // Also serves Home's failed-renewal read (F1), which asks by subscription.
  @@index([organizationId, subscriptionId, createdAt])
}

// One collection a subscriber will not make, by its date in the
// subscription's timezone. A period whose every collection is skipped before
// it is invoiced is not charged; otherwise a skip changes the pickup only.
model SubscriptionSkip {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date // the collection's local date
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([subscriptionId, date])
  @@index([organizationId])
}

// A bill. DRAFT → ISSUED → PAID, or VOID. An issued invoice never changes: a
// mistake is voided (keeping its number) and reissued as a new draft.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  number String? // INV-0001, RC/26-27/0001, PF-0001…; assigned on issue, null while DRAFT
  // DRAFT | ISSUED | PAID | VOID | CREDITED. CREDITED: an issued invoice a
  // credit note cancelled in full (ADR-008) — a registered business never voids.
  status String  @default("DRAFT")

  // INVOICE | CREDIT_NOTE | SUPPLEMENTARY (ADR-008). A credit note (down) or
  // a supplementary invoice (up) corrects `relatedInvoiceId`, never edits it.
  kind             String    @default("INVOICE")
  relatedInvoiceId String?
  relatedInvoice   Invoice?  @relation("InvoiceCorrection", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  corrections      Invoice[] @relation("InvoiceCorrection")

  // What it bills when it is not hand-written: an order (one INVOICE per
  // order; the order is the ledger, so it has no pay link) or a paid online
  // booking. A credit note made by a refund names the refund.
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paymentRefundId String?        @unique
  paymentRefund   PaymentRefund? @relation(fields: [paymentRefundId], references: [id], onDelete: SetNull)

  // Who it is billed to. The name and email are copied on issue, so an
  // invoice reads the same after the contact is edited or deleted.
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  billToName    String?
  billToEmail   String?
  // A registered buyer's GSTIN, their state (GST state code) and address.
  billToGstin   String?
  billToState   String?
  billToAddress String?

  // GST, frozen on issue (ADR-008). `sellerGstin` set = a tax invoice; null
  // = a receipt. Place of supply is a GST state code; `taxType` INTRA (CGST +
  // SGST) or INTER (IGST).
  sellerGstin     String?
  sellerState     String?
  // The business's registered address as printed, frozen on issue like the
  // GSTIN: settings edited later never change issued paper.
  sellerAddress   String?
  // The business's name (`Organization.name`), legal name and contact email
  // (`BusinessProfile.legalName`, `.contactEmail`) as printed, frozen on
  // issue like the GSTIN: settings edited later never change issued paper
  // (DEC-082). Null on a draft, which prints today's. The logo stays live.
  sellerName      String?
  sellerLegalName String?
  sellerEmail     String?
  placeOfSupply   String?
  taxType         String?
  cgst            Decimal @default(0) @db.Decimal(12, 2)
  sgst            Decimal @default(0) @db.Decimal(12, 2)
  igst            Decimal @default(0) @db.Decimal(12, 2)

  currency String
  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  issuedAt   DateTime?
  dueAt      DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?
  voidReason String?

  // A payment taken outside Saroh, recorded by hand: CASH | UPI |
  // BANK_TRANSFER | CARD | OTHER. Nothing is charged.
  paymentMethod    String?
  paymentReference String?
  paymentNote      String?

  // What it is for: MANUAL | SUBSCRIPTION | COURSE | PACK.
  source             String                @default("MANUAL")
  subscriptionId     String?
  subscription       CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  periodStart        DateTime?
  periodEnd          DateTime?
  courseEnrollmentId String?
  courseEnrollment   CourseEnrollment?     @relation(fields: [courseEnrollmentId], references: [id], onDelete: SetNull)
  packPurchaseId     String?
  packPurchase       PackPurchase?         @relation(fields: [packPurchaseId], references: [id], onDelete: SetNull)

  // "Void and reissue": the draft that replaced a voided invoice.
  reissuedFromId String?
  reissuedFrom   Invoice?  @relation("InvoiceReissue", fields: [reissuedFromId], references: [id], onDelete: SetNull)
  reissues       Invoice[] @relation("InvoiceReissue")

  createdByUserId String?

  // The pay link (U13): the SHA-256 of a random token, never the token.
  // Minted when a link is first asked for, replaced by a new one, cleared on
  // void and when the contact is deleted. Null means no link works.
  // `payLinkCreatedAt` is when the current token was made, set and cleared
  // with it (#870): the workspace names the date of a link it can't show.
  payTokenHash     String?   @unique
  payLinkCreatedAt DateTime?

  lines          InvoiceLine[]
  paymentIntents PaymentIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Emails that sent it or reminded about it (D17).
  messages Message[]

  // Account-thread posts that sent it or reminded about it (D17, A13).
  threadMessages CustomerThreadMessage[]

  // A pack bought online (round-2 A11): the pack and its terms — name,
  // credits, validity, price — as they were when the customer started
  // paying, on the source PACK draft. The payment's webhook numbers the
  // invoice and makes the purchase from this, so a pack changed or archived
  // meanwhile still sells on what was shown. Null on every other invoice.
  packTerms Json?

  // A plan joined online from the site's Prices page (round-2 G20): the plan
  // and its terms — name, price, how often, classes a month — as they were
  // when the customer started paying, on a source SUBSCRIPTION draft with no
  // number. The payment's webhook numbers the invoice and starts the
  // subscription from this, as `packTerms` does for a pack. Null on every
  // other invoice.
  planTerms Json?

  @@unique([organizationId, number])
  // One live invoice per subscription period: the renewal job's idempotency
  // key. Voided and fully credited invoices are left out, so such a period
  // can be reissued: a GST business credits an early renewal invoice a
  // cancel or pause drops (D13B, DEC-065) where others void it.
  @@unique([subscriptionId, periodStart], map: "Invoice_one_live_per_period", where: raw("status <> 'VOID' AND status <> 'CREDITED'"))
  // One invoice per order and per booking (ADR-008): the idempotency key of
  // the payment reconciliation. Corrections are other kinds.
  @@unique([orderId], map: "Invoice_one_per_order", where: raw("kind = 'INVOICE'"))
  @@unique([bookingId], map: "Invoice_one_per_booking", where: raw("kind = 'INVOICE'"))
  @@index([organizationId, status])
  @@index([contactId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([bookingId])
  @@index([relatedInvoiceId])
  // The calendar's money, Payments and Invoices layers and Home's week read
  // invoices by when they were paid, and credit notes by when they were
  // issued (round 2, E19, E20).
  @@index([organizationId, status, paidAt])
  @@index([organizationId, paidAt])
  @@index([organizationId, issuedAt])
  // The sweep that discards online pack drafts nobody paid (A11).
  @@index([createdAt], map: "Invoice_open_pack_drafts_idx", where: raw("status = 'DRAFT' AND source = 'PACK'"))
  // The sweep that discards online plan joins nobody paid (G20).
  @@index([createdAt], map: "Invoice_open_plan_joins_idx", where: raw("status = 'DRAFT' AND source = 'SUBSCRIPTION'"))
}

model InvoiceLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position    Int
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  // What the line comes to: quantity × unit price less its discount. On a
  // tax invoice this includes GST (prices include it).
  amount      Decimal @db.Decimal(12, 2)

  // The order discount's share of this line, spread before tax (ADR-008).
  discount Decimal @default(0) @db.Decimal(12, 2)

  // GST, derived from `amount` and frozen (ADR-008). Null on a receipt.
  hsnSac       String?
  gstRate      Decimal? @db.Decimal(5, 2)
  taxableValue Decimal? @db.Decimal(12, 2)
  cgst         Decimal  @default(0) @db.Decimal(12, 2)
  sgst         Decimal  @default(0) @db.Decimal(12, 2)
  igst         Decimal  @default(0) @db.Decimal(12, 2)

  // The order line it bills, so a line refund credits the right line.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([organizationId])
  @@index([orderItemId])
}

// The last invoice number a business issued. Allocated with one
// insert-or-increment statement on the issuing transaction, so numbers never
// repeat and the first invoice needs no row to exist beforehand.
// One counter per business and series (ADR-008): "INV" (the legacy series
// every business had), "RC" / "RCCN" for a counter that never restarts,
// "RC/26-27" / "RCCN/26-27" per financial year, "RC/2026-09" per month.
model InvoiceSequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series         String       @default("INV")
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, series])
}

// The last order number a business issued (P3, DEC-066): one series per
// business, across every storefront, where each storefront used to count
// from ORD-001. Allocated with one insert-or-increment statement in the
// order's own transaction (`nextOrderNumberInTx`, @saroh/database), so two
// orders never take one number and a failed order gives its number back.
// The first order after P3 seeds the row from the business's highest
// ORD-number; the P3 backfill (backfill/order-numbers.ts) seeds it too.
model OrderNumberSequence {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt
}

// A web address a business used to have (DEC-069, L1). After a change the
// old address stays the business's until `reservedUntil`: nobody else can
// claim it, and while `redirectUntil` lasts visitors to it are sent to the
// site's new address. An address the business only reserved at setup, and
// never served a site at, is held with no redirect (`redirectUntil` null).
//
// Expiry is decided when a row is read, so no job clears it: a row past
// `reservedUntil` counts as free, and whoever claims the address next deletes
// it in the claiming transaction (`releaseExpired`, sites/site-address.ts).
// One unique address means one holder at a time.
model AddressReservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address        String       @unique
  // The site the address served, which it forwards to. Null for an address
  // that never served one, or when that site is gone.
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  redirectUntil  DateTime?
  reservedUntil  DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([siteId])
}

// A fixed series of dated sessions on one service, sold once.
model Course {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  currency    String
  seats       Int // never more than the service's capacity
  status      String  @default("DRAFT") // DRAFT | OPEN | CLOSED | ARCHIVED

  sessions    CourseSession[]
  enrollments CourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([serviceId])
}

model CourseSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime

  createdAt DateTime @default(now())

  @@index([courseId, startAt])
  @@index([organizationId])
}

// A person's seat on a course: one booking per remaining session.
model CourseEnrollment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status          String    @default("ACTIVE") // ACTIVE | CANCELLED
  price           Decimal   @db.Decimal(12, 2) // what was charged, which may differ for a late start
  currency        String
  cancelledAt     DateTime?
  createdByUserId String?

  bookings Booking[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One active seat per person per course; cancelling frees it to re-enrol.
  @@unique([courseId, contactId], map: "CourseEnrollment_one_active_per_person", where: raw("status = 'ACTIVE'"))
  @@index([organizationId])
  @@index([contactId])
}

// Prepaid classes: N credits for a price, valid for D days, on named services.
model ClassPack {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  credits      Int
  validityDays Int
  price        Decimal @db.Decimal(12, 2)
  currency     String
  status       String  @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED (E14)

  services  ClassPackService[]
  purchases PackPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Drafts (round-2 E14, `common/drafts/`, as a plan's in D5). A live pack's
  // unpublished changes: only the fields that differ from the published
  // columns (and services), which sales keep reading. Null when there are
  // none. A DRAFT pack writes its columns directly and never holds a set.
  pendingChanges   Json?
  // When the pending set (or a draft's columns) was last saved. Null once
  // published or discarded.
  pendingChangedAt DateTime?
  // Bumped by every draft save, publish, discard and pack write, so an
  // editor holding an older revision is refused instead of overwriting (#285).
  draftRevision    Int       @default(0)
  // Who moved the revision last, and when: named in a stale editor's 409.
  // No foreign key: a teammate who leaves keeps their saves; a Saroh
  // operator's is never stored (DEC-035), so a time with no person is theirs.
  revisedAt        DateTime?
  revisedById      String?

  // Round-2 E13 (defaults 45, 46). CLASSES pays for classes (capacity > 1),
  // ONE_TO_ONE for one-to-one sessions (capacity 1); locked once sold.
  kind          String      @default("CLASSES") // CLASSES | ONE_TO_ONE
  // Sold only to someone who has never bought a pack of this kind.
  firstPackOnly Boolean     @default(false)
  events        PackEvent[]

  // The composite key a pack event points at, so an event can't name
  // another business's pack.
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ClassPackService {
  packId         String
  pack           ClassPack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([packId, serviceId])
  @@index([serviceId])
  @@index([organizationId])
}

// A pack sold to a person. The balance is derived: credits minus redemptions
// that have not been reversed.
model PackPurchase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packId         String
  // Packs are archived, never deleted, while anyone holds one.
  pack           ClassPack    @relation(fields: [packId], references: [id], onDelete: Restrict)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Terms at the moment of sale.
  credits   Int
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  expiresAt DateTime

  createdByUserId String?

  redemptions PackRedemption[]
  invoices    Invoice[]

  createdAt DateTime @default(now())

  // How the sale was paid (round-2 E13): CASH | UPI | CARD | BANK | ONLINE |
  // NONE. A record of what the desk took, never a restriction on how anyone
  // pays (DEC-059). Null: sold before it was recorded.
  paidBy     String?
  extensions PackExtension[]
  events     PackEvent[]

  // The composite key an extension points at (one business's purchase).
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([contactId])
  @@index([packId])
}

// A holder's pack given more days (round-2 E13, default 46): at most 30 at a
// time, moving `PackPurchase.expiresAt`. Append-only.
model PackExtension {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String
  purchase       PackPurchase @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Cascade)

  days          Int // 1–30, checked in the migration too
  reason        String
  // The use-by date before and after.
  expiresBefore DateTime
  expiresAfter  DateTime
  // Who gave it. Not a foreign key: a teammate who leaves keeps their
  // extensions. Null for a Saroh operator, never stored (DEC-035).
  byUserId      String?

  createdAt DateTime @default(now())

  @@index([organizationId, purchaseId])
}

// A class pack's history (round-2 E13): created, published, changed, sold,
// extended, archived, restored. Append-only, written in the change's own
// transaction (PACK_EVENT_KINDS in class-packs/pack-events.ts).
model PackEvent {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packId         String
  pack           ClassPack     @relation(fields: [packId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // The sale an event is about (SOLD, EXTENDED). Kept when the purchase
  // goes with its contact, as history without a name.
  purchaseId     String?
  purchase       PackPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  kind        String
  // TEAM | CUSTOMER | OPERATOR (`subscriptions/event-actors.ts`). An
  // operator's reads as Saroh support (DEC-035).
  actorKind   String
  // Not a foreign key: someone who leaves keeps their history.
  actorUserId String?
  // What happened, by kind: `{ field: [before, after] }` for a change; the
  // price and how it was paid for a sale; the days, reason and use-by dates
  // for an extension.
  details     Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, packId, createdAt])
  @@index([purchaseId])
}

// One credit spent on one booking. Cancelling the booking reverses it.
model PackRedemption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String
  purchase       PackPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([purchaseId])
}

// ---------------------------------------------------------------------------
// Customer accounts on merchant sites (ADR-011, DEC-037, DEC-049)
// ---------------------------------------------------------------------------

/// How a contact's email came to be verified (DEC-049).
enum ContactEmailVerifiedVia {
  SIGN_IN_CODE
  ORDER_CONFIRMATION
  BOOKING_CONFIRMATION
  STAFF_CONFIRMED
}

enum CustomerAccountStatus {
  ACTIVE
  BLOCKED
  // Retired by a contact merge (C9): the row stays, pointing at the survivor,
  // and keeps its email reserved so a later sign-in can't recreate the pair.
  MERGED
  // Privacy removal (C11): frees the email and the contact.
  REMOVED
}

/// A business's customer, signed in on that business's site with an email
/// code. Belongs to one business, is exactly one Contact, and is never a
/// Better Auth `User` (ADR-011).
model CustomerAccount {
  // Places in line the customer joined from this account (A12).
  waitlistEntries ClassWaitlistEntry[]

  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Deleting the contact takes the account and its sessions with it; privacy
  // removal (C11) is the normal path and this the backstop.
  contactId String
  contact   Contact @relation("CustomerAccountContact", fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // The verified sign-in email, lower-cased and trimmed. The contact's own
  // email may be a reserved placeholder (contacts/contact-email.ts) when
  // another contact already held this one (DEC-049).
  email           String
  emailVerifiedAt DateTime

  status CustomerAccountStatus @default(ACTIVE)

  // The survivor's account, when a merge retired this one (MERGED).
  mergedIntoId String?
  mergedInto   CustomerAccount?  @relation("CustomerAccountMerge", fields: [mergedIntoId, organizationId], references: [id, organizationId], onDelete: Cascade)
  mergedFrom   CustomerAccount[] @relation("CustomerAccountMerge")

  // The contact staff said "This isn't them" about (A4), so duplicate
  // suggestions never pair the two again.
  unlinkedFromContactId String?
  unlinkedFromContact   Contact? @relation("CustomerAccountUnlinkedFrom", fields: [unlinkedFromContactId], references: [id], onDelete: SetNull)

  linkedAt       DateTime  @default(now())
  lastSignedInAt DateTime?

  sessions CustomerSession[]

  // Bookings made signed in (A9).
  bookings Booking[]
  // Orders placed signed in (A7).
  orders   Order[]

  // Messages the customer wrote to the business from this account (A13).
  threadMessages CustomerThreadMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One live account per email per business. A MERGED account keeps its
  // email reserved; only REMOVED frees it. The same email at two businesses
  // is two accounts.
  @@unique([organizationId, email], map: "CustomerAccount_one_live_per_email", where: raw("status <> 'REMOVED'"))
  // One live account per contact.
  @@unique([contactId], map: "CustomerAccount_one_live_per_contact", where: raw("status <> 'REMOVED'"))
  // The target of (accountId, organizationId) and merge foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([contactId])
  @@index([mergedIntoId])
  @@index([unlinkedFromContactId])
}

/// A six-digit code sent to a destination to sign in on a business's site.
/// Only keyed hashes are stored, of the destination and of the code, so a
/// database read reveals neither. The limits count these rows (A2).
model CustomerSignInCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  destinationHash String
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  consumedAt      DateTime?
  // Set when a newer code for the same destination replaces this one.
  retiredAt       DateTime?
  // The visitor's relayed address, hashed (hashClientIp).
  clientHash      String?
  // The destination had no ACTIVE or MERGED account when the code was asked
  // for: only these count against the business's hourly ceiling.
  newDestination  Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId, destinationHash, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

/// A signed-in customer's session on one site. The token is 256 random bits,
/// shown once and stored only as its SHA-256.
model CustomerSession {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        CustomerAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)
  siteId         String
  site           Site            @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  // A short summary of the browser ("Chrome on Android"), never the raw header.
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([accountId])
  @@index([siteId])
  @@index([expiresAt])
}

/// Who wrote a thread message (A13): the customer from their account, a
/// staff member from the workspace, or Saroh itself for the business (an
/// invoice sent, and later A14's order and booking notices).
enum CustomerThreadAuthor {
  CUSTOMER
  STAFF
  SYSTEM
}

/// A customer's one message thread with the business (round-2 A13, R14,
/// default 77): the customer writes from their account on the business's
/// site, and the team answers in the workspace. Rooted on the Contact, so a
/// merge absorbs the other's thread (C9) and a removal deletes it (C11).
model CustomerThread {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // The newest message, for the order threads are listed in.
  lastMessageAt  DateTime  @default(now())
  // When each side last opened it: a message from the other side after this
  // is unread, and opening clears the dot.
  customerReadAt DateTime?
  staffReadAt    DateTime?

  messages CustomerThreadMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One thread per customer.
  @@unique([contactId, organizationId])
  // The target of (threadId, organizationId) foreign keys.
  @@unique([id, organizationId])
  @@index([organizationId, lastMessageAt])
}

/// One message in a customer's thread (A13). Plain text, never rendered as
/// HTML.
model CustomerThreadMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  threadId String
  thread   CustomerThread @relation(fields: [threadId, organizationId], references: [id, organizationId], onDelete: Cascade)

  author CustomerThreadAuthor
  body   String

  // The account that wrote it (CUSTOMER). "This isn't them" moves the
  // messages the account wrote since it linked (unlink-plan.ts).
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  // The staff member who wrote it (STAFF), or sent the invoice (SYSTEM).
  authorUserId      String?

  // What a SYSTEM message says happened, and the invoice it is about: D17's
  // INVOICE_SENT | INVOICE_REMINDER. The invoice's once-sent and
  // one-reminder-a-day rules count these beside its emails.
  event     String?
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([threadId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([invoiceId, createdAt])
}

/// An autopay mandate at the business's own payment provider (round-2 D11,
/// DEC-038): the customer's authorisation for the provider to charge one
/// subscription's renewals. Saroh keeps only the provider's ids and what it
/// returns as displayable; card and bank details never reach Saroh.
///
/// It belongs to exactly one subscription and ends with it (D20): every
/// move of that subscription to CANCELLED, a privacy removal of the contact
/// and a merge that retires the contact cancel it at the provider through
/// `payments/mandates.service.ts` (`cancelFor`, or `cancelMandatesInTx`
/// with the `mandate.cancel` job). It is marked CANCELLED before the
/// provider answers, so it is never charged again; `cancelConfirmedAt` is
/// set once the provider has said so (null: "being confirmed", DEC-026).
///
/// D20 built the smallest piece of D11's model it needs; D11 adds the
/// set-up, the limit and the charge columns.
model PaymentMandate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)

  subscriptionId String
  subscription   CustomerSubscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // The MerchantPaymentProvider it was set up with: "RAZORPAY" | "CASHFREE".
  provider           String
  // The provider's customer and mandate (or token) ids. Null while a set-up
  // hasn't reached the provider; such a mandate is cancelled without a call.
  providerCustomerId String?
  providerMandateId  String?
  // Only what the provider returns as displayable (a masked handle, the
  // last four digits). Cleared by a privacy removal (C11).
  displayHint        String?

  // PENDING | ACTIVE | PAUSED | CANCELLED | FAILED
  status            String    @default("PENDING")
  activatedAt       DateTime?
  cancelledAt       DateTime?
  // CUSTOMER | STAFF | SUBSCRIPTION_ENDED | PRIVACY_REMOVAL | MERGED | PROVIDER | REPLACED
  cancelReason      String?
  // When the provider confirmed the cancel. Null on a CANCELLED row: Saroh
  // stopped charging it, and is still confirming with the provider.
  cancelConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set-up, status and limit (D11). What the customer authorised: the
  // method they picked (UPI | CARD | EMANDATE; never a card or bank
  // detail), the most one charge may take, in minor units, and how often.
  method              String?
  maxAmountCents      Int?
  currency            String          @default("INR")
  // AS_PRESENTED: Saroh says when to charge (renewal dates move).
  frequency           String?
  // The provider's set-up object (Razorpay: the registration link or the
  // authorisation order), so a webhook finds the row before the token is
  // named; and when an unanswered set-up stops being worth waiting for.
  setupReference      String?
  setupExpiresAt      DateTime?
  // When the provider says the authority ends.
  expiresAt           DateTime?
  pausedAt            DateTime?
  failedAt            DateTime?
  // The provider's reason code for a FAILED set-up, sanitised; never shown raw.
  failureReason       String?
  // Charges taken through it (D13).
  intents             PaymentIntent[] @relation("MandateCharges")
  // Where the customer set it up (D12): PAY_LINK | PRICES | ACCOUNT, and
  // the site account that did, so the log can say "Autopay set up by
  // ‹name›, from the Prices page". Null on a mandate set up by staff.
  setupSource         String?
  setupAccountId      String?
  // The ₹1 check taken to authorise it when nothing was owed (DEC-064).
  authorisationChecks PaymentIntent[] @relation("MandateAuthorisationCheck")

  // A subscription has at most one ACTIVE mandate.
  @@unique([subscriptionId], map: "PaymentMandate_one_active_per_subscription", where: raw("status = 'ACTIVE'"))
  @@unique([organizationId, provider, providerMandateId])
  @@index([organizationId])
  @@index([organizationId, subscriptionId, status])
  @@index([organizationId, contactId, status])
  @@index([organizationId, provider, setupReference])
}

/// One notice about a customer's own booking or order, handled once
/// (round-2 A14, R15): the ledger that makes `booking.notify` and
/// `customer.notify` idempotent per event. It is written first, on the
/// handler's transaction, with what the notice became: a SYSTEM message in
/// the customer's thread, a transactional email (`Message`), and, for what
/// the customer did themselves, a notice to the team (`Notification`).
/// The send job reads it back to stamp a confirmation's email verified
/// (DEC-049), and an order step's Undo reads it to know whether the
/// customer was already told.
model CustomerNotice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The event it is about, unique per business ("booking:<eventId>",
  // "order:<orderEventId>", "team:booking:<eventId>").
  eventKey String
  // BOOKING_CONFIRMED | BOOKING_MOVED | BOOKING_CANCELLED | ORDER_READY |
  // ORDER_HANDED_OVER | WAITLIST_OFFER | TEAM_TOLD
  kind     String

  // What it was about and what it became. Informational, no FK, like
  // Notification.leadId: the record outlives nothing it could dangle from.
  contactId       String?
  bookingId       String?
  orderId         String?
  threadMessageId String?
  messageId       String?
  notificationId  String?

  createdAt DateTime @default(now())

  @@unique([organizationId, eventKey])
  @@index([organizationId])
  @@index([messageId])
  // One booking's notices: Saroh's cap of emails per booking a day (DEC-086).
  @@index([organizationId, bookingId, createdAt])
}

// ============================================================================
// BULK KITCHEN MOVES (round-2 B6)
// ============================================================================

enum OrderStageBatchStatus {
  HELD
  COMMITTED
  CANCELLED
}

/// Many orders moved a step at once from the Orders list (round-2 B6, R11).
/// The batch is written HELD with its lines and its commit job ten seconds
/// on, in one transaction, so a closed tab loses nothing; "Send now" or the
/// job commits it, each line in its own order-locked transaction through
/// the single-order stage write. `id` is the client's `batchId`: a retry of
/// the same id returns what is stored and never moves anything twice.
model OrderStageBatch {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status      OrderStageBatchStatus @default(HELD)
  // When the job commits it, unless "Send now" or "Undo all" came first.
  commitAt    DateTime
  // Who asked. Not a foreign key, like OrderEvent.actorUserId: the steps
  // are written in their name.
  actorUserId String

  committedAt DateTime?
  cancelledAt DateTime?
  // "Undo all" after the commit.
  undoneAt    DateTime?

  createdAt DateTime @default(now())

  lines OrderStageBatchLine[]

  @@index([organizationId])
}

/// One order in a batch: the step it was asked to take from where the list
/// showed it, and what became of it. `result` is null until the commit
/// reaches it: MOVED | MOVED_BY_SOMEONE_ELSE | NOT_FOUND | REFUSED |
/// CANCELLED (Undo all reached it first). `undoResult`: UNDONE | REFUSED.
model OrderStageBatchLine {
  id             String @id @default(cuid())
  organizationId String

  batchId String
  batch   OrderStageBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // As the client sent it. Not a foreign key: an id from another business
  // is recorded as NOT_FOUND, and moves nothing.
  orderId   String
  position  Int
  fromStage OrderStage
  toStage   OrderStage

  result       String?
  reason       String?
  stageEventId String?

  undoResult  String?
  undoReason  String?
  undoEventId String?
  // The customer had already been told when it was undone (A14).
  told        Boolean?

  @@unique([batchId, orderId])
  @@index([organizationId])
}

/// Where a place in line for a full class stands (round-2 A12).
enum ClassWaitlistStatus {
  // In line.
  WAITING
  // A freed place is held for them until `offeredUntil`.
  OFFERED
  // They took the place: `bookingId` is the booking.
  ACCEPTED
  // The held place ran out unanswered, and went to the next in line.
  EXPIRED
  // They left the line themselves.
  LEFT
  // The class was cancelled, or its service taken off sale.
  CLOSED
}

/// A place in line for one session of a full class (round-2 A12, R13,
/// default 9). A session is a service and its start: classes have no row of
/// their own. When a place frees (a cancel, a move away, a hold let go or
/// run out), `waitlist.offer` holds it for the first WAITING entry until
/// the earlier of 2 hours from then and 1 hour before the class, and tells
/// them (`customer.notify`, WAITLIST_OFFER). A held place counts as taken
/// in every capacity count (`bookings/held-seats.ts`) except that person's
/// own booking of it, which accepts the offer. Expiry offers the next.
///
/// Rooted on the Contact: a merge keeps the better place of two in one
/// class (C9), and a removal deletes them (C11).
model ClassWaitlistEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // The session: the class's start and end.
  startAt   DateTime
  endAt     DateTime

  contactId String
  contact   Contact @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // The account that joined, from the business's site. "This isn't them"
  // moves the entries the account made since it linked (unlink-plan.ts).
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  // Their place in the session's line: first come, first offered.
  position Int
  status   ClassWaitlistStatus @default(WAITING)

  // While OFFERED: when the place was held for them, and until when.
  offeredAt    DateTime?
  offeredUntil DateTime?
  // When it stopped being live (accepted, expired, left or closed); the
  // cleanup deletes it 30 days on (default 74).
  closedAt     DateTime?
  // The booking that took the place (ACCEPTED). Informational, no FK.
  bookingId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One live place per person per session; one who left or let an offer
  // run out may join again, at the back.
  @@unique([serviceId, startAt, contactId], map: "ClassWaitlistEntry_one_live_per_session", where: raw("status = ANY (ARRAY['WAITING'::\"ClassWaitlistStatus\", 'OFFERED'::\"ClassWaitlistStatus\"])"))
  @@index([organizationId])
  @@index([serviceId, startAt, status, position])
  @@index([status, offeredUntil])
  @@index([contactId, status])
  @@index([customerAccountId, createdAt])
  @@index([closedAt])
}

// ── Pricing catalogue (plan 2026-09-29 U1, KTD-1…6) ─────────────────────────
// Saroh's own plans and modules, edited in admin.saroh.in › Plans & modules.
// The catalogue is GLOBAL (every business is offered the same one), so these
// tables carry no organizationId except the two that record what one business
// bought or redeemed, which have the org_isolation policy.

// PricingCatalogVersion — one published catalogue snapshot, immutable. The
// live version is the newest whose `goLiveAt` has passed, resolved at read
// time; a later `goLiveAt` is a scheduled version. `catalog` is validated by
// `@saroh/pricing-catalog` `catalogSchema`; `changes` is that package's
// `diff()` against the version before it (the change log).
model PricingCatalogVersion {
  id      String @id @default(cuid())
  version Int    @unique

  catalog  Json
  goLiveAt DateTime
  // "keep" leaves businesses on their version; "move" schedules each
  // subscription's move (Subscription.pendingPlanId).
  policy   String   @default("keep")
  note     String   @default("")
  changes  Json     @default("[]")

  // Null for the version the migration installed.
  publishedByUserId String?

  createdAt DateTime @default(now())

  @@index([goLiveAt])
}

// PricingCatalogDraft — the one shared draft (KTD-3), a row keyed "shared".
// `revision` goes up on every save; a save naming an older revision is
// refused (409) with who saved since. Deleted on publish or discard.
model PricingCatalogDraft {
  id String @id @default("shared")

  catalog     Json
  revision    Int  @default(0)
  // The live version the draft was started from.
  baseVersion Int?

  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PricingCoupon — a discount code, outside versions: it applies the moment
// it is saved (KTD-5). `code` is stored upper-cased (CHECK
// `PricingCoupon_code_upper`), so the unique index refuses "abc" beside
// "ABC". A coupon that has been redeemed is archived, never deleted (its
// redemptions are kept, RESTRICT).
model PricingCoupon {
  id   String @id @default(cuid())
  code String @unique

  // Taken off each month for `months` months (monthly), or off the first
  // yearly charge as `months` months' worth, capped at that charge (U16).
  discountPaise   Int
  months          Int
  // Catalogue plan ids it applies to.
  planIds         String[]
  // The Razorpay Offer that takes the same discount off on Razorpay's side
  // (`offer_` + 14 letters or digits; the column's CHECK). Made by hand in
  // the Razorpay Dashboard, which offers no API to make one. Without it a
  // Razorpay checkout refuses the coupon. Changeable, unlike the code.
  razorpayOfferId String?

  active         Boolean   @default(true)
  maxRedemptions Int
  expiresAt      DateTime?
  archivedAt     DateTime?

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PricingCouponRedemption[]
  checkouts   BillingCheckout[]
}

// PricingCouponRedemption — one business used one coupon. Written when the
// payment webhook confirms the charge, never at checkout start (U16). One
// use per business per coupon.
model PricingCouponRedemption {
  id String @id @default(cuid())

  couponId String
  coupon   PricingCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // What it took off, as charged.
  discountPaise Int

  createdAt DateTime @default(now())

  @@unique([couponId, organizationId])
  @@index([organizationId])
  @@index([subscriptionId])
}

// SubscriptionAddon — add-ons a business bought on its Saroh subscription
// (KTD-5). `addonId` names an add-on in the catalogue version the
// subscription's plan belongs to; the definition (price, pack size) is read
// from that version, never the live one.
model SubscriptionAddon {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  addonId  String
  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, addonId])
  @@index([organizationId])
}

// An add-on owed for one period, put on the provider subscription's next
// charge (pricing catalogue U16). Add-ons are charged after the period they
// cover: a row is written at the start of each period for what is held then
// (from the day of purchase, prorated, for one bought mid-period), sent to
// the provider as a one-off item on its next charge (`billing.addons.sync`),
// and becomes a line on Saroh's invoice for that charge. Never edited once
// sent; a row the provider never took moves to the next charge.
model SubscriptionAddonCharge {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  addonId     String
  // The invoice line's words, quantity and price per unit before GST.
  description String
  quantity    Int
  unitPaise   Int

  // The days it pays for.
  periodStart DateTime
  periodEnd   DateTime
  // The provider charge it rides on: the provider subscription's next one.
  chargeAt    DateTime

  provider               String
  providerSubscriptionId String
  // The provider's id for the item, once sent.
  providerChargeId       String?

  status    String  @default("QUEUED") // QUEUED | SENT | INVOICED | DROPPED
  // Saroh's invoice it became a line on.
  invoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([subscriptionId, status])
  @@index([provider, providerSubscriptionId, status])
}

// PricingProviderPlan — the billing provider's plan for one billable `Plan`
// row (a catalogue plan × version × cycle), kept in step by an outbox job
// with retries (RECOMMENDATIONS 5). A version can't go live, and no move is
// applied, until its paid rows are SYNCED. Free rows need none.
model PricingProviderPlan {
  id String @id @default(cuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  provider       String // "RAZORPAY" | "CASHFREE"
  providerPlanId String?
  status         String    @default("PENDING") // PENDING | SYNCED | FAILED
  attempts       Int       @default(0)
  lastError      String?
  syncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, provider])
  @@unique([provider, providerPlanId])
  @@index([status])
}

// BillingCheckout — one attempt to put a business on a paid catalogue plan
// (pricing catalogue U15). Saroh asks its own billing provider for a new
// provider subscription on the plan's provider plan; the business authorises
// it on the provider's page, and the provider's webhook completes it here.
// The amount is always Saroh's: the plan row's price, and for an upgrade the
// difference for the rest of the period, both worked out on the server.
//
// - NEW: on the plan from the moment it's authorised (coming from Free, a
//   cancelled plan or one Saroh doesn't bill through a provider).
// - UPGRADE: on the plan at once; the difference for the rest of the period
//   is charged at authorisation and the plan's own charges start at `startAt`
//   (the old period's end). The old provider subscription is cancelled.
// - SCHEDULED: authorised now, on the plan from `startAt` (a cheaper plan, a
//   cycle change, or a move the business must authorise again, OQ-6). It
//   stays SCHEDULED until then, as the subscription's pending move.
//
// OPEN waits for the authorisation and lapses at `expiresAt`. One OPEN and
// one SCHEDULED per business at most.
model BillingCheckout {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])
  cycle  String // "month" | "year"
  // NEW | UPGRADE | SCHEDULED | TRIAL (U16: on the plan once authorised, its
  // first charge at `startAt`, the trial's end). A renewal of the plan it's
  // on (DEC-093) is a SCHEDULED one for the same plan.
  kind   String
  status String @default("OPEN") // OPEN | SCHEDULED | COMPLETED | CANCELLED

  // The provider's subscription; for a yearly plan paid once (DEC-093), its
  // order, with `providerPlanId` "one-time".
  provider               String
  providerSubscriptionId String
  providerPlanId         String
  providerCustomerId     String?

  // The plan's recurring price before GST, in paise, as it was quoted.
  pricePaise        Int
  // Charged at authorisation, before GST: an UPGRADE's difference for the
  // rest of the period, or a TRIAL's nominal first month (DEC-093); zero
  // otherwise.
  chargeNowPaise    Int @default(0)
  chargeNowGstPaise Int @default(0)

  // A coupon (U16): `discountPaise` off each of the first `discountCharges`
  // charges of the plan, before GST, as quoted. Written to
  // `PricingCouponRedemption` when the first discounted charge is paid.
  couponId        String?
  coupon          PricingCoupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)
  discountPaise   Int            @default(0)
  discountCharges Int            @default(0)

  // When the plan's own charges start; null for NEW (at authorisation), the
  // trial's end for TRIAL.
  startAt     DateTime?
  expiresAt   DateTime
  completedAt DateTime?
  endedReason String?

  // Who Saroh's invoice is billed to (U17), as given at checkout: the GST
  // state code ("29") that sets the place of supply, and the business's
  // GSTIN when it has one. Null: the business profile's at invoice time.
  billToState String?
  billToGstin String?

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@unique([organizationId, status], map: "BillingCheckout_one_live_per_org", where: raw("status = 'OPEN' OR status = 'SCHEDULED'"))
  @@index([organizationId])
  @@index([planId])
  @@index([status, expiresAt])
  @@index([couponId])
}

// Saroh's own GST invoice to a business, for a charge Saroh took for its
// plan (pricing catalogue U17). Written by the billing webhook in the same
// transaction as the charge it records, once per charge (`chargeKey`), and
// never changed. Seller and buyer are copied onto it: the paper reads the
// same whatever the settings say later. Plan and checkout ids are kept as
// plain columns, not keys: the invoice outlives the rows it names.
model SarohInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "SRH/26-27/00001": the series (prefix and financial year) and its count.
  number    String @unique
  series    String
  // One invoice per charge: "period:<provider>:<subscription>:<end>" for a
  // plan period, "upgrade:<checkout>" for an upgrade's difference.
  chargeKey String @unique
  // NEW | UPGRADE | SCHEDULED | RENEWAL: what was charged.
  source    String

  provider               String
  providerSubscriptionId String?
  providerEventId        String
  providerPaymentId      String?
  checkoutId             String?
  planId                 String?
  planName               String
  cycle                  String // "month" | "year"
  periodStart            DateTime?
  periodEnd              DateTime?

  issuedAt DateTime
  currency String   @default("INR")

  sellerName      String
  sellerLegalName String?
  sellerGstin     String?
  sellerState     String?
  sellerAddress   String?
  sellerEmail     String?

  billToName    String
  billToEmail   String?
  billToAddress String?
  billToState   String?
  billToGstin   String?

  // GST state code; INTRA (CGST + SGST) or INTER (IGST).
  placeOfSupply String?
  taxType       String

  // Integer paise (KTD-18). Before discount, the discount, what is taxed,
  // its GST and what was charged.
  subtotalPaise Int
  discountPaise Int @default(0)
  taxablePaise  Int
  cgstPaise     Int
  sgstPaise     Int
  igstPaise     Int
  taxPaise      Int
  totalPaise    Int

  // When its email left; null until then (the `billing.email` job).
  emailedAt DateTime?

  createdAt DateTime @default(now())

  lines SarohInvoiceLine[]

  @@unique([id, organizationId])
  @@index([organizationId, issuedAt])
}

// One line of a Saroh invoice (U17): the plan's period, an upgrade's
// difference, and later an add-on (U16). GST is worked out per line, on the
// line's amount after its discount, rounded half-up once (KTD-18).
model SarohInvoiceLine {
  id             String       @id @default(cuid())
  invoiceId      String
  organizationId String
  invoice        SarohInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  position      Int
  description   String
  sac           String?
  quantity      Int     @default(1)
  unitPaise     Int
  discountPaise Int     @default(0)
  taxablePaise  Int
  gstRateBps    Int
  cgstPaise     Int
  sgstPaise     Int
  igstPaise     Int
  taxPaise      Int
  amountPaise   Int

  @@unique([invoiceId, position])
  @@index([organizationId])
}

// The count behind each Saroh invoice series (U17): one row per prefix and
// financial year, taken in the invoice's own transaction, so a rolled-back
// charge leaves no gap. Saroh's, not a business's.
model SarohInvoiceSequence {
  series    String   @id
  last      Int
  updatedAt DateTime @updatedAt
}
