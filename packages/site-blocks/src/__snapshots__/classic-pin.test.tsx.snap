                scroll-margin-top: 4.5rem;
            }
            :root [data-site-section] .prose dt {
                color: hsl(var(--site-fg));
                font-family: var(--site-font-heading);
            }
            :root [data-site-section] .prose dd {
                color: hsl(var(--site-fg) / 0.8);
            }
            :root [data-site-section] [data-site-facts="labels"] dt {
                margin-top: 1.25em;
                color: hsl(var(--site-muted));
                font-family: var(--site-font-body);
                font-size: 0.78rem;
                font-weight: 500;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }
            :root [data-site-section] [data-site-facts="labels"] dd {
                margin-top: 0.25em;
                padding-inline-start: 0;
                color: hsl(var(--site-fg));
            }
            :root {
                --site-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
                --site-section-space: var(--site-section-padding);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h1, h2, h3, h4) {
                font-family: var(--site-font-heading);
                text-wrap: balance;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h1 {
                letter-spacing: -0.03em;
                line-height: 1.05;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h2 {
                letter-spacing: -0.02em;
                line-height: 1.15;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h3, h4) {
                letter-spacing: -0.01em;
                line-height: 1.25;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) p {
                text-wrap: pretty;
            }
            :root [data-site-section] .prose {
                --tw-prose-body: hsl(var(--site-body));
                --tw-prose-headings: hsl(var(--site-fg));
                --tw-prose-lead: hsl(var(--site-fg));
                --tw-prose-links: hsl(var(--site-accent));
                --tw-prose-bold: hsl(var(--site-fg));
                --tw-prose-counters: hsl(var(--site-muted));
                --tw-prose-bullets: hsl(var(--site-muted));
                --tw-prose-hr: hsl(var(--site-border));
                --tw-prose-quotes: hsl(var(--site-fg));
                --tw-prose-quote-borders: hsl(var(--site-accent));
                --tw-prose-captions: hsl(var(--site-muted));
                --tw-prose-code: hsl(var(--site-fg));
                --tw-prose-th-borders: hsl(var(--site-border));
                --tw-prose-td-borders: hsl(var(--site-border));
            }
            :root [data-site-section] .prose blockquote {
                border-inline-start-width: 2px;
                font-style: normal;
                font-weight: 500;
                quotes: none;
            }
            :root [data-site-section] .prose blockquote p::before,
            :root [data-site-section] .prose blockquote p::after {
                content: none;
            }
            :root [data-site-section] .prose a {
                text-decoration-line: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 0.2em;
            }
            :root [data-site-section] .prose a:hover {
                text-decoration-thickness: 2px;
            }
            :root ::selection {
                background-color: hsl(var(--site-accent));
                color: hsl(var(--site-accent-fg));
            }
            :root [data-site-ground="hero"] ::selection {
                background-color: hsl(var(--site-hero-fg));
                color: hsl(var(--site-hero-bg));
            }
            :root [data-site-ground="cta"] ::selection {
                background-color: hsl(var(--site-cta-fg));
                color: hsl(var(--site-cta-bg));
            }
            :root [data-site-footer] ::selection {
                background-color: hsl(var(--site-footer-fg));
                color: hsl(var(--site-footer-bg));
            }
            :root [data-site-section][data-site-band] {
                --site-section-padding: calc(var(--site-section-space) * 1.2);
            }
            :root [data-site-section]:not([data-site-band]):not(:empty):not(:has(> [data-site-ground])) + [data-site-section]:not([data-site-band]) > [class*="py-[var(--site-section-padding)]"]:not([data-site-ground]) {
                padding-top: calc(var(--site-section-padding) * 0.5);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-page])) :where(a, button, summary):focus-visible {
                outline: 2px solid hsl(var(--site-fg));
                outline-offset: 2px;
            }
            :where(:root [data-site-ground="hero"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-hero-fg));
            }
            :where(:root [data-site-ground="cta"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-cta-fg));
            }
            :where(:root [data-site-ground="photo"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-bg));
            }
            :where(:root [data-site-footer]) :where(a, button, summary):focus-visible {
                outline: 2px solid hsl(var(--site-footer-fg));
                outline-offset: 2px;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :where(button:disabled, [aria-disabled="true"]) {
                cursor: default;
            }
            @media (prefers-reduced-motion: no-preference) {
                :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :where(a, button, summary) {
                    transition: color 150ms var(--site-ease), background-color 150ms var(--site-ease), border-color 150ms var(--site-ease), opacity 150ms var(--site-ease), text-decoration-color 150ms var(--site-ease);
                }
            }
            @keyframes site-rise {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }
            }
            @keyframes site-menu-in {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }
            }
            @keyframes site-fade-in {
                from {
                    opacity: 0;
                }
            }
            @media (prefers-reduced-motion: no-preference) {
                :root [data-site-menu-panel] {
                    animation: site-menu-in 180ms var(--site-ease) both;
                }
                :root [data-site-menu-scrim] {
                    animation: site-fade-in 180ms var(--site-ease) both;
                }
            }
            @media screen and (prefers-reduced-motion: no-preference) {
                @supports (animation-timeline: view()) and (animation-range: entry 0% entry 180px) {
                    :root [data-site-section] > * {
                        animation: site-rise var(--site-ease) backwards;
                        animation-timeline: view();
                        animation-range: entry 0% entry 180px;
                    }
                }
            }
        </style>"
`;

