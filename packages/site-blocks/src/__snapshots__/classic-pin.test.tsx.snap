exports[`Classic's pages are pinned > salon / 1`] = `"<div data-site-section=""><section data-site-ground="hero" class="bg-site-hero-bg text-site-hero-fg w-full py-[var(--site-section-padding)]"><div class="mx-auto grid w-full max-w-screen-xl items-start gap-[22px] px-5 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))] sm:px-[var(--site-page-margin)]"><div class="pt-2"><h1 class="font-site-heading text-balance text-[clamp(calc(38px*var(--site-heading-scale)),9vw,calc(64px*var(--site-heading-scale)))] font-semibold leading-[1.02] tracking-[-0.035em]">Book your chair. Walk in fresh.</h1><p class="mt-3.5 max-w-[44ch] text-pretty text-base leading-[1.55] opacity-75">What Sample Business does, and when to come in.</p></div><div class="bg-site-surface border-site-border text-site-fg rounded-[calc(var(--site-radius)+16px)] border px-4 pb-2.5 pt-4 shadow-[0_10px_30px_hsl(var(--site-fg)/0.06)]"><div class="mb-1.5 flex items-baseline gap-2"><h2 data-site-title="" class="font-site-heading flex-1 text-[19px] font-semibold tracking-[-0.01em]">On today</h2></div><p class="border-site-border text-site-muted border-t px-1 py-3 text-[13.5px]">Loading today&#x27;s times…</p></div></div></section></div><div id="stylists" data-site-section=""><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading mb-5 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Who you&#x27;ll be with</h2><ul class="grid grid-cols-2 gap-x-[var(--site-grid-gap)] gap-y-8 lg:grid-cols-4"><li class="min-w-0"><h3 class="font-site-heading text-[calc(1.0625rem*var(--site-heading-scale))] font-semibold leading-tight [overflow-wrap:anywhere]">Your first stylist</h3><p class="text-site-muted mt-1 text-[12.5px] font-semibold uppercase tracking-[0.06em]">What they do best — cuts, colour, bridal</p><p class="text-site-body mt-2 whitespace-pre-line text-[13.5px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Say what they are best at, how long they have done it, and the days they are in.</p></li><li class="min-w-0"><h3 class="font-site-heading text-[calc(1.0625rem*var(--site-heading-scale))] font-semibold leading-tight [overflow-wrap:anywhere]">Your second stylist</h3><p class="text-site-muted mt-1 text-[12.5px] font-semibold uppercase tracking-[0.06em]">What they do best</p><p class="text-site-body mt-2 whitespace-pre-line text-[13.5px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Add one of these for each stylist, or remove the ones you do not need.</p></li><li class="min-w-0"><h3 class="font-site-heading text-[calc(1.0625rem*var(--site-heading-scale))] font-semibold leading-tight [overflow-wrap:anywhere]">Your third stylist</h3><p class="text-site-muted mt-1 text-[12.5px] font-semibold uppercase tracking-[0.06em]">What they do best</p><p class="text-site-body mt-2 whitespace-pre-line text-[13.5px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. If it is just you, keep only the first and make it you.</p></li></ul></section></div><div id="before" data-site-section="" data-site-band="accent"><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Before you come in</h2><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 sm:gap-x-10"><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Running late</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Say how long a chair is held for someone running late, and what happens after that.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Colour and patch tests</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Say whether a colour service needs a patch test first, and how many days before.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Changing a booking</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Say how much notice you need to move or cancel, and the quickest way to tell you.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Walk-ins</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Say whether you take walk-ins, or only booked appointments, and on which days.</p></li></ul></section></div><div id="appointments" data-site-section=""><section id="enquiry" class="mx-auto w-full max-w-2xl scroll-mt-20 px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-3xl font-bold tracking-tight">Ask for an appointment</h2><p class="text-site-body mt-3">Say what you would like done and which days suit you, and the salon will reply with a time.</p><form data-clarity-mask="true" class="mt-8 grid gap-[var(--site-grid-gap)] ph-no-capture" noValidate=""><div class="grid gap-1.5"><label for="_R_i_-0" class="text-site-fg text-sm font-medium">Your name<span aria-hidden="true"> *</span></label><input id="_R_i_-0" required="" type="text" autoComplete="name" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="name" value=""/></div><div class="grid gap-1.5"><label for="_R_i_-1" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true"> *</span></label><input id="_R_i_-1" required="" type="email" autoComplete="email" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="email" value=""/></div><div class="grid gap-1.5"><label for="_R_i_-2" class="text-site-fg text-sm font-medium">Phone</label><div class="flex min-w-0 gap-2"><div class="max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border relative mt-0 flex w-auto shrink-0 items-center gap-1.5 px-3 tabular-nums focus-within:ring-site-fg focus-within:ring-offset-site-bg focus-within:ring-2 focus-within:ring-offset-2"><span aria-hidden="true" class="text-base leading-none">🇮🇳</span><span aria-hidden="true">+91</span><svg aria-hidden="true" viewBox="0 0 16 16" class="text-site-muted size-3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"></path></svg><select aria-label="Country code: India +91" class="absolute inset-0 h-full w-full cursor-pointer appearance-none text-base opacity-0 disabled:cursor-default"><option value="IN" selected="">🇮🇳 India +91</option><option value="US">🇺🇸 United States +1</option><option value="GB">🇬🇧 United Kingdom +44</option><option value="AE">🇦🇪 United Arab Emirates +971</option><option value="AF">🇦🇫 Afghanistan +93</option><option value="AL">🇦🇱 Albania +355</option><option value="DZ">🇩🇿 Algeria +213</option><option value="AS">🇦🇸 American Samoa +1684</option><option value="AD">🇦🇩 Andorra +376</option><option value="AO">🇦🇴 Angola +244</option><option value="AI">🇦🇮 Anguilla +1264</option><option value="AG">🇦🇬 Antigua and Barbuda +1268</option><option value="AR">🇦🇷 Argentina +54</option><option value="AM">🇦🇲 Armenia +374</option><option value="AW">🇦🇼 Aruba +297</option><option value="AU">🇦🇺 