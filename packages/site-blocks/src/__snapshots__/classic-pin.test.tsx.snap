            @media (prefers-reduced-motion: no-preference) {
                :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :where(a, button, summary) {
                    transition: color 150ms var(--site-ease), background-color 150ms var(--site-ease), border-color 150ms var(--site-ease), opacity 150ms var(--site-ease), text-decoration-color 150ms var(--site-ease);
                }
            }
            @keyframes site-rise {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }
            }
            @keyframes site-menu-in {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }
            }
            @keyframes site-fade-in {
                from {
                    opacity: 0;
                }
            }
            @media (prefers-reduced-motion: no-preference) {
                :root [data-site-menu-panel] {
                    animation: site-menu-in 180ms var(--site-ease) both;
                }
