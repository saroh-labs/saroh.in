                --site-font-body: "Inter Tight", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
                --site-display-size: 64px;
                --site-body-size: 16px;
                --site-measure: 60ch;
                --site-content-width: 1200px;
            }
            :root [data-site-section] :is(.max-w-screen-md, .max-w-screen-lg, .max-w-screen-xl) {
                max-width: var(--site-content-width);
