l" autoComplete="tel-national" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border mt-0 min-w-0 flex-1 tabular-nums focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg" name="phone" value=""/></div></div><div class="grid gap-1.5"><label for="_R_a_-3" class="text-site-fg text-sm font-medium">Message<span aria-hidden="true"> *</span></label><textarea id="_R_a_-3" name="message" required="" rows="4" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border "></textarea></div><button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-[color,background-color,border-color,opacity,transform] duration-150 [transition-timing-function:cubic-bezier(0.2,0.8,0.2,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none aria-disabled:pointer-events-none aria-disabled:cursor-default aria-disabled:opacity-55 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 active:opacity-80 w-fit disabled:cursor-not-allowed disabled:opacity-60">Send</button></form></section></div>"`;

exports[`Classic's pages are pinned > studio / 1`] = `"<div data-site-section=""><h1 class="sr-only">Sample Business</h1></div><div id="work" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg mb-3.5 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Work</h2><div class="grid gap-[var(--site-grid-gap)]"><article class="min-w-0"><div class="bg-site-surface relative w-full overflow-hidden aspect-[21/9] min-h-[240px] sm:min-h-[340px]"><div data-plate-band="" class="from-site-fg/80 via-site-fg/70 to-site-fg/0 text-site-bg absolute inset-x-0 bottom-0 flex flex-col justify-end overflow-hidden bg-gradient-to-t px-4 pb-3 h-[82px]"><h3 class="font-site-heading truncate font-semibold text-[calc(1.1875rem*var(--site-heading-scale))]">Your lead project</h3><p class="truncate text-[13.5px]">What you made · the year</p></div></div></article><div class="grid grid-cols-2 gap-[var(--site-grid-gap)]"><article class="min-w-0"><div class="bg-site-surface relative w-full overflow-hidden aspect-[4/3]"><div data-plate-band="" class="from-site-fg/80 via-site-fg/70 to-site-fg/0 text-site-bg absolute inset-x-0 bottom-0 flex flex-col justify-end overflow-hidden bg-gradient-to-t px-4 pb-3 h-[66px]"><h3 class="font-site-heading truncate font-semibold text-[calc(0.9375rem*var(--site-heading-scale))]">Your second project</h3><p class="truncate text-[12.5px]">What you made · the year</p></div></div></article><article class="min-w-0"><div class="bg-site-surface relative w-full overflow-hidden aspect-[4/3]"><div data-plate-band="" class="from-site-fg/80 via-site-fg/70 to-site-fg/0 text-site-bg absolute inset-x-0 bottom-0 flex flex-col justify-end overflow-hidden bg-gradient-to-t px-4 pb-3 h-[66px]"><h3 class="font-site-heading truncate font-semibold text-[calc(0.9375rem*var(--site-heading-scale))]">Your third project</h3><p class="truncate text-[12.5px]">What you made · the year</p></div></div></article></div><div class="grid items-end gap-[var(--site-grid-gap)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1.72fr)]"><article class="min-w-0"><div class="bg-site-surface relative w-full overflow-hidden aspect-[3/4]"><div data-plate-band="" class="from-site-fg/80 via-site-fg/70 to-site-fg/0 text-site-bg absolute inset-x-0 bottom-0 flex flex-col justify-end overflow-hidden bg-gradient-to-t px-4 pb-3 h-[66px]"><h3 class="font-site-heading truncate font-semibold text-[calc(0.9375rem*var(--site-heading-scale))]">Your fourth project</h3><p class="truncate text-[12.5px]">What you made · the year</p></div></div></article><article class="min-w-0"><div class="bg-site-surface relative w-full overflow-hidden aspect-video"><div data-plate-band="" class="from-site-fg/80 via-site-fg/70 to-site-fg/0 text-site-bg absolute inset-x-0 bottom-0 flex flex-col justify-end overflow-hidden bg-gradient-to-t px-4 pb-3 h-[66px]"><h3 class="font-site-heading truncate font-semibold text-[calc(0.9375rem*var(--site-heading-scale))]">Your fifth project</h3><p class="truncate text-[12.5px]">What you made · the year</p></div></div></article></div></div></section></div><div id="studio" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="max-w-[65ch]"><div class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)]"><h2>Studio</h2><p>This is a placeholder for who Sample Business is: how many people, where, and what the work is, from identity to the things identity has to survive.</p><p>Say how much work is taken on in a year and who does it, so a client knows whether the person they brief is the person who draws it.</p><p>Say what the studio is better at, and what it will say early if a project needs something else. Replace all three paragraphs with your own.</p><dl><dt>Studio</dt><dd>Where you work</dd><dt>Who</dt><dd>Your names</dd><dt>Since</dt><dd>The year you started</dd></dl></div></div></section></div><div id="contact" data-site-section=""><section id="enquiry" class="mx-auto w-full max-w-2xl scroll-mt-20 px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-3xl font-bold tracking-tight">If you have something that needs drawing, describe it badly.</h2><p class="text-site-body mt-3">A paragraph is plenty. The useful questions come after, and the messy version of the problem is more use than a tidy brief that has already decided the answer.</p><form data-clarity-mask="true" class="mt-8 grid gap-[var(--site-grid-gap)] ph-no-capture" noValidate=""><div class="grid gap-1.5"><label for="_R_i_-0" class="text-site-fg text-sm font-medium">Your name<span aria-hidden="true"> *</span></label><input id="_R_i_-0" required="" type="text" autoComplete="name" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="name" value=""/></div><div class="grid gap-1.5"><label for="_R_i_-1" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true"> *</span></label><input id="_R_i_-1" required="" type="email" autoComplete="email" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="email" value=""/></div><div class="grid gap-1.5"><label for="_R_i_-2" class="text-site-fg text-sm font-medium">What needs drawing?<span aria-hidden="true"> *</span></label><textarea id="_R_i_-2" name="message" required="" rows="4" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border "></textarea></div><button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-[color,background-color,border-color,opacity,transform] duration-150 [transition-timing-function:cubic-bezier(0.2,0.8,0.2,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none aria-disabled:pointer-events-none aria-disabled:cursor-default aria-disabled:opacity-55 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 active:opacity-80 w-fit disabled:cursor-not-allowed disabled:opacity-60">Send</button></form></section></div><div data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="mt-10 grid gap-[var(--site-grid-gap)] md:grid-cols-2"><dl class="grid content-start gap-4"><div><dt class="text-site-muted text-sm font-medium">Email</dt><dd class="mt-1"><a href="mailto:sample@example.com" class="text-site-fg focus-visible:ring-site-accent break-words text-lg underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2">sample@example.com</a></dd></div></dl></div></section></div>"`;

