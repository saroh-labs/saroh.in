            :root {
                --site-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
                --site-section-space: var(--site-section-padding);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h1, h2, h3, h4) {
                font-family: var(--site-font-heading);
                text-wrap: balance;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h1 {
                letter-spacing: -0.03em;
                line-height: 1.05;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h2 {
                letter-spacing: -0.02em;
                line-height: 1.15;
