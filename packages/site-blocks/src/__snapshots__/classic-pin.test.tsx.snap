            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h3, h4) {
                letter-spacing: -0.01em;
                line-height: 1.25;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) p {
                text-wrap: pretty;
            }
            :root [data-site-section] .prose {
                --tw-prose-body: hsl(var(--site-body));
                --tw-prose-headings: hsl(var(--site-fg));
                --tw-prose-lead: hsl(var(--site-fg));
