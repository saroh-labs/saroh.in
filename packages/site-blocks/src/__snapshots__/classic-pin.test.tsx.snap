                --site-accent: 16.03 60.42% 37.65%;
                --site-accent-fg: 30 57.14% 97.25%;
                --site-hero-bg: 28.57 39.62% 89.61%;
                --site-cta-bg: 16.03 60.42% 37.65%;
                --site-cta-fg: 30 57.14% 97.25%;
                --site-footer-bg: 15 23.53% 13.33%;
                --site-footer-fg: 28.57 39.62% 89.61%;
                --site-hero-fg: 15 23.53% 13.33%;
                --site-page-margin: 32px;
                --site-section-padding: 80px;
                --site-grid-gap: 20px;
                --site-radius: 8px;
                --site-heading-scale: 1.05;
                --site-font-heading: "Source Serif 4", Georgia, "Times New Roman", "Noto Serif", "Noto Serif Devanagari", serif;
                --site-font-body: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
                --site-display-size: 56px;
                --site-body-size: 17px;
                --site-measure: 64ch;
                --site-content-width: 1120px;
            }
