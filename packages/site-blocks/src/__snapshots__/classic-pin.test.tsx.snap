                --site-footer-bg: 20 60% 98.04%;
                --site-footer-fg: 20 17.65% 13.33%;
                --site-hero-fg: 20 17.65% 13.33%;
                --site-page-margin: 44px;
                --site-section-padding: 64px;
                --site-grid-gap: 14px;
                --site-radius: 4px;
