            }
            :root [data-site-section] .prose dd {
                color: hsl(var(--site-fg) / 0.8);
            }
            :root [data-site-section] [data-site-facts="labels"] dt {
                margin-top: 1.25em;
                color: hsl(var(--site-muted));
                font-family: var(--site-font-body);
                font-size: 0.78rem;
                font-weight: 500;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }
