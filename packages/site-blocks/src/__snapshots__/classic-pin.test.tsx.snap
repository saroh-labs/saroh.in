a-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="max-w-[65ch]"><div class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)]"><h2>About</h2><p>This is a placeholder for a few words about Sample Business: who writes here, and what about.</p><p>Say how often something goes up, and why it is worth coming back for. Replace both with your own.</p><p>To write back: <a href="mailto:sample@example.com">sample@example.com</a>.</p></div></div></section></div>"`;

exports[`Classic's pages are pinned > ceramics / 1`] = `"<div data-site-section=""><h1 class="sr-only">Sample Business</h1></div><div id="collection" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="mb-3.5 flex flex-wrap items-baseline gap-x-3 gap-y-1"><h2 data-site-title="" class="font-site-heading text-site-fg flex-1 [overflow-wrap:break-word] text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Current collection</h2></div><div role="status" aria-busy="true" class="border-site-border text-site-body grid justify-items-start gap-2 rounded-[calc(var(--site-radius)*1.4)] border border-dashed p-5 text-sm leading-relaxed"><p>Loading your products…</p></div></section></div><div id="material" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Material</h2><p class="font-site-heading text-site-fg mt-4 max-w-[40ch] text-pretty text-[calc(1.5625rem*var(--site-heading-scale))] font-normal leading-snug tracking-[-0.01em]">The clay, the glaze and the firing, and not one of them behaves the same way twice.</p><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 lg:grid-cols-3"><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">The clay</h3><p class="text-site-body mt-2 leading-relaxed">A placeholder. Say where the clay comes from, what is in it and why the surface looks the way it does.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">The glaze</h3><p class="text-site-body mt-2 leading-relaxed">A placeholder. Say which glazes you use and how they are mixed, and what that does to the colour.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">The firing</h3><p class="text-site-body mt-2 leading-relaxed">A placeholder. Say how the work is fired, and how often a piece comes out of the kiln unusable.</p></li></ul></section></div><div data-site-section=""></div><div data-site-section=""><section class="mx-auto w-full max-w-screen-md px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div data-site-headings="label" data-site-facts="labels" class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)]"><h2>The studio</h2><p>This is a placeholder for where the work of Sample Business is made: the room, the wheel and the hands. Say what that means for the pieces, such as why no two in a set are quite the same height.</p><p>Say how the work is made and fired, in runs or one at a time, and what happens when a glaze or a batch is gone. Replace both paragraphs with your own.</p><dl><dt>Studio</dt><dd>Your area and town — where you work</dd><dt>Made by</dt><dd>Your name — or the names of everyone who makes</dd><dt>Throwing since</dt><dd>Your first year — when you started</dd></dl></div></section></div>"`;

exports[`Classic's pages are pinned > clinic / 1`] = `"<div data-site-section=""><section data-site-ground="hero" class="bg-site-hero-bg text-site-hero-fg w-full py-[var(--site-section-padding)]"><div class="mx-auto grid w-full max-w-screen-xl items-start gap-[22px] px-5 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))] sm:px-[var(--site-page-margin)]"><div class="pt-2"><h1 class="font-site-heading text-balance text-[clamp(calc(38px*var(--site-heading-scale)),9vw,calc(64px*var(--site-heading-scale)))] font-semibold leading-[1.02] tracking-[-0.035em]">Book a check-up. Know what happens next.</h1><p class="mt-3.5 max-w-[44ch] text-pretty text-base leading-[1.55] opacity-75">The treatments at Sample Business, who you will see, and how to get an appointment.</p></div><div class="bg-site-surface border-site-border text-site-fg rounded-[calc(var(--site-radius)+16px)] border px-4 pb-2.5 pt-4 shadow-[0_10px_30px_hsl(var(--site-fg)/0.06)]"><div class="mb-1.5 flex items-baseline gap-2"><h2 data-site-title="" class="font-site-heading flex-1 text-[19px] font-semibold tracking-[-0.01em]">On today</h2></div><p class="border-site-border text-site-muted border-t px-1 py-3 text-[13.5px]">Loading today&#x27;s times…</p></div></div></section></div><div id="how" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">What a treatment involves</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Four steps, and you can stop and ask at any of them.</p><ol class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 sm:gap-x-10"><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">01</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">A first appointment</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">The doctor asks what has been bothering you, examines, and explains what they find in plain words. Ask anything; there are no silly questions.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">02</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">A plan and a price</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">If something needs treatment, ask for the plan, how many visits it takes and the price before it starts.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">03</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">The visits</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">Book each visit at a time that suits you, and bring any reports, scans or prescriptions you already have.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">04</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Afterwards</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">If a review visit is useful the doctor will say so. Call the clinic if anything feels wrong before then.</p></li></ol><p class="text-site-muted mt-8 max-w-2xl whitespace-pre-line text-[14px] leading-relaxed">Nothing on this site is a diagnosis or a substitute for seeing a doctor. In an emergency, go to the nearest hospital.</p></section></div><div id="doctors" data-site-section=""><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading mb-5 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Who you will see</h2><ul class="grid grid-cols-2 gap-x-[var(--site-grid-gap)] gap-y-8 lg:grid-cols-4"><li class="min-w-0"><h3 class="font-site-heading text-[calc(1.0625rem*var(--site-heading-scale))] font-semibold leading-tight [overflow-wrap:anywhere]">Your first doctor</h3><p class="text-site-muted mt-1 text-[12.5px] font-semibold uppercase tracking-[0.06em]">Their qualification and what they practise</p><p class="text-site-body mt-2 whitespace-pre-line text-[13.5px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Say what they treat, where they trained and the days they see patients.</p></li><li class="min-w-0"><h3 class="font-site-heading text-[calc(1.0625rem*var(--site-heading-scale))] font-semibold leading-tight [overflow-wrap:anywhere]">Your second doctor</h3><p class="text-site-muted mt-1 text-[12.5px] font-semibold uppercase tracking-[0.06em]">Their qualification and what they practise</p><p class="text-site-body mt-2 whitespace-pre-line text-[13.5px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Add one of these for each doctor, or remove this one if you practise alone.</p></li></ul></section></div><div id="questions" data-site-section=""><section class="mx-auto w-full max-w-3xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Before you come in</h2><div class="border-site-border mt-8 border-t"><details class="border-site-border group border-b"><summary class="text-site-fg focus-visible:ring-site-accent flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-medium focus-visible:outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><span>What should I bring?</span><span aria-hidden="true" class="text-site-muted shrink-0 transition-transform group-open:rotate-45">+</span></summary><p class="text-site-body whitespace-pre-line pb-5 text-[length:var(--site-body-size,1rem)] leading-relaxed">Any reports, scans, X-rays or prescriptions you already have, and the names of the medicines you take. Old ones are worth bringing too.</p></details><details class="border-site-border group border-b"><summary class="text-site-fg focus-visible:ring-site-accent flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-medium focus-visible:outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><span>What if it can&#x27;t wait?</span><span aria-hidden="true" class="text-site-muted shrink-0 transition-transform group-open:rotate-45">+</span></summary><p class="text-site-body whitespace-pre-line pb-5 text-[length:var(--site-body-size,1rem)] leading-relaxed">Call the clinic first. If you cannot reach anyone and it is an emergency, go to the nearest hospital.</p></details></div></section></div><div id="contact" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Ask before you book</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Not sure which treatment you need? Write with what has been bothering you, and the clinic will reply.</p><div class="mt-10 grid gap-[var(--site-grid-gap)] md:grid-cols-2"><dl class="grid content-start gap-4"><div><dt class="text-site-muted text-sm font-medium">Email</dt><dd class="mt-1"><a href="mailto:sample@example.com" class="text-site-fg focus-visible:ring-site-accent break-words text-lg underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2">sample@example.com</a></dd></div></dl></div></section></div><div id="hours" data-site-section="" data-site-band="inverse"><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading mb-3 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Appointments and hours</h2><div role="status" aria-busy="true" class="border-site-border text-site-body grid max-w-md justify-items-start gap-2 rounded-[calc(var(--site-radius)*1.4)] border border-dashed p-5 text-sm leading-relaxed"><p>Loading our opening hours…</p></div></section></div>"`;

exports[`Classic's pages are pinned > developer / 1`] = `
"<div data-site-section=""><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 pb-2 pt-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h1 class="font-site-heading text-balance text-[calc(2rem*var(--site-heading-scale))] font-semibold leading-tight tracking-[-0.025em]">Sample Business</h1></section></div><div id="intro" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="max-w-[65ch]"><div class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)]"><p>A placeholder for your opening: the parts of a product you build, what you build them in, and the size of team you usually work with. Two or three sentences, in your own voice.</p><p>Then how you work: alone or with others, one project at a time or several, and what that means for someone hiring you.</p><dl><dt>Based</dt><dd>Your city and time zone</dd><dt>Works with</dt><dd>Your languages and tools</dd><dt>Since</dt><dd>When you started working independently</dd></dl></div></div></section></div><div id="work" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="mb-3.5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Work</h2><span data-project-count="" class="text-site-muted text-[13.5px]">3 projects</span></div><ol class="border-site-border border-t"><li class="border-site-border text-site-fg grid gap-x-6 gap-y-1 border-b py-5 sm:grid-cols-[4.5rem_minmax(0,1fr)_9.5rem]"><span class="font-site-mono text-site-muted text-[12.5px] tabular-nums sm:pt-1">Year</span><div class="grid min-w-0 gap-1"><h3 class="font-site-heading text-[calc(1.03125rem*var(--site-heading-scale))] font-semibold leading-snug [overflow-wrap:anywhere]">Your most recent engagement</h3><p class="text-site-body whitespace-pre-line text-[15px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. One sentence on what you built, for whom, and what it replaced.</p><p class="font-site-mono text-site-muted text-[12.5px] [overflow-wrap:anywhere]">The stack · one word each</p></div><span class="text-site-body text-[13.5px] sm:pt-0.5">Your role</span></li><li class="border-site-border text-site-fg grid gap-x-6 gap-y-1 border-b py-5 sm:grid-cols-[4.5rem_minmax(0,1fr)_9.5rem]"><span class="font-site-mono text-site-muted text-[12.5px] tabular-nums sm:pt-1">Year</span><div class="grid min-w-0 gap-1"><h3 class="font-site-heading text-[calc(1.03125rem*var(--site-heading-scale))] font-semibold leading-snug [overflow-wrap:anywhere]">The one before it</h3><p class="text-site-body whitespace-pre-line text-[15px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Pick work that shows a different side of what you do.</p><p class="font-site-mono text-site-muted text-[12.5px] [overflow-wrap:anywhere]">The stack</p></div><span class="text-site-body text-[13.5px] sm:pt-0.5">Your role</span></li><li class="border-site-border text-site-fg grid gap-x-6 gap-y-1 border-b py-5 sm:grid-cols-[4.5rem_minmax(0,1fr)_9.5rem]"><span class="font-site-mono text-site-muted text-[12.5px] tabular-nums sm:pt-1">Years</span><div class="grid min-w-0 gap-1"><h3 class="font-site-heading text-[calc(1.03125rem*var(--site-heading-scale))] font-semibold leading-snug [overflow-wrap:anywhere]">A salaried role, if it taught you something</h3><p class="text-site-body whitespace-pre-line text-[15px] leading-relaxed [overflow-wrap:anywhere] [text-wrap:pretty]">A placeholder. Say what you learned there, or remove this one.</p><p class="font-site-mono text-site-muted text-[12.5px] [overflow-wrap:anywhere]">The stack</p></div><span class="text-site-body text-[13.5px] sm:pt-0.5">Your title there</span></li></ol></section></div><div id="case" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="max-w-[65ch]"><div class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)] prose-h3:font-site-body prose-h3:text-site-muted prose-h3:mb-2 prose-h3:mt-8 prose-h3:text-[13px] prose-h3:font-semibold prose-h3:uppercase prose-h3:tracking-[0.1em]"><h2>Your case study — the project you would most like to be hired for again</h2><p><em>Client · year · how long, and your part in it</em></p><p>A placeholder. Pick one piece of work and tell it properly: the parts below are the questions a good client will ask anyway.</p><h3>The problem</h3><p>Say what was going wrong before you arrived, in the client's terms, and what they had already tried.</p><h3>Constraints</h3><p>Say what could not stop, change or be spent while you worked.</p><h3>What I decided</h3><p>Say which two or three choices mattered, and what each one cost.</p><h3>What I would do differently</h3><p>Say one honest thing. It is the part people remember.</p></div><aside aria-label="What changed" class="border-site-accent bg-site-surface text-site-fg mt-8 max-w-[var(--site-measure,65ch)] border-l-2 px-5 py-4"><p class="text-[13px] font-semibold uppercase tracking-[0.1em]">What changed</p><p class="whitespace-pre-line text-[length:var(--site-body-size,1rem)] leading-relaxed mt-1.5">A placeholder. The result, as the client would put it. Only what you can stand behind.</p></aside></div></section></div><div id="rates" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">What I charge</h2><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 lg:grid-cols-3"><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Day rate</h3><p class="font-site-heading text-site-fg mt-1.5 text-[calc(1.4375rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Your day rate</p><p class="text-site-body mt-2 leading-relaxed">What it is for, and any minimum.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Project</h3><p class="font-site-heading text-site-fg mt-1.5 text-[calc(1.4375rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Your usual range</p><p class="text-site-body mt-2 leading-relaxed">For a fixed-price project, and how you scope one.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Retainer</h3><p class="font-site-heading text-site-fg mt-1.5 text-[calc(1.4375rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Your monthly rate</p><p class="text-site-body mt-2 leading-relaxed">How much time it buys, and the minimum term.</p></li></ul><p class="text-site-muted mt-8 max-w-2xl whitespace-pre-line text-[14px] leading-relaxed">Placeholders: replace each with your own rate. Say how you quote, and whether scoping is paid.</p></section></div><div id="availability" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="max-w-[65ch]"><div class="prose prose-headings:font-site-heading prose-headings:text-site-fg prose-p:text-site-fg/80 prose-a:text-site-accent-text prose-strong:text-site-fg prose-li:text-site-fg/80 max-w-[var(--site-measure,none)] text-[length:var(--site-body-size,1rem)]"><h2>Availability</h2></div><aside aria-label="Your next opening — the month, as of today" class="border-site-accent bg-site-surface text-site-fg mt-8 max-w-[var(--site-measure,65ch)] border-l-2 px-5 py-4"><p class="text-[13px] font-semibold uppercase tracking-[0.1em]">Your next opening — the month, as of today</p><p class="whitespace-pre-line text-[length:var(--site-body-size,1rem)] leading-relaxed mt-1.5">A placeholder. Say how many projects you can take and from when. If you are full, say so, and when that changes.
Not looking for: the kinds of work you would rather not be asked about.</p></aside></div></section></div><div data-site-section=""><section id="enquiry" class="mx-auto w-full max-w-2xl scroll-mt-20 px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-3xl font-bold tracking-tight">Work with Sample Business</h2><p class="text-site-body mt-3">Say what you are building and when you need it.</p><form data-clarity-mask="true" class="mt-8 grid gap-[var(--site-grid-gap)] ph-no-capture" noValidate=""><div class="grid gap-1.5"><label for="_R_u_-0" class="text-site-fg text-sm font-medium">Your name<span aria-hidden="true"> *</span></label><input id="_R_u_-0" required="" type="text" autoComplete="name" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="name" value=""/></div><div class="grid gap-1.5"><label for="_R_u_-1" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true"> *</span></label><input id="_R_u_-1" required="" type="email" autoComplete="email" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="email" value=""/></div><div class="grid gap-1.5"><label for="_R_u_-2" class="text-site-fg text-sm font-medium">What are you building, and when do you need it?<span aria-hidden="true"> *</span></label><textarea id="_R_u_-2" name="message" required="" rows="4" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border "></textarea></div><button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-[color,background-color,border-color,opacity,transform] duration-150 [transition-timing-function:cubic-bezier(0.2,0.8,0.2,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none aria-disabled:pointer-events-none aria-disabled:cursor-default aria-disabled:opacity-55 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 active:opacity-80 w-fit disabled:cursor-not-allowed disabled:opacity-60">Send</button></form></section></div>"
`;

exports[`Classic's pages are pinned > dietician / 1`] = `
"<div id="intro" data-site-section=""><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="grid items-start gap-8 md:grid-cols-[300px_minmax(0,1fr)] md:gap-[46px]"><div class="min-w-0 max-w-[300px]"><div><p class="text-site-muted text-[12px] font-semibold uppercase tracking-[0.1em]">Qualifications</p><ul aria-label="Qualifications" class="mt-2"><li class="border-site-border grid gap-0.5 border-t py-2.5"><span class="text-[14px] font-medium leading-snug [overflow-wrap:anywhere]">Your degree — the subject</span><span class="text-site-muted text-[13px] leading-snug [overflow-wrap:anywhere]">Where you studied, and the year</span></li><li class="border-site-border grid gap-0.5 border-t py-2.5"><span class="text-[14px] font-medium leading-snug [overflow-wrap:anywhere]">Your registration — what it is</span><span class="text-site-muted text-[13px] leading-snug [overflow-wrap:anywhere]">The body you are registered with</span></li><li class="border-site-border grid gap-0.5 border-t py-2.5"><span class="text-[14px] font-medium leading-snug [overflow-wrap:anywhere]">Your other training — if any</span><span class="text-site-muted text-[13px] leading-snug [overflow-wrap:anywhere]">Who it is from, or the year you began practising</span></li></ul></div></div><div class="min-w-0"><h1 class="font-site-heading text-[calc(2.5rem*var(--site-heading-scale))] font-medium leading-[1.1] tracking-[-0.02em] [overflow-wrap:anywhere]">Sample Business</h1><p class="text-site-muted mt-2 text-[16px]">Your title and your town — for example, Registered dietician · Pune</p><p class="text-site-body mt-5 max-w-[var(--site-measure,62ch)] whitespace-pre-line text-[length:var(--site-body-size,17px)] leading-[1.72] [overflow-wrap:anywhere]">Write two or three short paragraphs in your own voice: who comes to see you, what they usually arrive with, and how you work with them.

Say plainly what you do not do, too — people trust a practitioner who tells them.</p></div></div></section></div><div data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><dl class="flex flex-wrap gap-x-12 gap-y-6"><div class="flex min-w-0 flex-col-reverse"><dt class="text-site-muted mt-1 text-[13px] leading-snug">Say how long you have been in practice</dt><dd class="font-site-heading text-site-fg text-[calc(1.5625rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Years</dd></div><div class="flex min-w-0 flex-col-reverse"><dt class="text-site-muted mt-1 text-[13px] leading-snug">Say which languages you consult in</dt><dd class="font-site-heading text-site-fg text-[calc(1.5625rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Languages</dd></div><div class="flex min-w-0 flex-col-reverse"><dt class="text-site-muted mt-1 text-[13px] leading-snug">Say where you see people, and whether by video</dt><dd class="font-site-heading text-site-fg text-[calc(1.5625rem*var(--site-heading-scale))] font-medium leading-tight tracking-[-0.01em] [overflow-wrap:anywhere]">Where</dd></div></dl></section></div><div id="how" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">How I work</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Four stages, and the whole of the first one is listening.</p><ol class="mt-10 grid gap-[var(--site-grid-gap)]"><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">01</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">We talk first</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">Most of the first consultation is you talking. What you eat, when, who cooks it, what has already been tried, and what a bad week looks like rather than an average one.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">02</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">I read what you bring</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">Recent blood work, a doctor&#x27;s note, anything a previous dietician gave you. Bring it even if it is old or you think it is irrelevant.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">03</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">We change three things</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">Not thirty. Three changes you can actually make, written down in plain language, with what to do when one of them fails.</p></li><li class="border-site-border grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline border-t pt-5"><span aria-hidden="true" class="font-site-heading text-site-accent-text text-[15px] tabular-nums">04</span><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">We check in six weeks</h3><p class="text-site-body col-start-2 mt-2 max-w-2xl leading-relaxed">To see what held and what did not. The changes that did not hold are information, not failure — usually they were the wrong three.</p></li></ol></section></div><div id="consultation" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">One consultation</h2><p class="text-site-body mt-3 max-w-2xl text-lg">If a follow-up is useful I will say so at the end of the first one, and if it is not I will say that instead. Video consultations work as well as in-person for almost everything.</p><ul class="mt-10 grid gap-[var(--site-grid-gap)]"><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">The consultation itself, in person or by video</h3></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">A written plan afterwards, in plain language, by email</h3></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Review of any blood work or notes you bring</h3></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">One short follow-up question by email within the first month</h3></li></ul></section></div><div id="areas" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">What I am asked about most</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Most of my work sits in these six. If what you need is not here, say so in your email and I will tell you honestly whether I am the right person.</p><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 sm:gap-x-10"><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Type 2 diabetes</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Alongside your doctor, not instead of them. Mostly timing, portions and what to do about rice.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">PCOS</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Practical eating patterns, and an honest conversation about what diet can and cannot change.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Thyroid conditions</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Working around medication timing, and separating what is diet from what is not.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Digestive health</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Identifying triggers methodically rather than eliminating food groups on a guess.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Weight, sustainably</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Slow change you can keep, measured in habits rather than a target on a scale.</p></li><li class="border-site-border border-t pt-5"><h3 class="font-site-heading text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Eating for sport</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">For amateur athletes fitting training around a full-time job.</p></li></ul><p class="text-site-muted mt-8 max-w-2xl whitespace-pre-line text-[14px] leading-relaxed">I work alongside your doctor and I do not change prescribed medication or treatment. Nothing here is a diagnosis, and nothing I do replaces medical care.</p></section></div><div id="writing" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><div class="mb-3.5 flex items-baseline gap-3"><h2 data-site-title="" class="font-site-heading text-site-fg min-w-0 flex-1 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Writing</h2></div><div role="status" aria-busy="true" class="border-site-border text-site-body grid justify-items-start gap-2 rounded-[calc(var(--site-radius)*1.4)] border border-dashed p-5 text-sm leading-relaxed"><p>Loading your posts…</p></div></section></div><div id="contact" data-site-section=""><section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Getting an appointment</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Email a sentence about what you would like help with and two or three times that suit you. If I think someone else would serve you better, I will tell you before booking.</p><div class="mt-10 grid gap-[var(--site-grid-gap)] md:grid-cols-2"><dl class="grid content-start gap-4"><div><dt class="text-site-muted text-sm font-medium">Email</dt><dd class="mt-1"><a href="mailto:sample@example.com" class="text-site-fg focus-visible:ring-site-accent break-words text-lg underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2">sample@example.com</a></dd></div></dl></div></section></div><div data-site-section=""><section class="text-site-fg mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading mb-3 text-[calc(1.625rem*var(--site-heading-scale))] font-semibold tracking-[-0.01em]">Appointments</h2><div role="status" aria-busy="true" class="border-site-border text-site-body grid max-w-md justify-items-start gap-2 rounded-[calc(var(--site-radius)*1.4)] border border-dashed p-5 text-sm leading-relaxed"><p>Loading our opening hours…</p></div></section></div>"
`;

