                background-color: hsl(var(--site-footer-fg));
                color: hsl(var(--site-footer-bg));
            }
            :root [data-site-section][data-site-band] {
                --site-section-padding: calc(var(--site-section-space) * 1.2);
            }
            :root [data-site-section]:not([data-site-band]):not(:empty):not(:has(> [data-site-ground])) + [data-site-section]:not([data-site-band]) > [class*="py-[var(--site-section-padding)]"]:not([data-site-ground]) {
                padding-top: calc(var(--site-section-padding) * 0.5);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-page])) :where(a, button, summary):focus-visible {
                outline: 2px solid hsl(var(--site-fg));
                outline-offset: 2px;
