exports[`Classic's pages are pinned > writing /contact 1`] = `"<div data-site-section=""><section id="enquiry" class="mx-auto w-full max-w-2xl scroll-mt-20 px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 data-site-title="" class="font-site-heading text-site-fg text-3xl font-bold tracking-tight">Write to Sample Business</h2><p class="text-site-body mt-3">A question, a thought on something you read, or just hello.</p><form data-clarity-mask="true" class="mt-8 grid gap-[var(--site-grid-gap)] ph-no-capture" noValidate=""><div class="grid gap-1.5"><label for="_R_6_-0" class="text-site-fg text-sm font-medium">Your name<span aria-hidden="true"> *</span></label><input id="_R_6_-0" required="" type="text" autoComplete="name" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="name" value=""/></div><div class="grid gap-1.5"><label for="_R_6_-1" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true"> *</span></label><input id="_R_6_-1" required="" type="email" autoComplete="email" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " name="email" value=""/></div><div class="grid gap-1.5"><label for="_R_6_-2" class="text-site-fg text-sm font-medium">Message<span aria-hidden="true"> *</span></label><textarea id="_R_6_-2" name="message" required="" rows="4" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-base text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border "></textarea></div><button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-[color,background-color,border-color,opacity,transform] duration-150 [transition-timing-function:cubic-bezier(0.2,0.8,0.2,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none aria-disabled:pointer-events-none aria-disabled:cursor-default aria-disabled:opacity-55 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 active:opacity-80 w-fit disabled:cursor-not-allowed disabled:opacity-60">Send</button></form></section></div>"`;

exports[`Classic's theme is pinned > bakery in crust 1`] = `
"<style>
            :root {
                --site-bg: 0 0% 100%;
                --site-surface: 0 0% 100%;
                --site-fg: 24 10% 10%;
                /* Body text: quieter than a heading, still readable. The
                   Tailwind config has mapped site-body since S2-006 and
                   nothing ever defined the variable, so every user of it —
                   the layout root, the 404 page, checkout — fell back to
                   near-black, which is invisible on a dark ground. */
                --site-body: 24 6% 34%;
                /* Declared in the site.* namespace since #252 and never
                   given a default here, so text-site-muted and
                   border-site-border resolved to hsl() of nothing — an invalid
                   declaration the browser drops, leaving the text at its
                   inherited colour and the border invisible. The publisher
                   DERIVES both per publication (app.saroh.in/lib/sites/style.ts),
                   so live sites were fine and only this fallback was not: the
                   tenant 404, the root error boundary, checkout, and every
                   publication older than #189 — exactly the paths that render
                   when something has already gone wrong.

                   The values are the ones siteStyleVariables() derives for the
                   default style, asserted in api's site-style.spec.ts, so a
                   publication carrying no variables renders identically to one
                   published today having chosen nothing. Picking a fresh pair
                   here would have made "never styled" and "styled by default"
                   two different-looking things. */
                --site-muted: 24 4.9% 55.9%;
                --site-border: 24 1.1% 90.1%;
                --site-accent: 24 10% 10%;
                --site-accent-fg: 0 0% 100%;
                --site-hero-bg: 0 0% 100%;
                --site-hero-fg: 24 10% 10%;
                --site-cta-bg: 24 10% 10%;
                --site-cta-fg: 0 0% 98%;
                --site-footer-bg: 24 10% 10%;
                --site-footer-fg: 0 0% 98%;
                --site-page-margin: 38px;
                --site-section-padding: 52px;
                --site-grid-gap: 14px;
                --site-radius: 2px;
                --site-heading-scale: 1;
                /* The merchant's type (H1). Every publication, old and new,
                   is set in the neutral system stack until its merchant
                   chooses fonts: no publication carries a font variable yet,
                   so these are what every site renders with. Never one of
                   Saroh's own faces (gate G7). */
                --site-font-heading: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
                --site-font-body: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
            }
            :root {
                --site-bg: 40 60% 96.08%;
                --site-surface: 38.18 47.83% 90.98%;
                --site-fg: 30 35.48% 12.16%;
                --site-body: 33 29.85% 26.27%;
                --site-muted: 33.06 25.13% 38.24%;
                --site-border: 37.5 39.02% 83.92%;
                --site-accent: 8.82 58.62% 34.12%;
                --site-accent-fg: 40 60% 96.08%;
                --site-hero-bg: 40 60% 96.08%;
                --site-cta-bg: 8.82 58.62% 34.12%;
                --site-cta-fg: 40 60% 96.08%;
                --site-footer-bg: 40 60% 96.08%;
                --site-footer-fg: 30 35.48% 12.16%;
                --site-hero-fg: 30 35.48% 12.16%;
                --site-page-margin: 40px;
                --site-section-padding: 76px;
                --site-grid-gap: 30px;
                --site-radius: 0px;
                --site-heading-scale: 1;
                --site-font-heading: "Fraunces", Georgia, "Times New Roman", "Noto Serif", "Noto Serif Devanagari", serif;
                --site-font-body: "Inter Tight", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
                --site-status: 102.86 43.75% 37.65%;
                --site-status-inverse: 97.67 48.31% 65.1%;
                --site-display-size: 68px;
                --site-body-size: 16.5px;
                --site-measure: 58ch;
                --site-content-width: 1240px;
            }
            :root [data-site-section] :is(.max-w-screen-md, .max-w-screen-lg, .max-w-screen-xl) {
                max-width: var(--site-content-width);
            }
            :root {
                --site-band-paper: var(--site-bg);
                --site-band-ink: var(--site-fg);
                --site-band-card: var(--site-surface);
                --site-band-accent: var(--site-accent);
                --site-band-accent-fg: var(--site-accent-fg);
                --site-band-status: var(--site-status);
                --site-band-status-inverse: var(--site-status-inverse);
            }
            :root [data-site-band] {
                background-color: hsl(var(--site-bg));
                color: hsl(var(--site-body));
            }
            :root [data-site-band="surface"] {
                --site-bg: var(--site-band-card);
                --site-surface: var(--site-band-paper);
            }
            :root [data-site-band="inverse"] {
                --site-bg: var(--site-band-ink);
                --site-surface: var(--site-band-ink);
                --site-fg: var(--site-band-paper);
                --site-body: var(--site-band-paper);
                --site-muted: var(--site-band-paper);
                --site-border: var(--site-band-paper);
                --site-accent: var(--site-band-paper);
                --site-accent-fg: var(--site-band-ink);
                --site-status: var(--site-band-status-inverse);
                --site-status-inverse: var(--site-band-status);
            }
            :root [data-site-band="accent"] {
                --site-bg: var(--site-band-accent);
                --site-surface: var(--site-band-accent);
                --site-fg: var(--site-band-accent-fg);
                --site-body: var(--site-band-accent-fg);
                --site-muted: var(--site-band-accent-fg);
                --site-border: var(--site-band-accent-fg);
                --site-accent: var(--site-band-accent-fg);
                --site-accent-fg: var(--site-band-accent);
                --site-status: initial;
                --site-status-inverse: initial;
            }
            :root [data-site-section][id] {
                scroll-margin-top: 4.5rem;
            }
            :root [data-site-section] .prose dt {
                color: hsl(var(--site-fg));
                font-family: var(--site-font-heading);
            }
            :root [data-site-section] .prose dd {
                color: hsl(var(--site-fg) / 0.8);
            }
            :root [data-site-section] [data-site-facts="labels"] dt {
                margin-top: 1.25em;
                color: hsl(var(--site-muted));
                font-family: var(--site-font-body);
                font-size: 0.78rem;
                font-weight: 500;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }
            :root [data-site-section] [data-site-facts="labels"] dd {
                margin-top: 0.25em;
                padding-inline-start: 0;
                color: hsl(var(--site-fg));
            }
            :root {
                --site-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
                --site-section-space: var(--site-section-padding);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h1, h2, h3, h4) {
                font-family: var(--site-font-heading);
                text-wrap: balance;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h1 {
                letter-spacing: -0.03em;
                line-height: 1.05;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) h2 {
                letter-spacing: -0.02em;
                line-height: 1.15;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :is(h3, h4) {
                letter-spacing: -0.01em;
                line-height: 1.25;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) p {
                text-wrap: pretty;
            }
            :root [data-site-section] .prose {
                --tw-prose-body: hsl(var(--site-body));
                --tw-prose-headings: hsl(var(--site-fg));
                --tw-prose-lead: hsl(var(--site-fg));
                --tw-prose-links: hsl(var(--site-accent));
                --tw-prose-bold: hsl(var(--site-fg));
                --tw-prose-counters: hsl(var(--site-muted));
                --tw-prose-bullets: hsl(var(--site-muted));
                --tw-prose-hr: hsl(var(--site-border));
                --tw-prose-quotes: hsl(var(--site-fg));
                --tw-prose-quote-borders: hsl(var(--site-accent));
                --tw-prose-captions: hsl(var(--site-muted));
                --tw-prose-code: hsl(var(--site-fg));
                --tw-prose-th-borders: hsl(var(--site-border));
                --tw-prose-td-borders: hsl(var(--site-border));
            }
            :root [data-site-section] .prose blockquote {
                border-inline-start-width: 2px;
                font-style: normal;
                font-weight: 500;
                quotes: none;
            }
            :root [data-site-section] .prose blockquote p::before,
            :root [data-site-section] .prose blockquote p::after {
                content: none;
            }
            :root [data-site-section] .prose a {
                text-decoration-line: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 0.2em;
            }
            :root [data-site-section] .prose a:hover {
                text-decoration-thickness: 2px;
            }
            :root ::selection {
                background-color: hsl(var(--site-accent));
                color: hsl(var(--site-accent-fg));
            }
            :root [data-site-ground="hero"] ::selection {
                background-color: hsl(var(--site-hero-fg));
                color: hsl(var(--site-hero-bg));
            }
            :root [data-site-ground="cta"] ::selection {
                background-color: hsl(var(--site-cta-fg));
                color: hsl(var(--site-cta-bg));
            }
            :root [data-site-footer] ::selection {
                background-color: hsl(var(--site-footer-fg));
                color: hsl(var(--site-footer-bg));
            }
            :root [data-site-section][data-site-band] {
                --site-section-padding: calc(var(--site-section-space) * 1.2);
            }
            :root [data-site-section]:not([data-site-band]):not(:empty):not(:has(> [data-site-ground])) + [data-site-section]:not([data-site-band]) > [class*="py-[var(--site-section-padding)]"]:not([data-site-ground]) {
                padding-top: calc(var(--site-section-padding) * 0.5);
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-page])) :where(a, button, summary):focus-visible {
                outline: 2px solid hsl(var(--site-fg));
                outline-offset: 2px;
            }
            :where(:root [data-site-ground="hero"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-hero-fg));
            }
            :where(:root [data-site-ground="cta"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-cta-fg));
            }
            :where(:root [data-site-ground="photo"]) :where(a, button, summary):focus-visible {
                outline-color: hsl(var(--site-bg));
            }
            :where(:root [data-site-footer]) :where(a, button, summary):focus-visible {
                outline: 2px solid hsl(var(--site-footer-fg));
                outline-offset: 2px;
            }
            :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :where(button:disabled, [aria-disabled="true"]) {
                cursor: default;
            }
            @media (prefers-reduced-motion: no-preference) {
                :where(:root :is([data-site-section], [data-site-header], [data-site-footer], [data-site-page])) :where(a, button, summary) {
