                --site-fg: 30 13.04% 9.02%;
                --site-body: 32.31 12.38% 20.59%;
                --site-muted: 32 8.2% 35.88%;
                --site-border: 40 33.33% 89.41%;
                --site-accent: 8.18 73.33% 35.29%;
                --site-accent-fg: 0 0% 100%;
                --site-hero-bg: 45 40% 98.04%;
                --site-cta-bg: 8.18 73.33% 35.29%;
                --site-cta-fg: 0 0% 100%;
                --site-footer-bg: 45 40% 98.04%;
                --site-footer-fg: 30 13.04% 9.02%;
                --site-hero-fg: 30 13.04% 9.02%;
                --site-page-margin: 40px;
                --site-section-padding: 52px;
                --site-grid-gap: 14px;
                --site-radius: 0px;
                --site-heading-scale: 1;
                --site-font-heading: "Newsreader", Georgia, "Times New Roman", "Noto Serif", "Noto Serif Devanagari", serif;
                --site-font-body: "Newsreader", Georgia, "Times New Roman", "Noto Serif", "Noto Serif Devanagari", serif;
                --site-display-size: 44px;
                --site-body-size: 18.5px;
                --site-measure: 76ch;
                --site-content-width: 980px;
            }
            :root :is([data-site-title], [data-site-headings="label"] :is(h2, h3)) {
                font-size: 0.875rem;
                line-height: 1.4;
                font-weight: 500;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: hsl(var(--site-muted));
            }
            :root [data-site-section] :is(.max-w-screen-md, .max-w-screen-lg, .max-w-screen-xl) {
                max-width: var(--site-content-width);
            }
            :root {
                --site-band-paper: var(--site-bg);
                --site-band-ink: var(--site-fg);
                --site-band-card: var(--site-surface);
                --site-band-accent: var(--site-accent);
