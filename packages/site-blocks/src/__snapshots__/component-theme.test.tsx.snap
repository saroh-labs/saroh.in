                --site-muted: 18.26 14.65% 30.78%;
                --site-border: 22.11 34.55% 89.22%;
                --site-accent: 9.87 40.1% 38.63%;
                --site-accent-fg: 0 0% 100%;
                --site-hero-bg: 20 60% 98.04%;
                --site-cta-bg: 9.87 40.1% 38.63%;
                --site-cta-fg: 0 0% 100%;
                --site-footer-bg: 20 60% 98.04%;
                --site-footer-fg: 20 17.65% 13.33%;
                --site-hero-fg: 20 17.65% 13.33%;
                --site-page-margin: 44px;
                --site-section-padding: 64px;
                --site-grid-gap: 14px;
                --site-radius: 4px;
                --site-heading-scale: 1;
                --site-font-heading: "Source Serif 4", Georgia, "Times New Roman", "Noto Serif", "Noto Serif Devanagari", serif;
                --site-font-body: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Noto Sans Devanagari", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji";
                --site-display-size: 40px;
                --site-body-size: 17px;
                --site-measure: 66ch;
                --site-content-width: 1080px;
                --site-accent-text: 9.87 40.1% 38.63%;
                --site-accent-soft: 16 31.91% 90.78%;
                --site-rule: 22.5 6.45% 51.37%;
                --site-footer-muted: 18 4.55% 43.14%;
                --site-tint: 16 31.91% 90.78%;
            }
            :root {
                --site-radius: 999px;
                --site-radius-s: 14px;
                --site-radius-photo: 4px;
                --site-page-margin: 20px;
                --site-section-padding: 72px;
                --site-motion-fast: 100ms;
