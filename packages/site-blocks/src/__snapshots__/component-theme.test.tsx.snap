                padding-bottom: var(--site-consent-offset, 0px);
            }
            @keyframes site-held {
                from {
                    visibility: hidden;
                }
            }
            :root .animate-pulse {
                animation: none;
            }
            :root :is(
                    [aria-busy="true"]:not([data-live-fact]),
