exports[`block rendering > enquiry 1`] = `"<section class="mx-auto w-full max-w-2xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-3xl font-bold tracking-tight">Ask us anything</h2><form class="mt-8 grid gap-[var(--site-grid-gap)]" novalidate=""><div class="grid gap-1.5"><label for="_r_0_-0" class="text-site-fg text-sm font-medium">Your name</label><input id="_r_0_-0" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " type="text" value="" name="name"></div><div class="grid gap-1.5"><label for="_r_0_-1" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true" class="text-destructive"> *</span></label><input id="_r_0_-1" required="" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border " type="email" value="" name="email"></div><div class="grid gap-1.5"><label for="_r_0_-2" class="text-site-fg text-sm font-medium">Message</label><textarea id="_r_0_-2" name="message" rows="4" class="w-full max-w-full rounded-[var(--site-radius)] border border-site-border bg-site-surface px-3 py-2 text-site-fg outline-none focus:border-site-border focus:ring-2 focus:ring-site-border "></textarea></div><button type="submit" class="inline-flex items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 w-fit disabled:cursor-not-allowed disabled:opacity-60">Send</button></form></section>"`;

