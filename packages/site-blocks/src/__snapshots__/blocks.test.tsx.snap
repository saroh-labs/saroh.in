exports[`block rendering > booking 1`] = `"<section class="mx-auto w-full max-w-2xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-3xl font-bold tracking-tight">Book a table</h2><p class="text-site-body mt-3">Lunch and dinner, seven days a week.</p><div class="mt-8"><div class="flex flex-wrap items-baseline justify-between gap-2"><h3 class="text-site-fg text-sm font-semibold">Choose a time</h3><p class="text-site-muted text-xs">Times shown in America/New_York</p></div><p class="text-site-muted mt-4 text-sm">No open times in the next 14 days — please check back soon.</p></div><form class="mt-8 grid gap-[var(--site-grid-gap)]" novalidate=""><div class="grid gap-1.5"><label for="_r_1_-name" class="text-site-fg text-sm font-medium">Name</label><input id="_r_1_-name" class="border-site-border bg-site-surface text-site-fg focus:border-site-border focus:ring-site-border w-full max-w-full rounded-[var(--site-radius)] border px-3 py-2 outline-none focus:ring-2" type="text" value="" name="name"></div><div class="grid gap-1.5"><label for="_r_1_-email" class="text-site-fg text-sm font-medium">Email<span aria-hidden="true"> *</span></label><input id="_r_1_-email" required="" class="border-site-border bg-site-surface text-site-fg focus:border-site-border focus:ring-site-border w-full max-w-full rounded-[var(--site-radius)] border px-3 py-2 outline-none focus:ring-2" type="email" value="" name="email"></div><div class="grid gap-1.5"><label for="_r_1_-phone" class="text-site-fg text-sm font-medium">Phone</label><input id="_r_1_-phone" class="border-site-border bg-site-surface text-site-fg focus:border-site-border focus:ring-site-border w-full max-w-full rounded-[var(--site-radius)] border px-3 py-2 outline-none focus:ring-2" type="tel" value="" name="phone"></div><button type="submit" disabled="" class="inline-flex items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90 w-fit disabled:cursor-not-allowed disabled:opacity-60">Confirm booking</button></form></section>"`;

