exports[`block rendering > testimonials 1`] = `"<section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">What our customers say</h2><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 lg:grid-cols-3"><li><figure class="border-site-border bg-site-surface flex h-full flex-col justify-between gap-6 rounded-[var(--site-radius)] border p-6"><blockquote class="text-site-fg whitespace-pre-line text-lg leading-relaxed">“Ordered at eleven, on site by three. That's why we stopped shopping around.”</blockquote><figcaption class="text-sm"><span class="text-site-fg block font-semibold">Priya Shah</span><span class="text-site-muted block">Site manager, Shah &amp; Sons Builders</span></figcaption></figure></li><li><figure class="border-site-border bg-site-surface flex h-full flex-col justify-between gap-6 rounded-[var(--site-radius)] border p-6"><blockquote class="text-site-fg whitespace-pre-line text-lg leading-relaxed">“They told me the cheaper part would do the job. It did.”</blockquote><figcaption class="text-sm"><span class="text-site-fg block font-semibold">Tom Ellis</span></figcaption></figure></li><li><figure class="border-site-border bg-site-surface flex h-full flex-col justify-between gap-6 rounded-[var(--site-radius)] border p-6"><blockquote class="text-site-fg whitespace-pre-line text-lg leading-relaxed">“The trade account paid for itself in the second month.”</blockquote><figcaption class="text-sm"><span class="text-site-fg block font-semibold">Grace Obi</span><span class="text-site-muted block">Customer since 2019</span></figcaption></figure></li></ul></section>"`;
