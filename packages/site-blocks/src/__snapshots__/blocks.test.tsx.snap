exports[`block rendering > servicesList 1`] = `"<section class="mx-auto w-full max-w-3xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Services</h2><p class="text-site-body mt-3 text-lg">Book online; we confirm by email straight away.</p><ul class="border-site-border mt-8 border-t"><li class="border-site-border flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b py-5"><div class="min-w-0 flex-1"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Cut and finish</h3><p class="text-site-body mt-1 whitespace-pre-line leading-relaxed">Wash, cut and blow-dry.</p></div><p class="text-site-fg shrink-0 text-sm tabular-nums"><span class="text-site-muted">45 min</span><span class="ml-3 font-semibold">£38.00</span></p></li></ul><div class="mt-8"><a class="inline-flex items-center justify-center rounded-[var(--site-radius)] text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 coarse:min-h-11 focus-visible:ring-site-accent focus-visible:ring-offset-site-bg bg-site-accent text-site-accent-fg px-5 py-2.5 hover:opacity-90" href="/book">Book now</a></div></section>"`;

