exports[`block rendering > faq 1`] = `
"<section class="mx-auto w-full max-w-3xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Questions we get asked</h2><div class="border-site-border mt-8 border-t"><details class="border-site-border group border-b"><summary class="text-site-fg focus-visible:ring-site-accent flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-medium focus-visible:outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><span>Do you deliver outside the city?</span><span aria-hidden="true" class="text-site-muted shrink-0 transition-transform group-open:rotate-45">+</span></summary><p class="text-site-body whitespace-pre-line pb-5 leading-relaxed">Yes, anywhere on the mainland. Orders over £150 go free; below that it is a flat £12.</p></details><details class="border-site-border group border-b"><summary class="text-site-fg focus-visible:ring-site-accent flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-medium focus-visible:outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><span>Can I collect instead?</span><span aria-hidden="true" class="text-site-muted shrink-0 transition-transform group-open:rotate-45">+</span></summary><p class="text-site-body whitespace-pre-line pb-5 leading-relaxed">From the trade counter, Monday to Saturday. We text you when it is ready.</p></details><details class="border-site-border group border-b"><summary class="text-site-fg focus-visible:ring-site-accent flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-medium focus-visible:outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><span>Do you take returns?</span><span aria-hidden="true" class="text-site-muted shrink-0 transition-transform group-open:rotate-45">+</span></summary><p class="text-site-body whitespace-pre-line pb-5 leading-relaxed">Unopened stock within 30 days, with the receipt.
Cut-to-size and custom runs can't be returned.</p></details></div></section>"
`;

exports[`block rendering > features/grid 1`] = `"<section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">Why buy from us</h2><ul class="mt-10 grid gap-[var(--site-grid-gap)] sm:grid-cols-2 lg:grid-cols-3"><li class="rounded-[var(--site-radius)]"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Stocked, not ordered in</h3><p class="text-site-body mt-2 leading-relaxed">Around nine hundred lines sit in our own warehouse, so a same-day order is a real thing rather than a promise.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Trade accounts</h3><p class="text-site-body mt-2 leading-relaxed">Order monthly and open a 30-day account. Tiered pricing applies from the second order.</p></li><li class="rounded-[var(--site-radius)]"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Cut to size</h3><p class="text-site-body mt-2 leading-relaxed">Bulk and custom runs quoted within one working day.</p></li></ul></section>"`;

exports[`block rendering > features/list 1`] = `"<section class="mx-auto w-full max-w-screen-xl px-5 py-[var(--site-section-padding)] sm:px-[var(--site-page-margin)]"><h2 class="text-site-fg text-[calc(1.875rem*var(--site-heading-scale))] font-bold tracking-tight">How ordering works</h2><p class="text-site-body mt-3 max-w-2xl text-lg">Three steps, and the second one is us.</p><ul class="mt-10 grid gap-[var(--site-grid-gap)]"><li class="border-site-border border-t pt-5"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Tell us what you need</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">By phone, or through the form on this site. A part number helps; a photograph does too.</p></li><li class="border-site-border border-t pt-5"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">We quote within a working day</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Including whether it is in stock, and what it costs to get it to you.</p></li><li class="border-site-border border-t pt-5"><h3 class="text-site-fg text-[calc(1.125rem*var(--site-heading-scale))] font-semibold">Order by 2pm, it goes the same day</h3><p class="text-site-body mt-2 max-w-2xl leading-relaxed">Anything stocked. Custom runs get their own date, agreed before you commit.</p></li></ul></section>"`;

