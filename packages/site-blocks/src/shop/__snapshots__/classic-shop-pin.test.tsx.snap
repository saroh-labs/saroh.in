// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Classic's shop is pinned > the bag's sheet 1`] = `"<div aria-hidden="true" class="fixed inset-0 z-[60] bg-[hsl(var(--site-fg)/0.45)]"></div><div role="dialog" aria-modal="true" aria-labelledby="_R_0_-title" tabindex="-1" data-clarity-mask="true" class="bg-site-surface text-site-fg font-site-body fixed inset-x-0 bottom-0 z-[61] mx-auto flex max-w-[560px] flex-col overflow-hidden rounded-t-[calc(var(--site-radius)+18px)] shadow-[0_-12px_40px_hsl(var(--site-fg)/0.2)] outline-none max-h-[88vh] supports-[height:100dvh]:max-h-[88dvh] overscroll-contain ph-no-capture"><div data-sheet-scroll="" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-[18px] pt-[18px] pb-4"><div class="flex gap-2.5 items-center"><div class="min-w-0 flex-1"><h2 id="_R_0_-title" class="font-site-heading font-semibold tracking-[-0.015em] [text-wrap:balance] text-[calc(1.3125rem*var(--site-heading-scale,1))]">Your bag</h2></div><button type="button" aria-label="Close" class="text-site-fg shrink-0 cursor-pointer rounded-full text-base hover:opacity-80 active:scale-95 coarse:size-11 size-[34px] bg-[color-mix(in_srgb,hsl(var(--site-fg))_7%,hsl(var(--site-bg)))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg">✕</button></div><p>lines</p></div><div data-sheet-footer="" class="border-site-border bg-site-surface shrink-0 border-t px-[18px] pb-[calc(16px+env(safe-area-inset-bottom))] pt-1"><p>foot</p></div></div>"`;

exports[`Classic's shop is pinned > the product page, with a photo and options 1`] = `"<link rel="preload" as="image" href="https://example.com/bread.jpg"/><article class="bg-site-bg text-site-fg"><div data-product-layout="photos" class="grid gap-x-10 gap-y-7 pb-8 lg:gap-x-14 px-5 sm:px-[var(--site-page-margin,24px)] pt-4 sm:pt-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"><div class="min-w-0"><div class="border-site-border bg-site-surface relative overflow-hidden rounded-[calc(var(--site-radius,2px)+8px)] border"><img src="https://example.com/bread.jpg" alt="A loaf" width="800" height="1000" loading="eager" decoding="async" class="aspect-[4/5] w-full object-cover"/><span class="absolute left-3 top-3"></span></div></div><div class="min-w-0"><div class="min-w-0"><p class="text-site-muted text-xs font-semibold uppercase tracking-[0.12em]">Bread</p><h1 class="font-site-heading text-site-fg mt-1.5 font-semibold tracking-[-0.025em] [overflow-wrap:anywhere] [text-wrap:balance] text-[calc(clamp(1.625rem,4.2vw,2.25rem)*var(--site-heading-scale,1))]">Country sourdough</h1><div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span data-price-lead="" class="font-site-heading text-[calc(1.75rem*var(--site-heading-scale,1))] font-semibold tabular-nums leading-none tracking-[-0.02em]">₹280</span><span data-price-mrp="" class="text-site-muted text-[15px] tabular-nums line-through"><span class="sr-only">MRP </span>₹320</span><span data-price-off="" class="text-site-fg rounded-full px-2 py-0.5 text-[12.5px] font-semibold bg-[color-mix(in_srgb,hsl(var(--site-accent))_8%,hsl(var(--site-surface)))]">12% off</span></div><p class="text-site-body mt-2 text-sm">Inclusive of all taxes</p><fieldset class="mt-6"><legend class="flex items-center gap-2 text-sm font-semibold"><span>Whole or sliced<span class="text-site-body font-normal">: Whole</span></span></legend><div class="mt-2.5 flex flex-wrap gap-2"><button type="button" aria-pressed="true" class="min-h-11 min-w-11 max-w-full cursor-pointer rounded-[calc(var(--site-radius,2px)+6px)] border px-3.5 py-1.5 text-sm font-medium transition-[color,background-color,border-color,transform] duration-100 ease-out [overflow-wrap:anywhere] active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg border-site-fg bg-site-fg text-site-bg">Whole</button><button type="button" aria-pressed="false" class="min-h-11 min-w-11 max-w-full cursor-pointer rounded-[calc(var(--site-radius,2px)+6px)] border px-3.5 py-1.5 text-sm font-medium transition-[color,background-color,border-color,transform] duration-100 ease-out [overflow-wrap:anywhere] active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg border-site-border bg-site-surface text-site-fg hover:border-site-fg">Sliced</button></div></fieldset><p class="mt-3 flex items-center gap-2 text-sm text-site-body">In stock</p><div class="mt-6"><button type="button">Add</button></div></div><div class="min-w-0"><section class="border-site-border mt-7 border-t pt-6"><h2 class="font-site-heading flex items-center gap-2 text-[calc(1.0625rem*var(--site-heading-scale,1))] font-semibold tracking-[-0.01em]">About this product</h2><div class="prose prose-sm prose-headings:text-site-fg prose-p:text-site-body prose-strong:text-site-fg prose-li:text-site-body prose-a:text-site-accent mt-2.5 max-w-[65ch] text-[15px] leading-relaxed">Slow, three-day loaf.</div><ul class="text-site-body mt-3 max-w-[65ch] list-disc space-y-1.5 pl-5 text-[15px] leading-relaxed"><li>Wild yeast</li></ul></section></div></div></div></article>"`;

exports[`Classic's shop is pinned > the product page, with no photo 1`] = `"<article class="bg-site-bg text-site-fg"><div data-product-layout="words" class="grid gap-x-10 gap-y-7 pb-8 lg:gap-x-14 px-5 sm:px-[var(--site-page-margin,24px)] pt-4 sm:pt-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"><span aria-hidden="true" class="bg-site-accent -mb-2 block h-0.5 w-10 md:col-span-full"></span><div class="min-w-0"><p class="text-site-muted text-xs font-semibold uppercase tracking-[0.12em]">Bread</p><h1 class="font-site-heading text-site-fg mt-1.5 font-semibold tracking-[-0.025em] [overflow-wrap:anywhere] [text-wrap:balance] text-[calc(clamp(1.875rem,5.4vw,2.875rem)*var(--site-heading-scale,1))]">Country sourdough</h1><div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span data-price-lead="" class="font-site-heading text-[calc(1.75rem*var(--site-heading-scale,1))] font-semibold tabular-nums leading-none tracking-[-0.02em]">₹280</span><span data-price-mrp="" class="text-site-muted text-[15px] tabular-nums line-through"><span class="sr-only">MRP </span>₹320</span><span data-price-off="" class="text-site-fg rounded-full px-2 py-0.5 text-[12.5px] font-semibold bg-[color-mix(in_srgb,hsl(var(--site-accent))_8%,hsl(var(--site-surface)))]">12% off</span></div><p class="text-site-body mt-2 text-sm">Inclusive of all taxes</p><fieldset class="mt-6"><legend class="flex items-center gap-2 text-sm font-semibold"><span>Whole or sliced<span class="text-site-body font-normal">: Whole</span></span></legend><div class="mt-2.5 flex flex-wrap gap-2"><button type="button" aria-pressed="true" class="min-h-11 min-w-11 max-w-full cursor-pointer rounded-[calc(var(--site-radius,2px)+6px)] border px-3.5 py-1.5 text-sm font-medium transition-[color,background-color,border-color,transform] duration-100 ease-out [overflow-wrap:anywhere] active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg border-site-fg bg-site-fg text-site-bg">Whole</button><button type="button" aria-pressed="false" class="min-h-11 min-w-11 max-w-full cursor-pointer rounded-[calc(var(--site-radius,2px)+6px)] border px-3.5 py-1.5 text-sm font-medium transition-[color,background-color,border-color,transform] duration-100 ease-out [overflow-wrap:anywhere] active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-site-fg focus-visible:ring-offset-2 focus-visible:ring-offset-site-bg border-site-border bg-site-surface text-site-fg hover:border-site-fg">Sliced</button></div></fieldset><p class="mt-3 flex items-center gap-2 text-sm text-site-body">In stock</p></div><div class="min-w-0 max-md:border-site-border max-md:border-t max-md:pt-6"><section class=""><h2 class="font-site-heading flex items-center gap-2 text-[calc(1.0625rem*var(--site-heading-scale,1))] font-semibold tracking-[-0.01em]">About this product</h2><div class="prose prose-sm prose-headings:text-site-fg prose-p:text-site-body prose-strong:text-site-fg prose-li:text-site-body prose-a:text-site-accent mt-2.5 max-w-[65ch] text-[15px] leading-relaxed">Slow, three-day loaf.</div><ul class="text-site-body mt-3 max-w-[65ch] list-disc space-y-1.5 pl-5 text-[15px] leading-relaxed"><li>Wild yeast</li></ul></section></div></div></article>"`;
