{
    "name": "@saroh/error-tracking",
    "version": "1.0.0",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs",
            "require": "./dist/server.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.mjs",
            "require": "./dist/browser.js"
        }
    },
    "typesVersions": {
        "*": {
            "server": [
                "./dist/server.d.ts"
            ],
            "browser": [
                "./dist/browser.d.ts"
            ]
        }
    },
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rimraf .turbo node_modules dist",
        "dev": "tsup --watch",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@saroh/eslint-config": "workspace:*",
        "@saroh/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "posthog-js": "1.435.9",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.0",
        "typescript": "catalog:",
        "vitest": "^4.1.11"
    }
}
