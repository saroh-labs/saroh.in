{
    "name": "@saroh/pricing-catalog",
    "version": "1.0.0",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./seed": {
            "types": "./dist/seed.internal.d.ts",
            "import": "./dist/seed.internal.mjs",
            "require": "./dist/seed.internal.js"
        }
    },
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rimraf .turbo node_modules dist",
        "dev": "tsup --watch",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@saroh/eslint-config": "workspace:*",
        "@saroh/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.0",
        "typescript": "catalog:",
        "vitest": "^4.1.11"
    }
}
