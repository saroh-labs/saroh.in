        "next": "^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@saroh/eslint-config": "workspace:*",
        "@saroh/tsconfig": "workspace:*",
        "@testing-library/react": "^16.1.0",
        "@types/node": "catalog:",
        "@types/react": "19.2.15",
        "@types/react-dom": "catalog:react19",
        "eslint": "catalog:",
        "jsdom": "^25.0.1",
        "next": "^16.4.2",
        "react": "catalog:react19",
        "react-dom": "catalog:react19",
        "typescript": "catalog:",
