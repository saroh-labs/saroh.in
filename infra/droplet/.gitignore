# Real, secret-bearing files. The root .gitignore already covers `.env` and
# `.env.*` (so `.env.prod` is caught), but being explicit here keeps the rule
# next to the templates it protects.
.env
.env.prod

# Stack-scoped registry credentials written by
#   DOCKER_CONFIG=./.docker docker login ghcr.io
# Docker stores the PAT base64-encoded, NOT encrypted.
.docker/

deploy.log
