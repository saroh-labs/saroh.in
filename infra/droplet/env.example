# Copy to `.env` in the deploy directory on the host. chmod 600.
#
# This file exists for ONE reason: docker compose interpolates ${...} in
# docker-compose.yml from `.env` and the invoking shell only — never from the
# `env_file:` it passes to the container. DATABASE_URL is assembled in the
# compose file, so the password has to be readable at interpolation time.
#
# The same value must also appear in `.env.prod`, and must match the password
# the infrastructure stack configured for this role. A mismatch surfaces as
# `password authentication failed` on API boot, not as a config error at deploy
# time.

# Must equal the SAROH_DB_PASSWORD the infrastructure stack uses — that is the
# value baked into the saroh_app role when the postgres volume was first
# initialised. Changing it here does NOT rotate it; to rotate, run
#   ALTER ROLE saroh_app WITH PASSWORD '<new>';
# and update every file holding it in the same maintenance window.
SAROH_DB_PASSWORD=

# Overridden by deploy.sh with the tag it is rolling out. Set by hand only to
# pin a rollback.
SAROH_API_IMAGE=ghcr.io/saroh-labs/saroh-api:latest
