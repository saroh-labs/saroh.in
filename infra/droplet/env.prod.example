# Copy to `.env.prod` in the deploy directory on the host. chmod 600.
#
# Every application secret for api.saroh.in. Delivered to the container via
# `env_file:` in docker-compose.yml. Validated at import time by
# apps/api.saroh.in/src/env.ts — a missing required value stops the process at
# boot with a list of what is wrong.
#
# NOTE: DATABASE_URL, REDIS_URL, PORT, NODE_ENV and NODE_OPTIONS are NOT here.
# docker-compose.yml sets them, and `environment:` wins over `env_file:`, so a
# copy here would be silently ignored and would drift.

# ── Database password (duplicate of the sibling .env) ───────────────────────
# Nothing reads it from this file today — compose assembles DATABASE_URL from
# the sibling `.env`. It is kept here so this file remains a complete list of the
# application's secrets.
SAROH_DB_PASSWORD=

# ── Auth (REQUIRED) ─────────────────────────────────────────────────────────
# Must be byte-identical to the value set for accounts.saroh.in, app.saroh.in,
# admin.saroh.in and saroh.app on Vercel. If it differs by so much as trailing
# whitespace, sessions issued here fail validation there with no useful error.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# This api's own public origin — the one the browser talks to.
BETTER_AUTH_URL=https://api.saroh.in

# Where the api sends people in links it emails (invitation accept, password
# reset). The frontend's origin, not its own.
APP_URL=https://app.saroh.in

# Comma-separated, exact origins. Never "*" — the api serves credentialed CORS
# and the two are mutually exclusive. Omitting this falls back to the trusted
# *.saroh.in list in @saroh/auth PLUS thirteen localhost ports, which is not
# what you want in production, so set it explicitly.
CORS_ORIGIN=https://app.saroh.in,https://accounts.saroh.in,https://admin.saroh.in,https://saroh.in

# ── OAuth (optional — email/password works without these) ───────────────────
# Callbacks register at https://api.saroh.in/api/auth/callback/{github,google}
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# With SMTP unset, verification and reset links are LOGGED TO THE CONSOLE and
# never sent. That is a reasonable dev default and an outage in production.
EMAIL_FROM="Saroh <noreply@saroh.in>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── Object storage (Cloudflare R2) ──────────────────────────────────────────
# Leave unset and media uploads fall back to an in-memory adapter that accepts
# bytes and persists nothing. Fine locally; silent data loss in production.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ── Payments ────────────────────────────────────────────────────────────────
# AES-256-GCM key for merchant credentials at rest: 32 bytes as base64 or
# 64 hex chars. Validated at first use, not at boot. Losing or rotating this
# makes every stored merchant credential undecryptable — back it up separately
# from the droplet. Generate with: openssl rand -base64 32
PAYMENTS_ENC_KEY=

# ── Platform staff break-glass ──────────────────────────────────────────────
# Comma-separated emails treated as platform admins with no PlatformAdmin row.
# This is how the FIRST admin is seeded and how access is recovered if every
# grant is revoked. Normally one address, or empty. Empty still fails closed.
ADMIN_ALLOWLIST=

# ── Row-level security ──────────────────────────────────────────────────────
# Leave UNSET. saroh_app OWNS the saroh database, so it bypasses FORCE ROW
# LEVEL SECURITY regardless of this flag. Enabling enforcement needs a separate
# NOBYPASSRLS role AND an audit that every org-scoped query runs inside
# withOrgContext — see docs/architecture/RLS_ROLLOUT_AND_OPS.md.
# RLS_ENFORCEMENT=

# ── Background job worker (optional; defaults are sane) ─────────────────────
# JOB_WORKER_POLL_MS=2000
# JOB_WORKER_BATCH=10
# JOB_VISIBILITY_MS=300000
