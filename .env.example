# Saroh.io environment template — copy to `.env` and fill in real values.
# NEVER commit a real .env. All .env files are gitignored.
#
# Every app validates its own slice of these at startup via a typed `env`
# module (@t3-oss/env-*, see apps/<app>/env.ts). A missing/invalid required
# variable throws a clear error instead of failing mysteriously later. To skip
# validation for a throwaway build (e.g. Docker image with no runtime secrets),
# set SKIP_ENV_VALIDATION=1.
# SKIP_ENV_VALIDATION=

# ── Database (PostgreSQL on Neon) ───────────────────────────────────────────
# Prisma 7 reads this via prisma.config.js (CLI) and the @prisma/adapter-pg
# runtime client. Use the Neon pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Better Auth (auth server lives in api.saroh.in; accounts is the UI) ─────
# Canonical Better Auth names only — use BETTER_AUTH_SECRET / BETTER_AUTH_URL.
# No other auth secret/url variables are read by the codebase.
#
# BETTER_AUTH_SECRET must be BYTE-IDENTICAL across api.saroh.in and every app
# that validates sessions, or session checks silently fail. api hosts Better
# Auth + the DB; the frontends talk to it over HTTP. BETTER_AUTH_URL is api's
# origin.
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="https://api.saroh.localhost"       # api origin; https://api.saroh.in in prod
# Optional: override the trusted-origin allowlist (comma-separated). Defaults
# to the *.saroh.in app set in @saroh/auth.
# BETTER_AUTH_TRUSTED_ORIGINS="https://accounts.saroh.localhost,https://admin.saroh.localhost"

# ── OAuth providers (names must match @saroh/auth config) ───────────────────
# Register callbacks at {BETTER_AUTH_URL}/api/auth/callback/{github,google}.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Nodemailer + @saroh/emails React Email templates) ────────────────
EMAIL_FROM="Saroh <noreply@saroh.in>"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE="true"
# Legacy aliases still honored as fallbacks by api's email transport:
# SENDER_EMAIL_ID=""     # falls back to EMAIL_FROM
# SMTP_HOSTNAME=""       # falls back to SMTP_HOST
# USER_ACCOUNT=""        # falls back to SMTP_USER
# USER_PASSWORD=""       # falls back to SMTP_PASS

# ── Object storage (AWS S3 / DigitalOcean Spaces) ───────────────────────────
SPACES_ENDPOINT=""
SPACES_REGION=""
SPACES_KEY=""
SPACES_SECRET=""
SPACES_NAME=""
SPACES_FOLDER=""
SPACES_IMAGES_CDN_BASE_URL=""

# ── api.saroh.in (NestJS) ───────────────────────────────────────────────────
PORT="3333"
CORS_ORIGIN="https://accounts.saroh.localhost"
# Base URL used when building store-invitation accept links in emails.
APP_URL="https://app.saroh.localhost"
# Integration-test database (used only by api's test harness; see
# .env.test.example). Never point this at a real/production database.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saroh_test?sslmode=no-verify"

# ── admin.saroh.in ──────────────────────────────────────────────────────────
# API-only break-glass bootstrap for the first/recovery platform owner.
# Normal staff access uses PlatformAdminRoleAssignment records. Empty = no
# bootstrap access. Never commit real staff addresses.
ADMIN_ALLOWLIST=""

# ── saroh.app / app.saroh.in (multi-tenant + dev tunnels) ───────────────────
# Set "true" to 302 a tenant to its verified custom domain (saroh.app).
REDIRECT_TO_CUSTOM_DOMAIN_IF_EXISTS=""
# Public ngrok/tunnel origin used as the app origin during local webhook dev.
NGROK_URL=""

# ── Public (client-exposed) ─────────────────────────────────────────────────
NEXT_PUBLIC_ACCOUNTS_URL="https://accounts.saroh.localhost"  # https://accounts.saroh.in in prod
NEXT_PUBLIC_API_URL="https://api.saroh.localhost"
# Where the browser Better Auth client + server session read point (api origin).
NEXT_PUBLIC_BETTER_AUTH_URL="https://api.saroh.localhost"
# The host merchant subdomains hang off: <subdomain>.saroh.app. NOT saroh.in —
# that is the marketing site, a different app on a different deployment.
NEXT_PUBLIC_ROOT_DOMAIN="saroh.app.localhost"          # saroh.app in prod
# Where a merchant's own domain should CNAME once verified (#200). Shown as
# the routing record on the site settings screen.
NEXT_PUBLIC_CUSTOM_DOMAIN_TARGET="saroh.app"
NEXT_PUBLIC_APP_DOMAIN="app.saroh.in"
# Marketing site (saroh.in) hero CTA → app register URL.
NEXT_PUBLIC_AUTH_APP_URL="https://app.saroh.localhost"
# Provided automatically by Vercel; only set locally if you need to emulate it.
# NEXT_PUBLIC_VERCEL_ENV="development"   # development | preview | production
# NEXT_PUBLIC_VERCEL_URL=""
